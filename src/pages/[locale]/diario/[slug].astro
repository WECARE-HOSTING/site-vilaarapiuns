---
/**
 * UM POST DO DIÁRIO.
 *
 * Rota própria, fora do `[...path].astro`, porque post não tem PageKey — o
 * caminho dele vem do arquivo de conteúdo. Ver `src/content.config.ts`.
 *
 * A ORDEM DA PÁGINA É A ORDEM DA UTILIDADE, e não a de um blog:
 *   h1 · resposta direta · foto · texto · dúvidas · para onde ir · outras leituras
 *
 * A resposta direta vem ANTES da foto de propósito. Quem chega aqui por busca
 * fez uma pergunta e quer a resposta; uma imagem grande entre a pergunta e a
 * resposta é o padrão de blog de viagem e é exatamente o que faz a pessoa
 * voltar para o Google. É também o bloco que um modelo de linguagem extrai
 * quando cita a página, e é por isso que ele tem de fazer sentido sozinho.
 */
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import ListaCorte from '@/components/ListaCorte.astro';
import Voluta from '@/components/Voluta.astro';
import { useTranslations } from '@/i18n/utils';
import { SITE, whatsappUrl } from '@/data/site';
import { href, type PageKey } from '@/i18n/routes';
import type { Locale } from '@/i18n/config';
import { caminhoDoPost, caminhoDoIndice, alternativasDoGrupo, proximasLeituras, dataLegivel, posts } from '@/lib/diario';

export async function getStaticPaths() {
  const todos = await posts();
  return todos.map((post) => ({
    params: { locale: post.data.locale, slug: post.data.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const d = post.data;
const locale = d.locale as Locale;
const t = useTranslations(locale);
const { Content } = await render(post);

const alternativas = await alternativasDoGrupo(d.grupo);
const seguintes = await proximasLeituras(post);
const caminho = caminhoDoPost(locale, d.slug);

const imagens = import.meta.glob<{ default: ImageMetadata }>('/src/assets/imgs/*.{jpg,jpeg,png}', { eager: true });
const achar = (nome: string) =>
  Object.entries(imagens).find(([p]) => p.split('/').pop()?.replace(/\.[^.]+$/, '') === nome)?.[1].default;
const foto = achar(d.imagem);
const capa = foto ? new URL(foto.src, SITE.domain).toString() : undefined;

const destino = d.destino as PageKey;

/** Article + FAQPage. Uma fonte só: os mesmos textos que estão na tela. */
const schema: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: d.titulo,
    description: d.descricao,
    inLanguage: locale === 'pt' ? 'pt-BR' : locale,
    datePublished: d.data.toISOString().slice(0, 10),
    dateModified: (d.revisado ?? d.data).toISOString().slice(0, 10),
    mainEntityOfPage: { '@type': 'WebPage', '@id': new URL(caminho, SITE.domain).toString() },
    ...(capa ? { image: capa } : {}),
    author: { '@type': 'Organization', name: SITE.name, url: SITE.domain },
    publisher: { '@type': 'Organization', name: SITE.name, url: SITE.domain },
  },
];
if (d.duvidas.length) {
  schema.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: d.duvidas.map((x) => ({
      '@type': 'Question',
      name: x.q,
      acceptedAnswer: { '@type': 'Answer', text: x.a },
    })),
  });
}
---

<BaseLayout
  locale={locale}
  pageKey="home"
  title={`${d.tituloCurto ?? d.titulo} · ${SITE.name}`}
  description={d.descricao}
  image={capa}
  caminho={caminho}
  alternativas={alternativas}
  semSchemaNegocio
>
  <Header slot="header" locale={locale} pageKey={'home' as PageKey} />

  <Fragment slot="head">
    {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} is:inline />)}
  </Fragment>

  <article class="pt-header">
    <header class="pb-8 pt-12 md:pt-16">
      <div class="container-editorial">
        <p class="etiqueta numero">
          <a href={caminhoDoIndice(locale)} class="link-texto">{t('diario.titulo')}</a>
        </p>
        <h1 class="font-display text-titulo mt-4 max-w-[46rem]">{d.titulo}</h1>

        <!-- A resposta direta. Antes da foto, de propósito. -->
        {/* `emenda` e não `border-areia-regua`: esse token nunca existiu — as
            areias do tema são clara, areia, sol e funda —, então a classe não
            gerava regra nenhuma e o filete saía na cor do texto. `emenda` lê
            `--cor-emenda` do contexto, que é o que a casa manda usar. */}
        <div class="emenda mt-8 border-l-2 pl-5 md:pl-6">
          <p class="lead max-w-[62ch]">{d.resposta}</p>
        </div>

        <p class="meta numero mt-6 flex flex-wrap items-center gap-x-3 gap-y-1">
          <time datetime={d.data.toISOString().slice(0, 10)}>{dataLegivel(locale, d.data)}</time>
          {d.revisado && (
            <>
              <Voluta />
              <span>{t('diario.revisado')} {dataLegivel(locale, d.revisado)}</span>
            </>
          )}
        </p>
      </div>
    </header>

    {foto && (
      <figure class="container-editorial">
        <Image
          src={foto}
          alt={d.imagemAlt}
          widths={[600, 900, 1288]}
          sizes="(min-width: 1280px) 76rem, 100vw"
          loading="eager"
          fetchpriority="high"
          class="aspect-[16/9] w-full object-cover"
        />
        <figcaption class="meta numero mt-3">{d.legenda}</figcaption>
      </figure>
    )}

    <div class="secao">
      <div class="container-editorial">
        <div class="prosa container-texto sm:mx-0">
          <Content />
        </div>
      </div>
    </div>

    {d.duvidas.length > 0 && (
      <section class="cunha-topo secao bg-areia">
        <div class="container-editorial">
          <h2 class="font-display text-titulo">{t('diario.duvidas')}</h2>
          <ListaCorte itens={d.duvidas.map((x) => ({ titulo: x.q, detalhe: x.a }))} class="mt-10" />
        </div>
      </section>
    )}

    <section class="secao">
      <div class="container-editorial">
        <h2 class="font-display text-titulo">{t('diario.ctaT')}</h2>
        <p class="lead container-texto mt-4 sm:mx-0">{t('diario.ctaD')}</p>
        <p class="mt-8 flex flex-wrap gap-4">
          <a href={whatsappUrl(t('whatsapp.geral'))} class="btn btn-primario" target="_blank" rel="noopener noreferrer">
            {t('cta.whatsapp')}
          </a>
          <a href={href(locale, destino)} class="btn btn-secundario">{t(`nav.${destino}`)}</a>
        </p>
      </div>
    </section>

    {seguintes.length > 0 && (
      <section class="secao bg-areia">
        <div class="container-editorial">
          <h2 class="font-display text-titulo">{t('diario.seguintes')}</h2>
          <ol class="emenda mt-10 border-t">
            {seguintes.map((p) => (
              <li class="emenda grid gap-x-6 border-b py-5 sm:grid-cols-[1fr_auto]">
                <div>
                  <h3 class="font-display text-secao">
                    <a href={caminhoDoPost(p.data.locale as Locale, p.data.slug)} class="link-texto">{p.data.titulo}</a>
                  </h3>
                  <p class="mt-1.5">{p.data.descricao}</p>
                </div>
                <p class="numero etiqueta mt-2 sm:mt-1 sm:text-right">{dataLegivel(locale, p.data.data)}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )}
  </article>

  <Footer slot="footer" locale={locale} />
</BaseLayout>
