---
/**
 * O ÍNDICE DO DIÁRIO.
 *
 * Gerado só nos idiomas que TÊM post — ver `idiomasComDiario()`. Um índice
 * vazio em espanhol seria uma página que promete conteúdo e entrega nada, e
 * ainda entraria no sitemap dizendo ao Google que existe.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import AberturaPagina from '@/components/AberturaPagina.astro';
import { useTranslations } from '@/i18n/utils';
import { SITE } from '@/data/site';
import type { PageKey } from '@/i18n/routes';
import type { Locale } from '@/i18n/config';
import { posts, idiomasComDiario, caminhoDoPost, caminhoDoIndice, dataLegivel } from '@/lib/diario';

export async function getStaticPaths() {
  const idiomas = await idiomasComDiario();
  return idiomas.map((locale) => ({ params: { locale }, props: { locale } }));
}

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);
const lista = await posts(locale);

const imagens = import.meta.glob<{ default: ImageMetadata }>('/src/assets/imgs/*.{jpg,jpeg,png}', { eager: true });
const achar = (nome: string) =>
  Object.entries(imagens).find(([p]) => p.split('/').pop()?.replace(/\.[^.]+$/, '') === nome)?.[1].default;

/** hreflang só para os idiomas que têm índice de verdade. */
const idiomas = await idiomasComDiario();
const alternativas = idiomas.map((l) => ({ locale: l, caminho: caminhoDoIndice(l) }));
---

<BaseLayout
  locale={locale}
  pageKey="home"
  title={`${t('diario.titulo')} · ${SITE.name}`}
  description={t('diario.descricao')}
  caminho={caminhoDoIndice(locale)}
  alternativas={alternativas}
  semSchemaNegocio
>
  <Header slot="header" locale={locale} pageKey={'home' as PageKey} />

  <div class="pt-header">
    <AberturaPagina titulo={t('diario.h1')} intro={t('diario.intro')} />

    <section class="pb-20">
      <div class="container-editorial">
        <ol class="emenda border-t">
          {lista.map((p) => {
            const foto = achar(p.data.imagem);
            return (
              <li class="emenda grid gap-x-8 gap-y-4 border-b py-8 sm:grid-cols-[1fr_14rem] md:gap-x-12 md:py-10">
                <div>
                  <p class="numero etiqueta">
                    <time datetime={p.data.data.toISOString().slice(0, 10)}>{dataLegivel(locale, p.data.data)}</time>
                  </p>
                  <h2 class="font-display text-secao mt-2">
                    <a href={caminhoDoPost(p.data.locale as Locale, p.data.slug)} class="link-texto">{p.data.titulo}</a>
                  </h2>
                  <p class="mt-3 max-w-[60ch]">{p.data.descricao}</p>
                </div>
                {foto && (
                  /* `row-start-1` junto com `col-start-2`, e NÃO `order-first`:
                     a ordem só reordena dentro do fluxo automático e deixava a
                     imagem abrindo uma linha nova — o texto caía abaixo dela e
                     sobrava um vão do tamanho da foto. Posição explícita põe as
                     duas colunas na MESMA linha. */
                  <a href={caminhoDoPost(p.data.locale as Locale, p.data.slug)} class="block sm:col-start-2 sm:row-start-1">
                    <Image
                      src={foto}
                      alt={p.data.imagemAlt}
                      widths={[280, 448]}
                      sizes="14rem"
                      loading="lazy"
                      decoding="async"
                      class="aspect-[4/3] w-full object-cover"
                    />
                  </a>
                )}
              </li>
            );
          })}
        </ol>
      </div>
    </section>
  </div>

  <Footer slot="footer" locale={locale} />
</BaseLayout>
