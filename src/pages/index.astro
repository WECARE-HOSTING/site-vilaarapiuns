---
// Raiz do site: manda o visitante para o idioma dele.
// Renderiza sem JS também — se o script não rodar, ficam os links visíveis.
import { LOCALES, LOCALE_NAMES, DEFAULT_LOCALE, HTML_LANG } from '@/i18n/config';
import { SITE } from '@/data/site';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{SITE.name} — Amazon Lodge on the Arapiuns River</title>
    <meta name="description" content="An Amazon lodge on the Arapiuns River. Full board, boat transfer and local guides included." />
    <link rel="canonical" href={`${SITE.domain}/${DEFAULT_LOCALE}/`} />
    {LOCALES.map((l) => <link rel="alternate" hreflang={HTML_LANG[l]} href={`${SITE.domain}/${l}/`} />)}
    <link rel="alternate" hreflang="x-default" href={`${SITE.domain}/${DEFAULT_LOCALE}/`} />
    <meta http-equiv="refresh" content={`0; url=/${DEFAULT_LOCALE}/`} />
    <script is:inline define:vars={{ locales: LOCALES, fallback: DEFAULT_LOCALE }}>
      (function () {
        var preferred = (navigator.languages || [navigator.language || fallback])
          .map(function (l) { return String(l).slice(0, 2).toLowerCase(); })
          .find(function (l) { return locales.indexOf(l) !== -1; });
        window.location.replace('/' + (preferred || fallback) + '/');
      })();
    </script>
    <style>
      /* Esta página não importa o global.css (é um redirect de 0s), então os
         valores vêm cravados. CORRIGIDO EM 22/08/2026 (Fase 4): os hexes
         antigos aqui (#1d2418/#b4b69f/#c2ab80) eram da paleta verde-mata que
         saiu em 21/08 — o comentário anterior dizia que já eram "os tokens
         reais do @theme", o que era falso. Os valores abaixo são a paleta
         areia-e-mar em uso: areia-clara (chão), mar-fundo (texto), céu (link) —
         ver src/styles/global.css para as razões de contraste medidas. */
      body { font-family: system-ui, sans-serif; background: #fdf8ee; color: #0d3244;
             display: grid; place-items: center; min-height: 100dvh; margin: 0;
             padding: 2rem; text-align: center; }
      h1 { font-weight: 400; font-size: 1.25rem; margin: 0 0 1.5rem; }
      ul { list-style: none; padding: 0; margin: 0; display: flex; gap: 1.5rem; flex-wrap: wrap; justify-content: center; }
      a { color: #1b6aad; padding: 0.25rem 0; display: inline-block; }
    </style>
  </head>
  <body>
    <h1>{SITE.name}</h1>
    <nav aria-label="Choose a language">
      <ul>
        {LOCALES.map((l) => <li><a href={`/${l}/`} hreflang={HTML_LANG[l]}>{LOCALE_NAMES[l]}</a></li>)}
      </ul>
    </nav>
  </body>
</html>
