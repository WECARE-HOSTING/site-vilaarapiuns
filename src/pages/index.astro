---
/**
 * Obrigatório com prefixDefaultLocale. A raiz não é página: x-default é en,
 * então `/` 301 para `/en/`. O HTML antigo (200 + meta refresh + canonical
 * `/en/` + detecção de idioma no JS) é o que o Search Console via como
 * declared-canonical mismatch.
 *
 * Astro SSG não emite o status HTTP: o build deixa um HTML de fallback e
 * o nginx serve o arquivo. `astro dev` usa o 301 de astro.config.mjs.
 * O 302 que o ar devolve em `GET /` é regra do nginx, não este arquivo.
 * O snippet 301 (nginx-root-redirect.conf) só entra depois do include e
 * do reload em docs/redirect-raiz.md.
 */
import { DEFAULT_LOCALE } from '@/i18n/config';

return Astro.redirect(`/${DEFAULT_LOCALE}/`, 301);
---
