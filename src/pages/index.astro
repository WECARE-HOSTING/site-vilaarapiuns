---
// Raiz do site: manda o visitante para o idioma dele.
// Renderiza sem JS também — se o script não rodar, ficam os links visíveis.
import { LOCALES, LOCALE_NAMES, DEFAULT_LOCALE, HTML_LANG } from '@/i18n/config';
import { SITE } from '@/data/site';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{SITE.name} — Amazon Lodge on the Arapiuns River</title>
    <meta name="description" content="An Amazon lodge on the Arapiuns River. Full board, boat transfer and local guides included." />
    <link rel="canonical" href={`${SITE.domain}/${DEFAULT_LOCALE}/`} />
    {LOCALES.map((l) => <link rel="alternate" hreflang={HTML_LANG[l]} href={`${SITE.domain}/${l}/`} />)}
    <link rel="alternate" hreflang="x-default" href={`${SITE.domain}/${DEFAULT_LOCALE}/`} />
    <meta http-equiv="refresh" content={`0; url=/${DEFAULT_LOCALE}/`} />
    <script is:inline define:vars={{ locales: LOCALES, fallback: DEFAULT_LOCALE }}>
      (function () {
        var preferred = (navigator.languages || [navigator.language || fallback])
          .map(function (l) { return String(l).slice(0, 2).toLowerCase(); })
          .find(function (l) { return locales.indexOf(l) !== -1; });
        window.location.replace('/' + (preferred || fallback) + '/');
      })();
    </script>
    <style>
      body { font-family: system-ui, sans-serif; background: #f7f1e8; color: #1a1a18;
             display: grid; place-items: center; min-height: 100vh; margin: 0; }
      ul { list-style: none; padding: 0; display: flex; gap: 1.5rem; flex-wrap: wrap; justify-content: center; }
      a { color: #2d4a2f; }
    </style>
  </head>
  <body>
    <nav aria-label="Escolha de idioma">
      <ul>
        {LOCALES.map((l) => <li><a href={`/${l}/`} hreflang={HTML_LANG[l]}>{LOCALE_NAMES[l]}</a></li>)}
      </ul>
    </nav>
  </body>
</html>
