---
/**
 * Página interna de aprovação do design (Fase 1).
 * Mostra a linguagem visual aplicada de verdade — hero, seções e a
 * linha do dia — e só no fim a referência das peças.
 * Fora do menu e do sitemap; some antes de publicar.
 */
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import FaixaGarantias from '@/components/FaixaGarantias.astro';
import LinhaDoDia from '@/components/LinhaDoDia.astro';
import Campo from '@/components/Campo.astro';
import Tinta from '@/components/Tinta.astro';
import Voluta from '@/components/Voluta.astro';
import Logo from '@/components/Logo.astro';
import { useTranslations } from '@/i18n/utils';
import { Image } from 'astro:assets';
import hero3 from '@/assets/imgs/hero3.jpg';
import hero5 from '@/assets/imgs/hero5.jpg';
import gal3 from '@/assets/imgs/gal3.jpg';

const locale = 'pt' as const;
const t = useTranslations(locale);

const momentos = [
  { hora: '07:00', titulo: 'Café na varanda', detalhe: 'Tapioca, frutas do quintal, café passado na hora.', refeicao: true },
  { hora: '08:30', titulo: 'Trilha até o Lago Azul', detalhe: 'Com o guia da casa. Canoa na lagoa escondida.' },
  { hora: '12:30', titulo: 'Almoço na comunidade', detalhe: 'Peixe fresco, feito pela família que recebe o grupo.', tipo: 'comunidade' as const, refeicao: true },
  { hora: '14:00', titulo: 'Farinhada e tecelagem', detalhe: 'Oficina com as artesãs da comunidade.', tipo: 'comunidade' as const },
  { hora: '17:30', titulo: 'Pôr do sol na Ponta Grande' },
  { hora: '19:30', titulo: 'Jantar e fogueira na praia', refeicao: true },
];
const rotulos = { incluso: t('dia.incluso'), comunidade: t('dia.comunidade') };

const cores = [
  { nome: 'areia',   hex: '#f7f1e8', uso: 'Fundo. A areia da praia.' },
  { nome: 'mata',    hex: '#22402b', uso: 'Títulos e seções escuras.' },
  { nome: 'rede',    hex: '#2f6b72', uso: 'Acento. A rede da varanda.' },
  { nome: 'brasa',   hex: '#a85c2c', uso: 'Só o botão de reserva. A fogueira.' },
];
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Design system · Villa Arapiuns</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@300..600&family=Archivo+Narrow:wght@400..700&family=Fraunces:opsz,wght@9..144,300..600&display=swap" />
  </head>

  <body>
    <Header locale={locale} pageKey="home" sobreFoto />

    <main>
      <!-- ══════════ HERO ══════════ -->
      <section class="relative min-h-[88svh] w-full overflow-hidden bg-mata-fundo">
        <Image
          src={hero3}
          alt="Três pessoas caminhando numa trilha de areia na floresta, o guia da Villa à frente"
          widths={[800, 1280, 1920, 2400]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          class="absolute inset-0 h-full w-full object-cover object-[72%_center]"
        />
        <!-- escurecimento só onde o texto pousa, para a foto não morrer -->
        {/* No celular a tela é estreita: só o véu vertical, senão a foto some.
            A partir de md entra o lateral, que abre a faixa escura do texto. */}
        <div class="absolute inset-0 bg-gradient-to-t from-mata-fundo/95 via-mata-fundo/50 to-mata-fundo/20"></div>
        <div class="absolute inset-0 hidden bg-gradient-to-r from-mata-fundo via-mata-fundo/75 to-transparent to-65% md:block lg:to-58%"></div>

        <div class="container-editorial relative flex min-h-[88svh] flex-col justify-end pb-14 pt-32 md:pb-20">
          <div class="max-w-[34rem] lg:max-w-[38rem]">
            <Campo tone="claro" class="!text-areia/75">
              <span>02°26′S&nbsp;&nbsp;55°16′W</span>
              <Voluta class="text-areia/50" />
              <span>1h30 de barco de Alter do Chão</span>
              <Voluta class="text-areia/50" />
              <span>13 cabanas</span>
            </Campo>

            <h1 class="font-display text-display mt-6 text-areia">
              Uma pousada na Amazônia.
              <span class="block text-areia/65">Não um passeio.</span>
            </h1>

            <p class="text-intro mt-7 max-w-md text-areia/85">
              Treze cabanas às margens do Rio Arapiuns. Você chega, deixa as malas
              e sai — o barco, a cozinha e o caminho são da casa.
            </p>

            <div class="mt-9 grid grid-cols-2 gap-3 sm:flex sm:flex-wrap sm:items-center sm:gap-4">
              <a href="#" class="btn btn-primario px-4 sm:px-8">Consultar datas</a>
              <a href="#" class="btn btn-claro px-4 sm:px-8">Ver os pacotes</a>
            </div>
          </div>
        </div>

        <!-- Nota de campo: encosta na borda da foto, como anotação a lápis -->
        <aside class="pointer-events-none absolute bottom-0 right-0 hidden max-w-xs bg-areia px-7 py-6 lg:block">
          <Voluta class="mb-3 text-rede" />
          <p class="text-sm leading-snug text-tinta">
            À frente, o guia da Villa. Ninguém sai sozinho — e ninguém carrega mochila
            atrás de reserva de barco.
          </p>
          <Tinta class="mt-4" tone="rede" />
        </aside>
      </section>

      <FaixaGarantias locale={locale} />

      <!-- ══════════ A POUSADA ══════════ -->
      <section class="secao overflow-hidden">
        <div class="container-editorial">
          <div class="grid items-center gap-y-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] lg:gap-x-20">
            <div class="lg:pr-4">
              <Campo>13 cabanas <Voluta class="text-rede/50" /> 26 hóspedes <Voluta class="text-rede/50" /> 5+ anos</Campo>

              <h2 class="font-display text-titulo mt-5">
                Onde a floresta começa<br />e o tempo para de correr
              </h2>

              <Tinta class="my-8 max-w-[14rem]" />

              <p class="text-intro text-tinta/85">
                A Villa Arapiuns é uma pousada de base comunitária às margens do rio,
                no Pará. Não é um acampamento e não é um hotel: são treze cabanas de
                madeira e palha, uma cozinha que funciona o dia inteiro e uma equipe
                que conhece cada curva do caminho.
              </p>

              <ul class="mt-8 space-y-3.5">
                {[
                  'Cozinha própria: café, almoço e jantar servidos na Villa, todos os dias.',
                  'Barco de Alter do Chão até a pousada, ida e volta, dentro do pacote.',
                  'Anfitrião local morando na Villa — não uma recepção que fecha às 18h.',
                ].map((item) => (
                  <li class="flex gap-3.5">
                    <Voluta class="mt-1.5 text-rede" />
                    <span class="text-tinta/80">{item}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- foto rompe o container e sangra até a borda direita da tela -->
            <div class="relative lg:mr-[calc(50%-50vw)]">
              <Image
                src={hero5}
                alt="Área comum da Villa, com telhado de palha e estrutura de madeira"
                widths={[600, 900, 1400]}
                sizes="(min-width: 1024px) 55vw, 100vw"
                class="aspect-[5/4] w-full object-cover lg:aspect-[4/3]"
              />
              <figcaption class="numero absolute -top-3 left-4 bg-areia px-3 py-1.5 text-[0.625rem] uppercase tracking-[0.16em] text-cinza lg:left-8">
                Área comum · madeira e palha
              </figcaption>
            </div>
          </div>
        </div>
      </section>

      <!-- ══════════ UM DIA NA VILLA ══════════ -->
      <section class="secao bg-mata text-areia">
        <div class="container-editorial">
          <div class="grid gap-14 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] lg:gap-x-24">
            <div>
              <Campo tone="claro">Pacote de 1 diária <Voluta class="text-areia/35" /> 06h30 às 21h00</Campo>
              <h2 class="font-display text-titulo mt-5 text-areia">Um dia na Villa</h2>
              <Tinta class="my-8 max-w-[12rem]" tone="claro" />
              <p class="text-intro text-areia/75">
                Um dia com horário só existe onde tem cozinha, barco e equipe.
                É por isso que o roteiro abre o site: ele prova, sem precisar
                dizer, que isto aqui é uma pousada.
              </p>
              <p class="mt-5 text-areia/60">
                E resolve a dúvida que fazia gente desistir: cada momento diz
                ali mesmo se é do pacote ou pago direto à comunidade.
              </p>
            </div>

            <div class="lg:pt-2">
              <LinhaDoDia momentos={momentos} rotulos={rotulos} tone="escuro" />
            </div>
          </div>
        </div>
      </section>

      <!-- ══════════ NOITE ══════════ -->
      <section class="relative">
        <Image
          src={gal3}
          alt="Varanda de uma cabana à noite, com rede e luminária de fibra acesa"
          widths={[900, 1400, 2000]}
          sizes="100vw"
          class="h-[60svh] w-full object-cover"
        />
        <div class="absolute inset-0 flex items-end bg-gradient-to-t from-mata-fundo/85 to-transparent">
          <div class="container-editorial pb-12">
            <blockquote class="font-display max-w-2xl text-secao text-areia">
              “Come bem, dorme fundo. Volta cansado do melhor jeito possível.”
            </blockquote>
            <Campo tone="claro" class="mt-4">Cabana 7 <Voluta class="text-areia/35" /> 21h40</Campo>
          </div>
        </div>
      </section>

      <!-- ══════════ REFERÊNCIA DAS PEÇAS ══════════ -->
      <section class="secao">
        <div class="container-editorial">
          <Campo tone="escuro">Referência interna <Voluta class="text-cinza/50" /> não vai ao ar</Campo>
          <h2 class="font-display text-secao mt-4">As peças</h2>
          <Tinta class="my-8" />

          <div class="grid gap-x-16 gap-y-12 md:grid-cols-2">
            <div>
              <p class="numero mb-5 text-[0.6875rem] uppercase tracking-[0.16em] text-cinza">Paleta</p>
              <div class="grid grid-cols-4 gap-3">
                {cores.map((c) => (
                  <div>
                    <div class="aspect-square w-full border border-mata/12" style={`background:${c.hex}`}></div>
                    <p class="numero mt-2 text-[0.625rem] uppercase tracking-[0.14em] text-mata">{c.nome}</p>
                    <p class="mt-1 text-xs leading-snug text-cinza">{c.uso}</p>
                  </div>
                ))}
              </div>
            </div>

            <div>
              <p class="numero mb-5 text-[0.6875rem] uppercase tracking-[0.16em] text-cinza">Botões e marca</p>
              <div class="flex flex-wrap items-center gap-4">
                <a href="#" class="btn btn-primario">Reservar</a>
                <a href="#" class="btn btn-secundario">Ver pacotes</a>
              </div>
              <div class="mt-6 flex flex-wrap items-center gap-6">
                <Logo />
                <div class="bg-mata px-5 py-3"><Logo tone="claro" /></div>
              </div>
            </div>

            <div>
              <p class="numero mb-5 text-[0.6875rem] uppercase tracking-[0.16em] text-cinza">Tipografia</p>
              <p class="font-display text-titulo text-mata">Durma na floresta</p>
              <p class="numero mt-3 text-xl text-mata">07:00 · 13 cabanas · 1h30 de barco</p>
              <p class="mt-3 text-tinta/80">Texto corrido em Archivo, 350 de peso.</p>
            </div>

            <div>
              <p class="numero mb-5 text-[0.6875rem] uppercase tracking-[0.16em] text-cinza">Traço e marca de lista</p>
              <Tinta peso="medio" />
              <ul class="mt-5 space-y-2">
                <li class="flex gap-3"><Voluta class="mt-1.5 text-rede" /><span class="text-tinta/80">A voluta do seu logo, no lugar do check genérico.</span></li>
                <li class="flex gap-3"><Voluta class="mt-1.5 text-rede" /><span class="text-tinta/80">Nenhum filete de 1px no site inteiro.</span></li>
              </ul>
            </div>
          </div>
        </div>
      </section>
    </main>

    <Footer locale={locale} />
  </body>
</html>
