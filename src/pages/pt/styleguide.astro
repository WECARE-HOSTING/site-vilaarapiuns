---
/**
 * Página interna de aprovação do design (Fase 1).
 * Não entra no menu nem no sitemap — some antes de publicar.
 */
import '@/styles/global.css';
import Logo from '@/components/Logo.astro';
import Olho from '@/components/Olho.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import FaixaGarantias from '@/components/FaixaGarantias.astro';
import LinhaDoDia from '@/components/LinhaDoDia.astro';
import { useTranslations } from '@/i18n/utils';
import { Image } from 'astro:assets';
import hero1 from '@/assets/imgs/hero1.jpg';
import gal3 from '@/assets/imgs/gal3.jpg';
import sobre from '@/assets/imgs/sobre.jpg';

const locale = 'pt' as const;
const t = useTranslations(locale);

const cores = [
  { nome: 'areia',       hex: '#f7f1e8', uso: 'Fundo dominante. A areia branca do Arapiuns.' },
  { nome: 'areia-2',     hex: '#efe4d2', uso: 'Superfície secundária, cards, faixas.' },
  { nome: 'areia-3',     hex: '#e3d3ba', uso: 'Filetes e bordas.' },
  { nome: 'mata',        hex: '#22402b', uso: 'Títulos e seções escuras. O verde da floresta.' },
  { nome: 'rede',        hex: '#2f6b72', uso: 'ACENTO PRINCIPAL. Links, "incluso", a linha do dia.' },
  { nome: 'brasa',       hex: '#a85c2c', uso: 'Só o botão de ação. A luz da fogueira.' },
  { nome: 'tinta',       hex: '#1f1e1b', uso: 'Texto corrido.' },
  { nome: 'cinza',       hex: '#635e56', uso: 'Texto secundário. Cinza quente, nunca neutro.' },
];

const momentos = [
  { hora: '07:00', titulo: 'Café da manhã na varanda', detalhe: 'Frutas, tapioca e café — preparado na cozinha da Villa.', refeicao: true },
  { hora: '08:30', titulo: 'Trilha até o Lago Azul', detalhe: 'Com guia da equipe. Canoa na lagoa secreta.' },
  { hora: '12:30', titulo: 'Almoço na comunidade ribeirinha', detalhe: 'Peixe fresco, feito pela família que recebe o grupo.', tipo: 'comunidade' as const, refeicao: true },
  { hora: '14:00', titulo: 'Farinhada e tecelagem', detalhe: 'Oficina com as artesãs da comunidade.', tipo: 'comunidade' as const },
  { hora: '17:30', titulo: 'Pôr do sol na Ponta Grande' },
  { hora: '19:30', titulo: 'Jantar e fogueira na praia', detalhe: 'Todas as refeições na Villa estão inclusas.', refeicao: true },
];

const rotulos = { incluso: t('dia.incluso'), comunidade: t('dia.comunidade') };
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Design system · Villa Arapiuns</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@300..600&family=Archivo+Narrow:wght@400..700&family=Fraunces:opsz,wght@9..144,300..600&display=swap" />
  </head>

  <body>
    <Header locale={locale} pageKey="home" />

    <main class="pt-24">
      <!-- ══ Abertura ══ -->
      <section class="container-editorial pt-10 pb-14">
        <Olho tone="cinza">Fase 1 · Design system para aprovação</Olho>
        <h1 class="font-display text-titulo mt-4 max-w-3xl">
          A cara do site, antes de qualquer página
        </h1>
        <p class="text-intro text-cinza mt-5 max-w-2xl">
          Tudo aqui saiu das fotos da própria Villa e do seu logo — não de uma paleta pronta.
          Aprove esta página e eu monto a home em cima dela.
        </p>
      </section>

      <FaixaGarantias locale={locale} />

      <!-- ══ De onde veio ══ -->
      <section class="container-editorial secao">
        <Olho>De onde veio</Olho>
        <h2 class="font-display text-secao mt-4 mb-10 max-w-2xl">
          As cores não foram escolhidas. Foram encontradas.
        </h2>

        <div class="grid gap-8 md:grid-cols-3">
          <figure>
            <Image src={gal3} alt="Varanda de uma cabana à noite, com rede e luminária de fibra" widths={[400, 800, 1200]} sizes="(min-width: 768px) 30vw, 100vw" class="aspect-[4/3] w-full object-cover" />
            <figcaption class="mt-3 text-sm text-cinza">
              <span class="inline-block h-3 w-3 translate-y-0.5 bg-rede mr-2"></span>
              A rede da varanda deu o <strong class="text-rede font-medium">verde-azulado</strong> — o acento principal do site.
            </figcaption>
          </figure>
          <figure>
            <Image src={sobre} alt="Fogueira e velas na praia à noite, à beira do rio" widths={[400, 800, 1200]} sizes="(min-width: 768px) 30vw, 100vw" class="aspect-[4/3] w-full object-cover" />
            <figcaption class="mt-3 text-sm text-cinza">
              <span class="inline-block h-3 w-3 translate-y-0.5 bg-brasa mr-2"></span>
              A fogueira deu o <strong class="text-brasa font-medium">âmbar</strong>, reservado só ao botão de reserva.
            </figcaption>
          </figure>
          <figure>
            <Image src={hero1} alt="Portão de madeira da Villa aberto para a praia e o rio" widths={[400, 800, 1200]} sizes="(min-width: 768px) 30vw, 100vw" class="aspect-[4/3] w-full object-cover" />
            <figcaption class="mt-3 text-sm text-cinza">
              <span class="inline-block h-3 w-3 translate-y-0.5 bg-areia-3 mr-2"></span>
              A areia da praia virou o <strong class="text-mata font-medium">fundo</strong> de todo o site.
            </figcaption>
          </figure>
        </div>
      </section>

      <!-- ══ Paleta ══ -->
      <section class="bg-areia-2/50 border-y border-areia-3">
        <div class="container-editorial secao">
          <Olho>Paleta</Olho>
          <h2 class="font-display text-secao mt-4 mb-10">Oito cores, dois acentos</h2>

          <div class="grid gap-x-8 gap-y-6 sm:grid-cols-2 lg:grid-cols-4">
            {cores.map((c) => (
              <div>
                <div class="h-20 w-full border border-black/10" style={`background:${c.hex}`}></div>
                <p class="olho mt-3 text-mata">{c.nome}</p>
                <p class="numero text-xs text-cinza-claro mt-0.5">{c.hex}</p>
                <p class="mt-1.5 text-sm text-cinza leading-snug">{c.uso}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- ══ Tipografia ══ -->
      <section class="container-editorial secao">
        <Olho>Tipografia</Olho>
        <h2 class="font-display text-secao mt-4 mb-3">Três vozes, duas famílias</h2>
        <p class="text-cinza max-w-2xl mb-12">
          Seu logo é uma condensada em caixa alta, com um desenho botânico feito à mão.
          A tipografia do site responde a isso — e é por isso que troquei as fontes do plano original.
        </p>

        <div class="space-y-12">
          <div class="grid gap-6 md:grid-cols-[10rem_1fr] md:gap-10">
            <div>
              <p class="olho text-rede">Fraunces</p>
              <p class="text-sm text-cinza mt-1.5">Títulos. Serifa macia, de baixo contraste — o mesmo traço "feito à mão" do seu logo.</p>
            </div>
            <div class="min-w-0">
              <p class="font-display text-display text-mata">Durma na floresta</p>
              <p class="font-display text-titulo text-mata mt-2">Acorde na Amazônia</p>
              <p class="font-display text-secao text-mata mt-4">Um dia começa no lago e termina na fogueira</p>
            </div>
          </div>

          <hr class="filete" />

          <div class="grid gap-6 md:grid-cols-[10rem_1fr] md:gap-10">
            <div>
              <p class="olho text-rede">Archivo Narrow</p>
              <p class="text-sm text-cinza mt-1.5">Rótulos, menu, horários. Ecoa o wordmark ARAPIUNS.</p>
            </div>
            <div class="min-w-0 space-y-3">
              <p class="olho text-mata text-base">A POUSADA · PENSÃO COMPLETA · EXPERIÊNCIAS · PACOTES</p>
              <p class="numero text-2xl text-mata">07:00 · 12:30 · 17:30 · 19:30</p>
              <p class="numero text-2xl text-mata">13 cabanas · 26 hóspedes · 1h30 de barco</p>
            </div>
          </div>

          <hr class="filete" />

          <div class="grid gap-6 md:grid-cols-[10rem_1fr] md:gap-10">
            <div>
              <p class="olho text-rede">Archivo</p>
              <p class="text-sm text-cinza mt-1.5">Texto corrido. Mesma família da condensada, então tudo parece parente.</p>
            </div>
            <div class="min-w-0">
              <p class="text-intro max-w-2xl">
                A Villa Arapiuns é uma pousada às margens do rio, com treze cabanas e uma equipe
                que cuida do barco, da cozinha e do caminho.
              </p>
              <p class="mt-4 max-w-2xl text-cinza">
                Você chega, deixa as malas e sai. Volta cansado do melhor jeito possível — pela floresta,
                pelo sol, pelas histórias. Come bem, dorme fundo. Em mais de cinco anos de operação,
                nenhum incidente.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- ══ Assinatura ══ -->
      <section class="bg-mata text-areia">
        <div class="container-editorial secao">
          <div class="grid gap-12 lg:grid-cols-[1fr_1.15fr] lg:gap-20">
            <div>
              <Olho tone="areia">O elemento-assinatura</Olho>
              <h2 class="font-display text-titulo text-areia mt-4">Um dia na Villa</h2>
              <p class="text-intro text-areia/75 mt-6">
                É a única coisa do site que nenhum concorrente tem — e faz três trabalhos de uma vez.
              </p>
              <ul class="mt-8 space-y-4 text-areia/70">
                <li class="border-l-2 border-rede-claro pl-4">
                  <strong class="text-areia font-medium">Prova que é pousada.</strong>{' '}
                  Um dia com horário só existe onde tem cozinha, barco e equipe.
                </li>
                <li class="border-l-2 border-rede-claro pl-4">
                  <strong class="text-areia font-medium">Acaba com a dúvida do que está incluso.</strong>{' '}
                  Cada momento diz ali mesmo se é do pacote ou pago à comunidade.
                </li>
                <li class="border-l-2 border-rede-claro pl-4">
                  <strong class="text-areia font-medium">É o rio.</strong>{' '}
                  A linha que desce a página é a mesma água que leva o hóspede até lá.
                </li>
              </ul>
            </div>

            <div class="lg:pt-4">
              <LinhaDoDia momentos={momentos} rotulos={rotulos} tone="escuro" />
            </div>
          </div>
        </div>
      </section>

      <!-- ══ Componentes ══ -->
      <section class="container-editorial secao">
        <Olho>Componentes</Olho>
        <h2 class="font-display text-secao mt-4 mb-10">As peças</h2>

        <div class="grid gap-12 md:grid-cols-2 lg:gap-16">
          <div>
            <p class="olho text-cinza-claro mb-5">Botões</p>
            <div class="flex flex-wrap items-center gap-4">
              <a href="#" class="btn btn-primario">Reservar</a>
              <a href="#" class="btn btn-secundario">Ver pacotes</a>
              <a href="#" class="link-texto text-sm">Como chegar até a Villa</a>
            </div>
            <p class="mt-5 text-sm text-cinza">
              O âmbar aparece cheio em um único lugar do site inteiro: o botão de reserva.
              É o que faz o olho ir para lá sem precisar gritar.
            </p>
          </div>

          <div>
            <p class="olho text-cinza-claro mb-5">Olho de seção</p>
            <div class="space-y-4">
              <Olho>A pousada</Olho>
              <Olho tone="brasa">Pacote 2 diárias</Olho>
              <Olho tone="cinza">Rio Arapiuns · Pará</Olho>
            </div>
          </div>

          <div>
            <p class="olho text-cinza-claro mb-5">Marca</p>
            <div class="flex flex-wrap items-center gap-8">
              <Logo />
              <div class="bg-mata px-6 py-4"><Logo tone="claro" /></div>
            </div>
            <p class="mt-5 text-sm text-cinza">
              Redesenhei o traço do logo em SVG: escala sem borrar, herda a cor do fundo
              e pesa 1 KB no lugar dos 576 KB do PNG atual.
            </p>
          </div>

          <div>
            <p class="olho text-cinza-claro mb-5">Número em destaque</p>
            <dl class="grid grid-cols-3 gap-6">
              <div><dt class="font-display text-titulo text-mata leading-none">13</dt><dd class="olho text-cinza mt-2">Cabanas</dd></div>
              <div><dt class="font-display text-titulo text-mata leading-none">26</dt><dd class="olho text-cinza mt-2">Hóspedes</dd></div>
              <div><dt class="font-display text-titulo text-mata leading-none">5+</dt><dd class="olho text-cinza mt-2">Anos</dd></div>
            </dl>
          </div>
        </div>
      </section>
    </main>

    <Footer locale={locale} />
  </body>
</html>
