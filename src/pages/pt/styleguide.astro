---
/**
 * Página interna de aprovação do design (Fase 1).
 * Mostra a linguagem visual aplicada de verdade — hero, seções e a
 * linha do dia — e só no fim a referência das peças.
 * Fora do menu e do sitemap; some antes de publicar.
 */
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import FaixaGarantias from '@/components/FaixaGarantias.astro';
import LinhaDoDia from '@/components/LinhaDoDia.astro';
import Campo from '@/components/Campo.astro';
import Voluta from '@/components/Voluta.astro';
import Logo from '@/components/Logo.astro';
import ListaExperiencias from '@/components/ListaExperiencias.astro';
import ColunaDeReels from '@/components/ColunaDeReels.astro';
import { href } from '@/i18n/routes';
import { useTranslations } from '@/i18n/utils';
import { Image } from 'astro:assets';
import hero3 from '@/assets/imgs/hero3.jpg';
import hero5 from '@/assets/imgs/hero5.jpg';
import gal3 from '@/assets/imgs/gal3.jpg';
import hero1 from '@/assets/imgs/hero1.jpg';
import sobre from '@/assets/imgs/sobre.jpg';
import tucuxi from '@/assets/imgs/tucuxi.jpg';
import reelCanoaPoster from '@/assets/imgs/reel-canoa-igapo-poster.jpg';
import reelTecelagemPoster from '@/assets/imgs/reel-tecelagem-poster.jpg';
import reelUrucumPoster from '@/assets/imgs/reel-urucum-poster.jpg';
import reelMeliponarioPoster from '@/assets/imgs/reel-meliponario-poster.jpg';
import reelPiracaiaPoster from '@/assets/imgs/reel-piracaia-poster.jpg';

const locale = 'pt' as const;
const t = useTranslations(locale);

const momentos = [
  { hora: '07:00', titulo: 'Café na varanda', detalhe: 'Tapioca, frutas do quintal, café passado na hora.', refeicao: true },
  { hora: '08:30', titulo: 'Trilha até o Lago Azul', detalhe: 'Com o guia da casa. Canoa na lagoa escondida.' },
  { hora: '12:30', titulo: 'Almoço na comunidade', detalhe: 'Peixe fresco, feito pela família que recebe o grupo.', tipo: 'comunidade' as const, refeicao: true },
  { hora: '14:00', titulo: 'Farinhada e tecelagem', detalhe: 'Oficina com as artesãs da comunidade.', tipo: 'comunidade' as const },
  { hora: '17:30', titulo: 'Pôr do sol na Ponta Grande' },
  { hora: '19:30', titulo: 'Jantar e fogueira na praia', refeicao: true },
];
const rotulos = { incluso: t('dia.incluso'), comunidade: t('dia.comunidade') };

// Só experiências cujas fotos eu confirmei olhando o arquivo. As demais
// (Samaúma, Coroca, meliponário) entram na Fase 4, com foto própria.
const experiencias = [
  {
    nome: 'Lago Azul',
    detalhe: 'Trilha pela mata até a lagoa escondida, e canoa na água parada',
    fotos: [hero3, hero5] as [typeof hero3, typeof hero5],
    alt: ['Trilha de areia na floresta', 'Área comum da Villa'] as [string, string],
  },
  {
    nome: 'Ponta Grande',
    detalhe: 'O pôr do sol na praia de areia branca, no fim da tarde',
    fotos: [hero1, hero3] as [typeof hero1, typeof hero3],
    alt: ['Portão de madeira aberto para a praia', 'Trilha na floresta'] as [string, string],
  },
  {
    nome: 'Fogueira na praia',
    detalhe: 'Jantar à beira do rio, com velas na areia e piracaia',
    fotos: [sobre, gal3] as [typeof sobre, typeof gal3],
    alt: ['Fogueira e velas na praia à noite', 'Varanda com rede'] as [string, string],
  },
  {
    nome: 'A rede, no fim do dia',
    detalhe: 'A varanda do seu bangalô, quando não sobra nada para fazer',
    fotos: [gal3, sobre] as [typeof gal3, typeof sobre],
    alt: ['Varanda com rede e luminária de fibra', 'Fogueira na praia'] as [string, string],
  },
];

// Fase 3, cinco clipes aprovados pelo Carlos (docs/video.md §6). Um sexto
// (reel-oficina) foi retirado — a câmera foi segurada de lado na filmagem.
const reels = [
  { legenda: 'O boto tucuxi, pertinho da Villa', imagem: tucuxi, alt: 'Boto tucuxi na superfície do rio, perto da Villa' },
  { legenda: 'A canoa entre as copas, na cheia', video: '/video/reels/reel-canoa-igapo.mp4', poster: reelCanoaPoster },
  { legenda: 'A tecelagem, de perto', video: '/video/reels/reel-tecelagem.mp4', poster: reelTecelagemPoster },
  { legenda: 'O urucum, tingindo a palha', video: '/video/reels/reel-urucum.mp4', poster: reelUrucumPoster },
  { legenda: 'O meliponário, mel de abelha nativa', video: '/video/reels/reel-meliponario.mp4', poster: reelMeliponarioPoster },
  { legenda: 'A piracaia, à luz de velas', video: '/video/reels/reel-piracaia.mp4', poster: reelPiracaiaPoster },
];

/* CORRIGIDO EM 22/08/2026 (Fase 4): este array listava os 8 tokens da
   paleta verde-mata, que saiu em 21/08. É a paleta areia-e-mar em uso hoje —
   ver src/styles/global.css para as razões de contraste medidas de cada. */
const cores = [
  { nome: 'areia-clara', hex: '#fdf8ee', uso: 'Chão da página — a areia seca ao sol.' },
  { nome: 'areia',       hex: '#f4e7cf', uso: 'Superfície de seção — a areia da foto.' },
  { nome: 'areia-sol',   hex: '#ad7519', uso: 'A régua do layout. A emenda vai sempre a 100%.' },
  { nome: 'areia-funda', hex: '#8a5a1e', uso: 'Etiqueta e medida sobre areia.' },
  { nome: 'mar-fundo',   hex: '#0d3244', uso: 'O corpo do texto. 12,7:1 sobre areia — e o rodapé.' },
  { nome: 'mar',         hex: '#17506a', uso: 'O título. 8,3:1 sobre areia — e a faixa de fecho.' },
  { nome: 'ceu',         hex: '#1b6aad', uso: 'A única cor que grita: CTA e link, em nada mais.' },
  { nome: 'ceu-hover',   hex: '#12466f', uso: 'Hover do CTA — escurece, não clareia.' },
  { nome: 'espuma',      hex: '#cfe3ec', uso: 'O corpo do texto sobre mar-fundo.' },
  { nome: 'sol',         hex: '#e9bd68', uso: 'Etiqueta e anel de foco sobre escuro.' },
  { nome: 'coral-luz',   hex: '#efb391', uso: 'Acento com função sobre escuro. Só ali.' },
  { nome: 'erro',        hex: '#a3311a', uso: 'Erro de formulário sobre areia. 6,6:1.' },
];
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Design system · Villa Arapiuns</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,300..700&family=Archivo+Narrow:wght@400..700&display=swap" />
  </head>

  <body>
    <Header locale={locale} pageKey="home" sobreFoto />

    <main>
      <!-- ══════════ HERO ══════════ -->
      <section class="sobre-escuro relative min-h-[88svh] w-full overflow-hidden bg-mar-fundo">
        <Image src={hero3} alt="Três pessoas caminhando numa trilha de areia na floresta, o guia da Villa à frente" widths={[800, 1280, 1920, 2400]} sizes="100vw" loading="eager" fetchpriority="high" class="absolute inset-0 h-full w-full object-cover object-[72%_center]"
        />
        <!-- escurecimento só onde o texto pousa, para a foto não morrer -->
        {/* No celular a tela é estreita: só o véu vertical, senão a foto some.
            A partir de md entra o lateral, que abre a faixa escura do texto. */}
        <div class="absolute inset-0 bg-gradient-to-t from-mar-fundo/95 via-mar-fundo/50 to-mar-fundo/20"></div>
        <div class="absolute inset-0 hidden bg-gradient-to-r from-mar-fundo via-mar-fundo/75 to-transparent to-65% md:block lg:to-58%"></div>

        <div class="container-editorial relative flex min-h-[88svh] flex-col justify-end pb-10 pt-32 md:pb-12">
          <div class="max-w-[34rem] lg:max-w-[38rem]">
            <h1 class="font-display text-display ">
              Uma pousada na Amazônia.
              <span class="block">Não um passeio.</span>
            </h1>

            <p class="text-intro mt-7 max-w-md">
              Treze bangalôs às margens do Rio Arapiuns. Você chega, deixa as malas
              e sai — o barco, a cozinha e o caminho são da casa.
            </p>

            <div class="mt-9 grid grid-cols-2 gap-3 sm:flex sm:flex-wrap sm:items-center sm:gap-4">
              <a href="#" class="btn btn-primario px-4 sm:px-8">Consultar datas</a>
              <a href={href(locale, 'packages')} class="btn btn-secundario px-4 sm:px-8">Ver os pacotes</a>
            </div>
          </div>

          {/* Faixa de dados no pé da foto. Fica aqui, e não acima do título,
              porque rótulo em cima de heading é o tique que denuncia a máquina —
              e porque aqui ela responde "onde fica e como chego", que é a
              primeira dúvida de quem vê a foto. */}
          <Campo class="mt-12 border-t border-espuma/20 pt-5">
            <span>02°26′S&nbsp;&nbsp;55°16′W</span>
            <Voluta />
            <span>1h30 de barco de Alter do Chão</span>
            <Voluta />
            <span>13 bangalôs · 26 hóspedes</span>
          </Campo>
        </div>

        <!-- Nota de campo: encosta na borda da foto, como anotação a lápis -->
        <aside class="sobre-escuro pointer-events-none absolute bottom-0 right-0 hidden max-w-xs bg-mar px-7 py-6 lg:block">
          <Voluta class="mb-3 text-areia-sol" />
          <p class="text-sm leading-snug">
            À frente, o guia da Villa. Ninguém sai sozinho — e ninguém carrega mochila
            atrás de reserva de barco.
          </p>
          <hr class="emenda border-t" />
        </aside>
      </section>

      <FaixaGarantias locale={locale} />

      <!-- ══════════ A POUSADA ══════════ -->
      <section class="secao overflow-hidden">
        <div class="container-editorial">
          <div class="grid items-center gap-y-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] lg:gap-x-20">
            <div class="lg:pr-4">
              <h2 class="font-display text-titulo">
                Onde a floresta começa<br />e o tempo para de correr
              </h2>

              <hr class="emenda border-t" />

              <p class="text-intro">
                A Villa Arapiuns é uma pousada de base comunitária às margens do rio,
                no Pará. Não é um acampamento e não é um hotel: são treze bangalôs de
                madeira e palha, uma cozinha que funciona o dia inteiro e uma equipe
                que conhece cada curva do caminho.
              </p>

              <ul class="mt-8 space-y-3.5">
                {[
                  'Cozinha própria: café, almoço e jantar servidos na Villa, todos os dias.',
                  'Barco de Alter do Chão até a pousada, ida e volta, dentro do pacote.',
                  'Anfitrião local morando na Villa — não uma recepção que fecha às 18h.',
                ].map((item) => (
                  <li class="flex gap-3.5">
                    <Voluta class="mt-1.5 text-areia-sol" />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- foto rompe o container e sangra até a borda direita da tela -->
            <div class="relative lg:mr-[calc(50%-50vw)]">
              <Image src={hero5} alt="Área comum da Villa, com telhado de palha e estrutura de madeira" widths={[600, 900, 1400]} sizes="(min-width: 1024px) 55vw, 100vw" class="aspect-[5/4] w-full object-cover lg:aspect-[4/3]"
              />
              <figcaption class="sobre-escuro numero absolute -top-3 left-4 bg-mar px-3 py-1.5 text-[0.625rem] uppercase tracking-[0.16em] lg:left-8">
                Área comum · madeira e palha
              </figcaption>
            </div>
          </div>
        </div>
      </section>

      <!-- ══════════ EXPERIÊNCIAS ══════════ -->
      <section class="secao border-t border-mar/10">
        <div class="container-editorial">
          <div class="grid gap-10 lg:grid-cols-[minmax(0,0.72fr)_minmax(0,1fr)] lg:gap-x-20">
            <div>
              <h2 class="font-display text-titulo">O que se faz<br />durante o dia</h2>
              <hr class="emenda border-t" />
              <p>
                Passe o mouse nos nomes. No celular as fotos já ficam à mostra —
                um componente que só existe no hover não existe para metade das pessoas.
              </p>
            </div>
            <div>
              <ListaExperiencias itens={experiencias} />
            </div>
          </div>
        </div>
      </section>

      <!-- ══════════ UM DIA NA VILLA ══════════ -->
      <section class="secao bg-mar sobre-escuro">
        <div class="container-editorial">
          <div class="grid gap-14 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] lg:gap-x-24">
            <div>
              <h2 class="font-display text-titulo ">Um dia na Villa</h2>
              <hr class="emenda border-t" />
              <p class="text-intro">
                Um dia com horário só existe onde tem cozinha, barco e equipe.
                É por isso que o roteiro abre o site: ele prova, sem precisar
                dizer, que isto aqui é uma pousada.
              </p>
              <p class="mt-5">
                E resolve a dúvida que fazia gente desistir: cada momento diz
                ali mesmo se é do pacote ou pago direto à comunidade.
              </p>
            </div>

            <div class="lg:pt-2">
              <Campo class="mb-6 border-b border-espuma/15 pb-4">
                Pacote de 1 diária <Voluta /> 06h30 às 21h00
              </Campo>
              <LinhaDoDia momentos={momentos} rotulos={rotulos} tone="escuro" />
            </div>
          </div>
        </div>
      </section>

      <!-- ══════════ NOITE ══════════ -->
      <section class="relative">
        <Image src={gal3} alt="Varanda de uma bangalô à noite, com rede e luminária de fibra acesa" widths={[900, 1400, 2000]} sizes="100vw" class="h-[60svh] w-full object-cover"
        />
        <div class="absolute inset-0 flex items-end bg-gradient-to-t from-mar-fundo/85 to-transparent">
          <div class="container-editorial pb-12">
            <blockquote class="font-display max-w-2xl text-secao ">
              “Come bem, dorme fundo. Volta cansado do melhor jeito possível.”
            </blockquote>
            <Campo class="mt-4">Bangalô 7 <Voluta /> 21h40</Campo>
          </div>
        </div>
      </section>

      <!-- ══════════ A COLUNA DE REELS — Fase 4, componente novo ══════════
           Variante C escolhida pelo Carlos na Fase 2 ("o vertical manda"),
           olhando o protótipo rodar, não pela captura. Cinco clipes reais,
           aprovados por ele na Fase 3 — ver docs/video.md §6. Mecanismo:
           scroll-snap nativo, zero JavaScript de rolagem; o único script
           liga o Padrão 2 do playbook (tocar só o que está perto da tela). -->
      <section class="secao border-t border-mar/10">
        <div class="container-editorial">
          <div class="flex flex-wrap items-baseline justify-between gap-4">
            <h2 class="font-display text-titulo">O vertical manda</h2>
            <Campo>Retrato e vídeo 9:16, a mesma coluna</Campo>
          </div>
          <hr class="emenda mt-6 border-t" />
          <div class="mt-8">
            <ColunaDeReels rotulo="Cenas da Villa, role para o lado" itens={reels} />
          </div>
          <p class="meta mt-4 max-w-[62ch] text-areia-funda">
            Cinco clipes recortados do acervo sem legenda queimada (docs/video.md §3) — os
            Reels institucionais têm o título em PT/EN gravado no pixel e ficam de fora por
            ora. 0,88&nbsp;MB no total pelos cinco; a janela de reprodução impede que a
            tira inteira decodifique de uma vez.
          </p>
        </div>
      </section>

      <!-- ══════════ REFERÊNCIA DAS PEÇAS ══════════ -->
      <section class="secao">
        <div class="container-editorial">
          <h2 class="font-display text-secao">As peças</h2>
          <Campo class="mt-3">Referência interna <Voluta  /> não vai ao ar</Campo>
          <hr class="emenda border-t" />

          <div class="grid gap-x-16 gap-y-12 md:grid-cols-2">
            <div>
              <p class="numero mb-5 text-[0.6875rem] uppercase tracking-[0.16em]">Paleta</p>
              <div class="grid grid-cols-4 gap-3">
                {cores.map((c) => (
                  <div>
                    <div class="aspect-square w-full border border-mar/12" style={`background:${c.hex}`}></div>
                    <p class="numero mt-2 text-[0.625rem] uppercase tracking-[0.14em] ">{c.nome}</p>
                    <p class="mt-1 text-xs leading-snug">{c.uso}</p>
                  </div>
                ))}
              </div>
            </div>

            <div>
              <p class="numero mb-5 text-[0.6875rem] uppercase tracking-[0.16em]">Botões e marca</p>
              <div class="flex flex-wrap items-center gap-4">
                <a href="#" class="btn btn-primario">Reservar</a>
                <a href="#" class="btn btn-secundario">Ver pacotes</a>
              </div>
              <div class="mt-6 flex flex-wrap items-center gap-6">
                <Logo />
                <div class="sobre-escuro bg-mar px-5 py-3"><Logo /></div>
              </div>
            </div>

            <div>
              <p class="numero mb-5 text-[0.6875rem] uppercase tracking-[0.16em]">Tipografia</p>
              <p class="font-display cor-titulo text-titulo">Durma na floresta</p>
              <p class="numero mt-3 text-xl ">07:00 · 13 bangalôs · 1h30 de barco</p>
              <p class="mt-3">Texto corrido em Archivo, 350 de peso.</p>
            </div>

            <div>
              <p class="numero mb-5 text-[0.6875rem] uppercase tracking-[0.16em]">Traço e marca de lista</p>
              <hr class="emenda border-t" />
              <ul class="mt-5 space-y-2">
                <li class="flex gap-3"><Voluta class="mt-1.5 text-areia-sol" /><span>A voluta do seu logo, no lugar do check genérico.</span></li>
                <li class="flex gap-3"><Voluta class="mt-1.5 text-areia-sol" /><span>Nenhum filete de 1px no site inteiro.</span></li>
              </ul>
            </div>
          </div>
        </div>
      </section>
    </main>

    <Footer locale={locale} />
  </body>
</html>
