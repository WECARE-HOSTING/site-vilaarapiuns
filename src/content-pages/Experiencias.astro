---
/**
 * EXPERIÊNCIAS — agrupadas por elemento, não numa lista corrida.
 *
 * Agrupar em água / mata / gente resolve a falha de chunking que a crítica
 * apontou: eram seis ou mais itens soltos, acima do limite de memória de
 * trabalho. Três grupos de dois a cinco cabem.
 *
 * Cada item diz onde entra — incluso no pacote, à parte na pousada, ou pago
 * direto à comunidade. Era a confusão central do produto.
 *
 * RODADA DE FOTOGRAFIA (20/08/2026). O cliente disse "vamos vender com as
 * imagens", e esta era a página mais pobre do site: falava de igapó, pôr do
 * sol, piracaia e comunidades sem mostrar nenhum dos quatro. Agora cada grupo
 * abre com a sua fotografia, e o fim da página é uma folha de contato.
 *
 * Duas disciplinas do mundo visual governam a escolha das fotos:
 *   · Disciplina 3 — tipo nenhum sobre fotografia. Toda foto é <figure> com a
 *     legenda EMBAIXO. Nenhum gradiente, nenhum véu, nenhuma palavra em cima.
 *   · Disciplina 2 — cada legenda diz o que a foto é, não o que ela evoca.
 *
 * RESOLUÇÃO: metade destas fotos veio de recorte do site antigo, a ~1290 px.
 * São nítidas e limpas (foram conferidas uma a uma), mas não aguentam largura
 * cheia — por isso vivem em coluna e em card, com `widths` que nunca passam do
 * nativo. Ampliar não cria detalhe. Os originais em alta seguem pendentes com
 * o fotógrafo, e quando chegarem é só trocar o arquivo.
 */
import { Image } from 'astro:assets';
import AberturaPagina from '@/components/AberturaPagina.astro';
import ListaCorte from '@/components/ListaCorte.astro';
import ColunaDeReels from '@/components/ColunaDeReels.astro';
import Voluta from '@/components/Voluta.astro';
import { href } from '@/i18n/routes';
import { useTranslations, useList } from '@/i18n/utils';
import type { Locale } from '@/i18n/config';

/* 2400 px — aguentam largura cheia */
import igapoCanoa from '@/assets/imgs/igapo-canoa.jpg';
import caiaques from '@/assets/imgs/caiaques.jpg';
import trilhaGrupo from '@/assets/imgs/trilha-guia.jpg';
import luauPraia from '@/assets/imgs/luau-praia.jpg';
import igarape from '@/assets/imgs/igarape.jpg';

/* ~1200–1290 px — só coluna e card */
import aguaTransparente from '@/assets/imgs/agua-transparente.jpg';
import bancoAreia from '@/assets/imgs/banco-areia.jpg';
import igapoTroncos from '@/assets/imgs/igapo-troncos.jpg';
import porDoSolGrupo from '@/assets/imgs/porsol-gente.jpg';
import samauma from '@/assets/imgs/samauma-grupo.jpg';
import massagem from '@/assets/imgs/massagem.jpg';
import farinhada from '@/assets/imgs/farinhada.jpg';
import tecelagem from '@/assets/imgs/tecelagem.jpg';
import piracaiaViolao from '@/assets/imgs/piracaia-violao.jpg';
import tucuxi from '@/assets/imgs/tucuxi.jpg';

/* FASE 6 (22/08/2026): "vídeo por atividade é onde o acervo é mais rico" —
   a própria prioridade do plano para esta página. Os cinco clipes da Fase 3
   (aprovados pelo Carlos, ColunaDeReels da Fase 4) cobrem uma atividade de
   cada grupo — água, mata, comunidades — e por isso ganham seção própria
   entre os três grupos e a folha de contato, em vez de entrar dentro de um
   grupo só. */
import reelCanoaIgapo from '@/assets/imgs/reel-canoa-igapo-poster.jpg';
import reelUrucum from '@/assets/imgs/reel-urucum-poster.jpg';
import reelMeliponario from '@/assets/imgs/reel-meliponario-poster.jpg';
import reelTecelagem from '@/assets/imgs/reel-tecelagem-poster.jpg';
import reelPiracaia from '@/assets/imgs/reel-piracaia-poster.jpg';

/* FASE 6b (22/08/2026): quatro clipes aprovados pelo Carlos além dos cinco da
   curadoria original — dois do acervo horizontal (oficina, corrigida de um
   giro de câmera de 90°; Lago Azul, cortada antes do trecho de selfie) e os
   dois Reels institucionais com legenda de capítulo queimada em PT/EN, que
   docs/video.md §3 deixava como exceção explícita a decidir com ele. Decisão
   dele: entram nas 5 páginas de idioma como bônus institucional, mesmo sem
   tradução do texto queimado. */
import reelOficina from '@/assets/imgs/reel-oficina-poster.jpg';
import reelLagoAzul from '@/assets/imgs/reel-lago-azul-poster.jpg';
import reelApresentacao from '@/assets/imgs/reel-apresentacao-poster.jpg';
import reelVivencias from '@/assets/imgs/reel-vivencias-poster.jpg';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);

const agua = useList(locale)<{ titulo: string; detalhe: string; medida?: string; marcado?: boolean }>('exp.aguaLista');
const mata = useList(locale)<{ titulo: string; detalhe: string; medida?: string }>('exp.mataLista');
const gente = useList(locale)<{ titulo: string; detalhe: string; medida?: string; marcado?: boolean }>('exp.genteLista');

const POSTERS_VIDEO: Record<string, ImageMetadata> = {
  canoaIgapo: reelCanoaIgapo,
  urucum: reelUrucum,
  meliponario: reelMeliponario,
  tecelagem: reelTecelagem,
  piracaia: reelPiracaia,
  oficina: reelOficina,
  lagoAzul: reelLagoAzul,
  apresentacao: reelApresentacao,
  vivencias: reelVivencias,
};
/* camelCase → kebab-case: nomes de arquivo em public/video/reels/ seguem o
   padrão reel-<kebab-do-id>.mp4 (ex.: lagoAzul → reel-lago-azul.mp4). */
const paraCasoDeArquivo = (id: string) => id.replace(/([A-Z])/g, '-$1').toLowerCase();
const videoItens = useList(locale)<{ id: string; legenda: string; alt: string }>('exp.videoItens')
  .map((item) => ({ legenda: item.legenda, alt: item.alt, video: `/video/reels/reel-${paraCasoDeArquivo(item.id)}.mp4`, poster: POSTERS_VIDEO[item.id] }));

/* A folha de contato do fim. Quatro fotos que não couberam nos grupos e que
   fecham a página pelo que ela promete: o equipamento, a noite, a mata e a
   água. Cada `alt` foi escrito olhando a foto. Legenda e alt vêm de
   `exp.contato` (src/i18n/*.json), casados por `id`. */
const TEXTOS_CONTATO = useList(locale)<{ id: string; legenda: string; alt: string }>('exp.contato');
const contatoTexto = (id: string) => TEXTOS_CONTATO.find((c) => c.id === id)!;
const CONTATO = [
  { foto: caiaques, ...contatoTexto('caiaques') },
  { foto: piracaiaViolao, ...contatoTexto('piracaiaViolao') },
  { foto: igarape, ...contatoTexto('igarape') },
  { foto: luauPraia, ...contatoTexto('luauPraia') },
] as const;
---

<AberturaPagina titulo={t('exp.h1')} intro={t('exp.intro')} />

<!-- campo reservado: a paisagem que dá nome à página, sem tipo em cima -->
<figure class="container-editorial">
  <Image
    src={igapoCanoa}
    alt={t('exp.figIgapoAlt')}
    widths={[800, 1200, 1800, 2400]}
    sizes="(min-width: 1280px) 76rem, 100vw"
    loading="eager"
    fetchpriority="high"
    class="aspect-[16/9] w-full object-cover"
  />
  <figcaption class="meta numero mt-3">Igapó · a mata com o pé na água</figcaption>
</figure>

<!-- ═══════════ NA ÁGUA ═══════════ -->
<section class="secao">
  <div class="container-editorial">
    <h2 class="font-display text-titulo">{t('exp.agua')}</h2>

    <div class="mt-8 grid gap-10 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)] lg:gap-16">
      <ListaCorte itens={agua} />

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-1">
        <figure>
          <Image
            src={aguaTransparente}
            alt={t('exp.figAguaTransparenteAlt')}
            widths={[480, 800, 1200]}
            sizes="(min-width: 1024px) 34vw, (min-width: 640px) 45vw, 100vw"
            loading="lazy"
            decoding="async"
            class="aspect-[4/3] w-full object-cover"
          />
          <figcaption class="meta numero mt-3">{t('exp.figAguaTransparente')}</figcaption>
        </figure>
        <figure>
          <Image
            src={tucuxi}
            alt={t('exp.figTucuxiAlt')}
            widths={[480, 800, 1200]}
            sizes="(min-width: 1024px) 34vw, (min-width: 640px) 45vw, 100vw"
            loading="lazy"
            decoding="async"
            class="aspect-[4/3] w-full object-cover"
          />
          {/* A única foto do site que não foi feita na Villa. A legenda diz a
              espécie e não sugere o lugar — o acervo não tem foto de boto, e
              inventar procedência seria mentir na legenda. */}
          <figcaption class="meta numero mt-3">{t('exp.figTucuxi')} · <i>Sotalia fluviatilis</i></figcaption>
        </figure>
      </div>
    </div>
  </div>
</section>

<!-- ═══════════ AS DUAS ESTAÇÕES ═══════════
     Seção nova, e o maior ganho de venda da rodada. O visitante lê "janeiro a
     julho: chuva" como defeito e desiste da data. Dito como paisagem — a mata
     alagada por onde a canoa passa entre as copas — deixa de ser defeito e
     passa a ser a coisa que só existe naquele semestre.

     Duas folhas de veio oposto encontrando-se numa emenda, como as duas
     modalidades da home: não são dois cards, é uma junta que divide. -->
<section class="cunha-topo secao bg-areia">
  <div class="container-editorial">
    <h2 class="font-display text-titulo">{t('exp.estacoesT')}</h2>
    <p class="lead container-texto mt-4 sm:mx-0">{t('exp.estacoesI')}</p>

    <div class="emenda mt-12 grid gap-12 border-t pt-10 md:grid-cols-2 md:gap-0">
      <div class="md:pr-10 lg:pr-16">
        <figure>
          <Image
            src={igapoTroncos}
            alt={t('exp.figIgapoTroncosAlt')}
            widths={[480, 800, 1200]}
            sizes="(min-width: 768px) 45vw, 100vw"
            loading="lazy"
            decoding="async"
            class="aspect-[3/2] w-full object-cover"
          />
        </figure>
        <h3 class="font-display text-secao mt-6">{t('exp.cheiaT')}</h3>
        <p class="numero etiqueta mt-1">{t('exp.cheiaQuando')}</p>
        <p class="mt-4">{t('exp.cheiaD')}</p>
      </div>

      <div class="emenda md:border-l md:pl-10 lg:pl-16">
        <figure>
          <Image
            src={bancoAreia}
            alt={t('exp.figBancoAreiaAlt')}
            widths={[480, 800, 1200]}
            sizes="(min-width: 768px) 45vw, 100vw"
            loading="lazy"
            decoding="async"
            class="aspect-[3/2] w-full object-cover"
          />
        </figure>
        <h3 class="font-display text-secao mt-6">{t('exp.secaT')}</h3>
        <p class="numero etiqueta mt-1">{t('exp.secaQuando')}</p>
        <p class="mt-4">{t('exp.secaD')}</p>
      </div>
    </div>

    <p class="mt-10 flex items-start gap-2.5">
      <Voluta class="mt-1.5 text-areia-sol" />
      <span>{t('exp.estacoesNota')}</span>
    </p>
  </div>
</section>

<!-- ═══════════ NA MATA ═══════════ -->
<section class="secao">
  <div class="container-editorial">
    <h2 class="font-display text-titulo">{t('exp.mata')}</h2>

    <div class="mt-8 grid gap-10 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] lg:gap-16">
      <div class="order-2 lg:order-1 grid gap-6 sm:grid-cols-2 lg:grid-cols-1">
        <figure>
          <Image
            src={samauma}
            alt={t('exp.figSamaumaAlt')}
            widths={[480, 800, 1200]}
            sizes="(min-width: 1024px) 34vw, (min-width: 640px) 45vw, 100vw"
            loading="lazy"
            decoding="async"
            class="aspect-[4/3] w-full object-cover"
          />
          <figcaption class="meta numero mt-3">{t('exp.figSamauma')}</figcaption>
        </figure>
        <figure>
          <Image
            src={massagem}
            alt={t('exp.figMassagemAlt')}
            widths={[480, 800, 1200]}
            sizes="(min-width: 1024px) 34vw, (min-width: 640px) 45vw, 100vw"
            loading="lazy"
            decoding="async"
            class="aspect-[4/3] w-full object-cover"
          />
          <figcaption class="meta numero mt-3">{t('exp.figMassagem')}</figcaption>
        </figure>
      </div>

      <div class="order-1 lg:order-2">
        <ListaCorte itens={mata} />
        <figure class="mt-10">
          <Image
            src={trilhaGrupo}
            alt={t('exp.figTrilhaAlt')}
            widths={[640, 960, 1400]}
            sizes="(min-width: 1024px) 46vw, 100vw"
            loading="lazy"
            decoding="async"
            class="aspect-[3/2] w-full object-cover"
          />
          <figcaption class="meta numero mt-3">{t('exp.figTrilha')}</figcaption>
        </figure>
      </div>
    </div>
  </div>
</section>

<!-- ═══════════ COM AS COMUNIDADES ═══════════ -->
<section class="cunha-topo secao bg-mar sobre-escuro">
  <div class="container-editorial">
    <h2 class="font-display text-titulo">{t('exp.gente')}</h2>

    <div class="mt-8 grid gap-10 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)] lg:gap-16">
      <ListaCorte itens={gente} />

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-1">
        <figure>
          <Image
            src={farinhada}
            alt={t('exp.figFarinhadaAlt')}
            widths={[480, 800, 1200]}
            sizes="(min-width: 1024px) 34vw, (min-width: 640px) 45vw, 100vw"
            loading="lazy"
            decoding="async"
            class="aspect-[4/3] w-full object-cover"
          />
          <figcaption class="meta numero mt-3">{t('exp.figFarinhada')}</figcaption>
        </figure>
        <figure>
          <Image
            src={tecelagem}
            alt={t('exp.figTecelagemAlt')}
            widths={[480, 800, 1200]}
            sizes="(min-width: 1024px) 34vw, (min-width: 640px) 45vw, 100vw"
            loading="lazy"
            decoding="async"
            class="aspect-[4/3] w-full object-cover"
          />
          <figcaption class="meta numero mt-3">{t('exp.figTecelagem')}</figcaption>
        </figure>
      </div>
    </div>

    <p class="numero etiqueta mt-12">{t('exp.nota')}</p>
  </div>
</section>

<!-- ═══════════ EM VÍDEO ═══════════
     "Vídeo por atividade é onde o acervo é mais rico" — a prioridade do
     plano para esta página. Uma atividade de cada grupo acima (água, mata,
     comunidades), na coluna que rola (Fase 4), não dentro do grid de fotos
     de nenhum grupo — são cinco clipes e caberiam mal espremidos a dois por
     grupo. -->
<section class="secao">
  <div class="container-editorial">
    <h2 class="font-display text-titulo">{t('exp.videoT')}</h2>
    <div class="mt-8">
      <ColunaDeReels rotulo={t('exp.videoT')} itens={videoItens} />
    </div>
  </div>
</section>

<!-- ═══════════ A FOLHA DE CONTATO ═══════════ -->
<section class="secao">
  <div class="container-editorial">
    <figure>
      <Image
        src={porDoSolGrupo}
        alt={t('exp.figPorSolAlt')}
        widths={[600, 900, 1290]}
        sizes="(min-width: 1280px) 76rem, 100vw"
        loading="lazy"
        decoding="async"
        class="aspect-[16/9] w-full object-cover"
      />
      <figcaption class="meta numero mt-3">{t('exp.figPorSol')}</figcaption>
    </figure>

    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {CONTATO.map((f) => (
        <figure>
          <Image
            src={f.foto}
            alt={f.alt}
            widths={[400, 600, 900]}
            sizes="(min-width: 1024px) 22vw, (min-width: 640px) 45vw, 100vw"
            loading="lazy"
            decoding="async"
            class="aspect-[4/3] w-full object-cover"
          />
          <figcaption class="meta numero mt-3">{f.legenda}</figcaption>
        </figure>
      ))}
    </div>

    <p class="mt-12">
      <a href={href(locale, 'packages')} class="link-texto etiqueta">{t('exp.linkPacotes')}</a>
    </p>
  </div>
</section>
