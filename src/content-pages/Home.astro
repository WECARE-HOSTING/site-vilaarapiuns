  />
  <div class="absolute inset-0 flex items-end bg-gradient-to-t from-mata-funda via-mata-funda/70 to-mata-funda/20">
    <div class="container-editorial pb-12 sm:pb-16">
      <blockquote class="font-display container-texto text-secao text-creme sm:mx-0">
        “{t('home.fechaQ')}”
      </blockquote>
      <Campo class="mt-4">
        {t('home.fechaA')}
        <Voluta class="text-ouro" />
        {t('home.fechaH')}
      </Campo>

      <hr class="emenda mt-10 border-t" />
      <div class="mt-8 flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <h2 class="font-display text-titulo">{t('home.fechaT')}</h2>
          <p class="container-texto mt-3">{t('home.fechaD')}</p>
        </div>
        <a href={whatsappUrl(t('whatsapp.geral'))} class="btn btn-primario shrink-0">{t('cta.whatsapp')}</a>
      </div>
    </div>
  </div>
</section>
