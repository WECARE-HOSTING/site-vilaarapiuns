<section class="relative">
  <Image
    src={gal3}
    alt="Varanda de uma bangalô à noite, com rede e luminária de fibra acesa"
    widths={[900, 1400, 1920]}
    sizes="100vw"
    loading="lazy"
    decoding="async"
    class="h-[65svh] min-h-80 w-full object-cover"
  />
