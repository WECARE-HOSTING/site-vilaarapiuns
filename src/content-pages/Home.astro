          <h2 class="font-display text-titulo">{t('home.fechaT')}</h2>
          <p class="container-texto mt-3">{t('home.fechaD')}</p>
        </div>
        <a href={whatsappUrl(t('whatsapp.geral'))} class="btn btn-primario shrink-0" target="_blank" rel="noopener noreferrer">{t('cta.whatsapp')}</a>
      </div>
    </div>
  </div>
