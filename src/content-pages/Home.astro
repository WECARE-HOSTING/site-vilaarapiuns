<LeiturasDoDiario locale={locale} grupos={['retreat-venue', 'corporate-venue', 'melhor-epoca', 'tbc']} />

<style>
  /* Gancho do hero: todas as frases na mesma célula, a da foto atual visível.
     A célula tem a altura da frase mais alta, então o texto de baixo não pula
     na troca; `align-items: end` mantém cada frase encostada no subtítulo. */
  .gancho-hero { align-items: end; }
  .gancho-hero__frase {
    grid-area: 1 / 1;
    margin: 0;
    opacity: 0;
    transition: opacity 0.9s ease;
  }
  .gancho-hero__frase.esta { opacity: 1; }
  @media (prefers-reduced-motion: reduce) {
    .gancho-hero__frase { transition: none; }
  }
</style>

<script>
  /* Sincroniza o gancho com a foto. O FundoPaisagem dispara `paisagem:troca`
     com o índice da foto que entrou; se não houver frase para esse índice
     (idiomas sem rodízio), o h1 fica. */
  document.querySelectorAll<HTMLElement>('[data-gancho-hero]').forEach((gancho) => {
    const frases = gancho.querySelectorAll<HTMLElement>('[data-gancho-i]');
    if (frases.length < 2) return;
    const palco = gancho.closest('[data-palco-foto]');
    palco?.addEventListener('paisagem:troca', (e) => {
      const i = (e as CustomEvent<number>).detail;
      const alvo = gancho.querySelector<HTMLElement>(`[data-gancho-i="${i}"]`) ?? frases[0];
      frases.forEach((f) => f.classList.toggle('esta', f === alvo));
    });
  });
</script>
