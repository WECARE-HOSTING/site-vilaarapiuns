<!-- ══════════════════════ UM DIA NA VILLA ══════════════════════ -->
<section class="secao bg-mar sobre-escuro">
  <div class="container-editorial">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,0.78fr)_minmax(0,1.22fr)] lg:gap-20">
      <div>
        <h2 class="font-display text-titulo">{t('home.diaT')}</h2>
        <p class="lead mt-4">{t('home.diaI')}</p>
      </div>
      <LinhaDoDia
        momentos={momentos}
        rotulos={{ incluso: t('dia.incluso'), comunidade: t('dia.comunidade') }}
        tone="escuro"
      />
    </div>
  </div>
</section>

<!-- ═════════════ DUAS MANEIRAS DE FICAR ═════════════
     A estrutura central do produto, que o site não expressava. Duas folhas de
     veio oposto encontrando-se numa emenda — não dois cards: sem raio, sem
     sombra, a junta é que divide. O preço mora DENTRO da modalidade, porque
     preço sem modalidade não informa: na pousada o barco não está incluso.

     Os pisos vêm de src/data/site.ts e cada um carrega a sua condição. "A
     partir de" sem a condição ao lado seria meia-verdade. -->
<section class="cunha-topo secao">
  <div class="container-editorial">
    <h2 class="font-display text-titulo">{t('modo.titulo')}</h2>
    <p class="lead container-texto mt-4 sm:mx-0">{t('modo.intro')}</p>

    <div class="emenda mt-12 grid gap-10 border-t pt-10 md:grid-cols-2 md:gap-0">
      {[
        { t: t('modo.pousadaT'), d: t('modo.pousadaD'), inc: t('modo.pousadaInc'), fora: t('modo.pousadaFora'),
          v: SITE.prices.pousadaMin, cond: t('modo.condPousada'), un: t('modo.porPax'), cta: 'lodge' as const },
        { t: t('modo.pacoteT'), d: t('modo.pacoteD'), inc: t('modo.pacoteInc'), fora: t('modo.pacoteFora'),
          v: SITE.prices.pacoteMin, cond: t('modo.condPacote'), un: t('modo.porPacote'), cta: 'packages' as const },
      ].map((m, i) => (
        <div class:list={['flex flex-col', i === 1 ? 'emenda md:border-l md:pl-10 lg:pl-16' : 'md:pr-10 lg:pr-16']}>
          <h3 class="font-display text-secao">{m.t}</h3>
          <p class="mt-3">{m.d}</p>

          <dl class="mt-6 grid grid-cols-[auto_1fr] gap-x-4 gap-y-2">
            <dt class="etiqueta pt-1">{t('modo.inclusoRot')}</dt>
            <dd class="flex items-start gap-2">
              <Voluta class="mt-1.5 text-areia-sol" />
              <span>{m.inc}</span>
            </dd>
            <dt class="etiqueta pt-1">{t('modo.foraRot')}</dt>
            <dd>{m.fora}</dd>
          </dl>

          <p class="emenda mt-auto border-t pt-6">
            <span class="etiqueta block">{t('modo.aPartirDe')}</span>
            <span class="numero cor-titulo mt-1 block text-titulo">
              {preco(m.v, locale)}
            </span>
            <span class="numero etiqueta mt-1 block">{m.un} · {m.cond}</span>
          </p>

          <a href={href(locale, m.cta)} class="btn btn-secundario mt-6 self-start">{t('cta.learnMore')}</a>
        </div>
      ))}
    </div>

    <p class="numero etiqueta mt-10">{t('home.precoD')}</p>
  </div>
</section>

<!-- ══════════════════ A TRAVESSIA: lista de corte ══════════════════
     A informação mais densa da página, e a que resolve a maior ansiedade do
     produto. Foi desenhada como cunha creme; o cliente aprovou o verde e o
     fundo ficou. O texto usa `madeira-luz`, o marrom claro do impresso.

     Movida para o FECHO da página em 22/08/2026, a pedido do Carlos — antes
     vinha logo após a faixa de garantias. A ordem e o conteúdo internos
     (etapas, mapa, vídeo da Villa de Cima) não mudaram, só a posição. -->
<section class="cunha-topo secao">
  <div class="container-editorial">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:gap-16">
      <div>
        <h2 class="font-display text-titulo">{t('home.travessiaT')}</h2>
        <p class="lead mt-4">{t('home.travessiaI')}</p>
      </div>

      <ol>
        {travessia.map((e) => (
          <li class="grid grid-cols-[2.5rem_1fr] gap-x-4 border-t emenda py-5 first:border-t-0 first:pt-0 sm:grid-cols-[3rem_1fr_auto] sm:gap-x-6">
            <span class="numero etiqueta pt-1">{e.n}</span>
            <div>
              <h3 class="font-display text-secao">{e.titulo}</h3>
              <p class="mt-1">{e.detalhe}</p>
            </div>
            <p class="numero etiqueta col-start-2 mt-2 flex items-center gap-2 sm:col-start-3 sm:mt-1 sm:justify-end sm:text-right">
              {e.incluso && <Voluta class="text-areia-sol" />}
              {e.medida}
            </p>
          </li>
        ))}
      </ol>
    </div>

    <!-- O mapa fecha a travessia: as três etapas dizem a ordem, o mapa diz o
         lugar onde elas acontecem. Em largura cheia do container, e não dentro
         da cunha estreita da esquerda, porque a 400px os rótulos do mapa ficam
         ilegíveis — mapa ilegível é decoração, e decoração aqui é mentira. -->
    <MapaSituacao locale={locale} class="mt-16" />

    <!-- ─── A VILLA DE CIMA ───
         Embutido de veio oposto: o quadro escuro assentado no painel claro. O
         chão `mar-fundo` não é moldura decorativa — é a mesa de cinema, e é o
         que faz a copa verde do clipe aparecer em cor cheia em vez de disputar
         luz com a areia. A régua da legenda é a MESMA do mapa logo acima
         (informação à esquerda, comando à direita), e por isso o bloco inteiro
         se lê como um aparelho, não como mais uma foto da página.

         Disciplina 3 de pé, e à letra: NADA entra em cima do quadro, nem a
         barra do navegador. O `<video>` nasce SEM `controls` — com o atributo
         no HTML, Chrome e Safari desenham a barra por cima do cartaz desde o
         primeiro paint, e o que se vê é um degradê preto e um 0:00 sobre a
         fotografia. O `controls` entra por script no primeiro play, quando já
         não há cartaz a proteger. Enquanto isso o comando visível mora na
         régua, embaixo, igual ao "ampliar o mapa".

         E ele é <a>, não <button>: sem JavaScript o clique navega para o
         arquivo e o navegador toca o mp4 na aba — o mesmo alvo serve os dois
         mundos, sem estado escondido e sem <noscript>. O alvo grande sobre o
         cartaz é irmão da imagem, `aria-hidden` e fora da ordem de tabulação,
         para não duplicar o nome acessível do comando de verdade. -->
    <figure class="sobre-escuro mt-16 bg-mar-fundo p-3 sm:p-4" data-video-contexto>
      <div class="relative">
        <video
          src={VISTA_VIDEO}
          poster={vistaCartaz.src}
          preload="none"
          playsinline
          muted
          aria-label={t('home.vistaDesc')}
          class="aspect-video w-full bg-mar-fundo"
        ></video>

        <button
          type="button"
          data-video-abrir
          data-video-src={VISTA_VIDEO}
          data-video-poster={vistaCartaz.src}
          data-video-legenda={t('home.vistaDesc')}
          tabindex="-1"
          aria-hidden="true"
          class="absolute inset-0 cursor-pointer"
        ></button>
      </div>

      <figcaption class="emenda mt-3 flex flex-wrap items-center justify-between gap-x-6 gap-y-3 border-t pt-3 sm:mt-4 sm:pt-4">
        <p class="numero etiqueta flex flex-wrap items-center gap-x-3 gap-y-1">
          {t('home.vistaLegenda')}
          <Voluta class="text-sol" />
          {vistaMedida}
        </p>

        <a
          href={VISTA_VIDEO}
          data-video-abrir
          data-video-src={VISTA_VIDEO}
          data-video-poster={vistaCartaz.src}
          data-video-legenda={t('home.vistaDesc')}
          class="etiqueta emenda flex items-center gap-2 border px-3 py-2 transition-colors hover:bg-sol hover:text-mar-fundo"
        >
          <!-- O octógono da marchetaria com o glifo de play dentro: a forma
               reservada do sistema, no único lugar da página onde ela vira
               comando. Não é ícone de biblioteca. -->
          <svg viewBox="0 0 16 16" fill="none" aria-hidden="true" class="h-3.5 w-3.5 shrink-0">
            <path d="M5.2 1h5.6L15 5.2v5.6L10.8 15H5.2L1 10.8V5.2L5.2 1z"
                  stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" />
            <path d="M6.7 5.3 11 8l-4.3 2.7V5.3z" fill="currentColor" />
          </svg>
          {t('home.vistaControle')}
        </a>
      </figcaption>
    </figure>

    <a href={href(locale, 'gettingHere')} class="link-texto etiqueta mt-8 inline-block">
      {t('nav.gettingHere')}
    </a>
  </div>
</section>
