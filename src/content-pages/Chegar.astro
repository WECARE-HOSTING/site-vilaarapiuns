---
/**
 * COMO CHEGAR — a página que decide a reserva.
 *
 * "Tranquilizar é o produto" é o primeiro princípio em PRODUCT.md, e a maior
 * ansiedade deste negócio é logística: voar até Santarém, achar a lancha,
 * subir 1h30 de rio. Então esta página é DENSA: lista medida e dúvidas reais.
 *
 * Sem foto grande de propósito: aqui o visitante quer resposta, não atmosfera.
 * E nenhuma etapa afirma tempo que não está confirmado: o trecho Santarém–Alter
 * do Chão não tem duração declarada em documento nenhum.
 *
 * O MAPA é a exceção à regra de "sem imagem grande", e é exceção porque não é
 * atmosfera: é a resposta à primeira pergunta de quem vai para a Amazônia —
 * onde isso fica. Vem ANTES da lista de etapas de propósito: a lista dá a
 * sequência, o mapa dá o lugar, e ninguém entende uma sequência de três baldeações
 * sem antes ter o lugar na cabeça.
 */
import { Image } from 'astro:assets';
import AberturaPagina from '@/components/AberturaPagina.astro';
import MapaSituacao from '@/components/MapaSituacao.astro';
import ListaCorte from '@/components/ListaCorte.astro';
import chegadaBarco from '@/assets/imgs/chegada-barco.jpg';
import embarquePassarela from '@/assets/imgs/embarque-passarela.jpg';
import embarqueGrupo from '@/assets/imgs/embarque-grupo.jpg';
import embarqueColete from '@/assets/imgs/embarque-colete.jpg';
import { href } from '@/i18n/routes';
import { useTranslations, useList } from '@/i18n/utils';
import { SITE, whatsappUrl } from '@/data/site';
import type { Locale } from '@/i18n/config';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);

const etapas = [
  { n: '01', titulo: t('home.etapa1T'), detalhe: t('home.etapa1D'), medida: 'Santarém · PA' },
  { n: '02', titulo: t('home.etapa2T'), detalhe: t('home.etapa2D'), medida: 'Alter do Chão' },
  { n: '03', titulo: t('home.etapa3T'), detalhe: t('home.etapa3D'), medida: `${SITE.location.boatMinutes} min de lancha`, marcado: true },
];

/* FASE 6 (22/08/2026): a travessia inteira, não só o fim da etapa 03 — o
   plano nomeia esta página como segunda prioridade porque a maior ansiedade
   é o trajeto, e a página só respondia com texto. Três fotos reais da
   sequência de embarque em Alter do Chão (3 Acervo/Água/Embarque), estática
   e em grade — sem carrossel, porque a página "quer resposta, não
   atmosfera" (comentário original desta página) e três fotos cabem juntas
   sem precisar de interação nenhuma. */
const EMBARQUE_FOTOS: Record<string, ImageMetadata> = {
  passarela: embarquePassarela,
  grupo: embarqueGrupo,
  colete: embarqueColete,
};
const embarque = useList(locale)<{ id: string; legenda: string; alt: string }>('chegar.embarqueItens')
  .map((item) => ({ ...item, foto: EMBARQUE_FOTOS[item.id] }));

const duvidas = [
  { titulo: t('chegar.q1'), detalhe: t('chegar.a1') },
  { titulo: t('chegar.q2'), detalhe: t('chegar.a2') },
  { titulo: t('chegar.q3'), detalhe: t('chegar.a3') },
  { titulo: t('chegar.q4'), detalhe: t('chegar.a4') },
  { titulo: t('chegar.q5'), detalhe: t('chegar.a5') },
];
---

<AberturaPagina titulo={t('chegar.h1')} intro={t('chegar.intro')} />

<section class="pb-14">
  <div class="container-editorial">
    <h2 class="font-display text-titulo">{t('mapa.ondeT')}</h2>
    <p class="text-intro container-texto mt-4 sm:mx-0">{t('mapa.ondeI')}</p>
    <MapaSituacao locale={locale} class="mt-10" />
  </div>
</section>

<section class="pb-20">
  <div class="container-editorial">
    <h2 class="font-display text-titulo">{t('home.travessiaT')}</h2>
    <ListaCorte itens={etapas} nivel="h3" class="mt-8" />

    {/* FASE 6: a regra "uma foto só" era certa quando a única pergunta em
        aberto era como termina a etapa 03. O plano do redesign nomeou esta
        página como segunda prioridade justamente porque a travessia
        completa não tinha prova nenhuma — só a chegada. As três fotos
        abaixo respondem a etapa 02→03 (embarque em Alter do Chão); a foto
        que já existia continua sozinha depois, respondendo o fim da 03
        (chegada na Villa). Grade estática, sem carrossel: três fotos cabem
        juntas sem pedir interação, e a página continua "resposta, não
        atmosfera". */}
    <div class="mt-12 grid gap-4 sm:grid-cols-3">
      {embarque.map((e) => (
        <figure>
          <Image
            src={e.foto}
            alt={e.alt}
            widths={[420, 600, 860]}
            sizes="(min-width: 640px) 33vw, 100vw"
            loading="lazy"
            decoding="async"
            class="aspect-[4/3] w-full object-cover"
          />
          <figcaption class="meta numero mt-2">{e.legenda}</figcaption>
        </figure>
      ))}
    </div>

    <figure class="mt-8">
      <Image
        src={chegadaBarco}
        alt="Pessoas desembarcando de um barco na água rasa junto à areia, com bagagem na mão"
        widths={[600, 900, 1289]}
        sizes="(min-width: 1280px) 76rem, 100vw"
        loading="lazy"
        decoding="async"
        class="aspect-[21/9] w-full object-cover"
      />
      <figcaption class="meta numero mt-3">{t('chegar.figFimEtapa3')}</figcaption>
    </figure>

    <h2 class="font-display text-titulo mt-16">{t('chegar.duvT')}</h2>
    <ListaCorte itens={duvidas} class="mt-8" />

    <div class="emenda mt-14 border-t pt-8">
      <p class="container-texto sm:mx-0">
        {t('chegar.duvFinal')}
      </p>
      <p class="mt-6 flex flex-wrap gap-3">
        <a href={whatsappUrl(t('whatsapp.geral'))} class="btn btn-primario" target="_blank" rel="noopener noreferrer">{t('cta.whatsapp')}</a>
        <a href={href(locale, 'packages')} class="btn btn-secundario">{t('chegar.ctaVerPacotes')}</a>
      </p>
    </div>
  </div>
</section>
