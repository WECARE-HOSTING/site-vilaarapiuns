---
/**
 * Placeholder temporário (Fase 0). Existe para provar que o roteamento,
 * o i18n e os slugs por idioma funcionam antes de desenharmos qualquer tela.
 * É substituído página a página nas Fases 2 a 5.
 */
import { LOCALES, LOCALE_NAMES, type Locale } from '@/i18n/config';
import { NAV_KEYS, PAGE_KEYS, href, type PageKey } from '@/i18n/routes';
import { useTranslations } from '@/i18n/utils';
import { SITE } from '@/data/site';

interface Props { locale: Locale; pageKey: PageKey }
const { locale, pageKey } = Astro.props;
const t = useTranslations(locale);

const FASE: Record<PageKey, string> = {
  home: 'Fase 2', lodge: 'Fase 3', dining: 'Fase 3',
  experiences: 'Fase 4', packages: 'Fase 4', gettingHere: 'Fase 4',
  gallery: 'Fase 5', reviews: 'Fase 5', privateVilla: 'Fase 5', book: 'Fase 5',
};
---

<div class="container-editorial py-16">
  <p class="olho text-areia">{SITE.name} · Fase 0 — estrutura</p>

  <h1 class="font-display text-titulo text-verde mt-3">
    {pageKey === 'home' ? t('site.name') : t(`nav.${pageKey}`)}
  </h1>

  <p class="text-cinza mt-2">
    <code class="bg-areia-fundo px-2 py-1 text-sm">{href(locale, pageKey)}</code>
    <span class="ml-2">— conteúdo entra na <strong class="text-verde">{FASE[pageKey]}</strong></span>
  </p>

  <hr class="my-10 border-areia-claro" />

  <div class="grid gap-10 md:grid-cols-2">
    <section>
      <h2 class="olho text-cinza mb-4">Páginas ({PAGE_KEYS.length})</h2>
      <ul class="space-y-1">
        {PAGE_KEYS.map((k) => (
          <li>
            <a
              href={href(locale, k)}
              class:list={[
                'underline underline-offset-4 decoration-areia hover:text-verde-claro',
                k === pageKey ? 'text-verde font-medium' : 'text-escuro',
              ]}
            >
              {k === 'home' ? t('site.name') : t(`nav.${k}`)}
            </a>
            {NAV_KEYS.includes(k) && <span class="olho text-areia ml-2">menu</span>}
          </li>
        ))}
      </ul>
    </section>

    <section>
      <h2 class="olho text-cinza mb-4">Esta página nos {LOCALES.length} idiomas</h2>
      <ul class="space-y-1">
        {LOCALES.map((l) => (
          <li>
            <a
              href={href(l, pageKey)}
              hreflang={l}
              class:list={[
                'underline underline-offset-4 decoration-areia hover:text-verde-claro',
                l === locale ? 'text-verde font-medium' : 'text-escuro',
              ]}
            >
              {LOCALE_NAMES[l]}
            </a>
            <code class="text-cinza-claro text-sm ml-2">{href(l, pageKey)}</code>
          </li>
        ))}
      </ul>
      <p class="text-sm text-cinza mt-4 max-w-prose">
        Todos caem em português de propósito: enquanto estivermos construindo,
        o fallback é o PT. Na Fase 6 cada idioma passa a usar o seu dicionário.
      </p>
    </section>
  </div>

  <div class="mt-12 border-t border-areia-claro pt-6">
    <h2 class="olho text-cinza mb-3">Garantias que o site vai repetir em toda página</h2>
    <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-verde">
      <li>{t('trust.fullBoard')}</li>
      <li>{t('trust.boat')}</li>
      <li>{t('trust.team')}</li>
      <li>{t('trust.host')}</li>
      <li>{t('trust.years')}</li>
    </ul>
  </div>
</div>
