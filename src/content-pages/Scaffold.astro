---
/**
 * Placeholder temporário (Fase 0). Existe para provar que o roteamento,
 * o i18n e os slugs por idioma funcionam antes de desenharmos qualquer tela.
 * É substituído página a página nas Fases 2 a 5.
 */
import { LOCALES, LOCALE_NAMES, type Locale } from '@/i18n/config';
import { NAV_KEYS, PAGE_KEYS, href, type PageKey } from '@/i18n/routes';
import { useTranslations } from '@/i18n/utils';
import { SITE } from '@/data/site';

interface Props { locale: Locale; pageKey: PageKey }
const { locale, pageKey } = Astro.props;
const t = useTranslations(locale);

const FASE: Record<PageKey, string> = {
  home: 'Fase 2', lodge: 'Fase 3', dining: 'Fase 3',
  experiences: 'Fase 4', packages: 'Fase 4', gettingHere: 'Fase 4',
  gallery: 'Fase 5', reviews: 'Fase 5', privateVilla: 'Fase 5', book: 'Fase 5', bookSent: 'Fase 5',
};
---

<div class="container-editorial py-16">
  <p class="etiqueta">{SITE.name} · Fase 0 — estrutura</p>

  <h1 class="font-display text-titulo mt-3">
    {pageKey === 'home' ? t('site.name') : t(`nav.${pageKey}`)}
  </h1>

  <p class="mt-2">
    <code class="emenda border bg-areia px-2 py-1 text-sm">{href(locale, pageKey)}</code>
    <span class="ml-2">— conteúdo entra na <strong class="cor-titulo">{FASE[pageKey]}</strong></span>
  </p>

  <hr class="my-10 emenda" />

  <div class="grid gap-10 md:grid-cols-2">
    <section>
      <h2 class="etiqueta mb-4">Páginas ({PAGE_KEYS.length})</h2>
      <ul class="space-y-1">
        {PAGE_KEYS.map((k) => (
          <li>
            <a
              href={href(locale, k)}
              class:list={[
                'underline underline-offset-4 decoration-areia-funda/70 hover:text-ceu',
                k === pageKey ? 'text-ceu font-medium' : '',
              ]}
            >
              {k === 'home' ? t('site.name') : t(`nav.${k}`)}
            </a>
            {NAV_KEYS.includes(k) && <span class="etiqueta ml-2">menu</span>}
          </li>
        ))}
      </ul>
    </section>

    <section>
      <h2 class="etiqueta mb-4">Esta página nos {LOCALES.length} idiomas</h2>
      <ul class="space-y-1">
        {LOCALES.map((l) => (
          <li>
            <a
              href={href(l, pageKey)}
              hreflang={l}
              class:list={[
                'underline underline-offset-4 decoration-areia-funda/70 hover:text-ceu',
                l === locale ? 'text-ceu font-medium' : '',
              ]}
            >
              {LOCALE_NAMES[l]}
            </a>
            <code class="meta ml-2">{href(l, pageKey)}</code>
          </li>
        ))}
      </ul>
      <p class="meta mt-4 max-w-prose">
        Todos caem em português de propósito: enquanto estivermos construindo,
        o fallback é o PT. Na Fase 6 cada idioma passa a usar o seu dicionário.
      </p>
    </section>
  </div>

</div>
