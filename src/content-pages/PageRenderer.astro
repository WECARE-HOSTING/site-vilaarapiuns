---
/**
 * Despacha cada chave de página para o seu componente.
 *
 * O Scaffold continua existindo como rede de segurança: se uma chave nova
 * entrar em routes.ts antes da página, o site ganha uma URL honesta em vez de
 * um link quebrado. Hoje nenhuma chave cai nele.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import FaixaGarantias from '@/components/FaixaGarantias.astro';
import Scaffold from '@/content-pages/Scaffold.astro';

import Home from '@/content-pages/Home.astro';
import Pousada from '@/content-pages/Pousada.astro';
import Mesa from '@/content-pages/Mesa.astro';
import Experiencias from '@/content-pages/Experiencias.astro';
import Pacotes from '@/content-pages/Pacotes.astro';
import Privativa from '@/content-pages/Privativa.astro';
import Reveillon from '@/content-pages/Reveillon.astro';
import Chegar from '@/content-pages/Chegar.astro';
import Galeria from '@/content-pages/Galeria.astro';
import Avaliacoes from '@/content-pages/Avaliacoes.astro';
import Reservar from '@/content-pages/Reservar.astro';
import Enviado from '@/content-pages/Enviado.astro';

import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { useTranslations } from '@/i18n/utils';
import { SITE } from '@/data/site';
import type { Locale } from '@/i18n/config';
import { NOINDEX_KEYS, type PageKey } from '@/i18n/routes';

import piracaiaRoda from '@/assets/imgs/piracaia-roda.jpg';
import bangaloPalafita from '@/assets/imgs/bangalo-palafita.jpg';
import jantarPeixe from '@/assets/imgs/jantar-peixe.jpg';
import igapoCanoaGrupo from '@/assets/imgs/igapo-canoa-grupo.jpg';
import samaumaGrupo from '@/assets/imgs/samauma-grupo.jpg';
import villaDeCima from '@/assets/imgs/villa-de-cima-poster.jpg';
import chegadaBarco from '@/assets/imgs/chegada-barco.jpg';
import gal1 from '@/assets/imgs/gal1.jpg';
import porsolGente from '@/assets/imgs/porsol-gente.jpg';
import embarqueGrupo from '@/assets/imgs/embarque-grupo.jpg';

interface Props {
  locale: Locale;
  pageKey: PageKey;
}

const { locale, pageKey } = Astro.props;
const t = useTranslations(locale);

const title =
  pageKey === 'home'
    ? `${SITE.name} — ${t('site.tagline')}`
    : `${t(`nav.${pageKey}`)} · ${SITE.name}`;

// Antes as 52 páginas construídas carregavam a MESMA description.
const description = t(`desc.${pageKey}`);

const PAGINAS = {
  lodge: Pousada,
  dining: Mesa,
  experiences: Experiencias,
  packages: Pacotes,
  privateVilla: Privativa,
  reveillon: Reveillon,
  gettingHere: Chegar,
  gallery: Galeria,
  reviews: Avaliacoes,
  book: Reservar,
  bookSent: Enviado,
} as const;

const Interna = PAGINAS[pageKey as keyof typeof PAGINAS];

/**
 * O CARTÃO DE LINK, POR PÁGINA.
 *
 * O preview do WhatsApp é o momento de aquisição real deste negócio: o link é
 * colado num grupo, e a foto é a página inteira reduzida a um retângulo. Até
 * aqui todas as páginas herdavam o mesmo `og.jpg` — o quarto —, que é o
 * posicionamento certo para a home e errado para uma página sazonal: um link
 * de réveillon que chega com foto de cama não fala do produto.
 *
 * Só a chave que tem foto própria entra no mapa; as demais continuam no
 * `og.jpg`, e é por isso que o tipo é `Partial`. Nada de foto genérica só para
 * preencher a linha. `home` fica de fora de propósito: o `og.jpg` padrão já É
 * a foto da home (o quarto), então dar a ela uma entrada aqui duplicaria a
 * mesma imagem por dois caminhos.
 */
const OG_PROPRIO: Partial<Record<PageKey, ImageMetadata>> = {
  reveillon: piracaiaRoda,
  lodge: bangaloPalafita,
  dining: jantarPeixe,
  experiences: igapoCanoaGrupo,
  packages: samaumaGrupo,
  privateVilla: villaDeCima,
  gettingHere: chegadaBarco,
  gallery: gal1,
  reviews: porsolGente,
  book: embarqueGrupo,
};

/* 1200×630 é a medida do cartão. A original tem 2048px e 712 kB, e alguns
   clientes desistem do preview em arquivo grande — então a imagem do cartão é
   derivada, não a original. `format: 'jpeg'` porque webp no preview de link
   ainda falha em parte dos clientes de mensagem. */
const ogDaPagina = OG_PROPRIO[pageKey]
  ? (await getImage({ src: OG_PROPRIO[pageKey]!, width: 1200, height: 630, fit: 'cover', format: 'jpeg', quality: 78 })).src
  : undefined;
---

<BaseLayout
  locale={locale}
  pageKey={pageKey}
  title={title}
  description={description}
  image={ogDaPagina}
  indexavel={!NOINDEX_KEYS.includes(pageKey)}
>
  <Header slot="header" locale={locale} pageKey={pageKey} />

  {pageKey === 'home' ? (
    <Home locale={locale} />
  ) : (
    <div class="pt-header">
      <FaixaGarantias locale={locale} />
      {Interna ? <Interna locale={locale} /> : <Scaffold locale={locale} pageKey={pageKey} />}
    </div>
  )}

  <Footer slot="footer" locale={locale} />
</BaseLayout>
