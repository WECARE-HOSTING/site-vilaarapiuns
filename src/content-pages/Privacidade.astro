---
import AberturaPagina from '@/components/AberturaPagina.astro';
import { useTranslations } from '@/i18n/utils';
import { SITE, telefoneLegivel, whatsappUrl } from '@/data/site';
import type { Locale } from '@/i18n/config';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
const secoes = ['controlador', 'base', 'reserva', 'pagamento', 'whatsapp', 'cookies', 'prazo', 'medicao', 'transferencia', 'direitos', 'contato'] as const;
---

<AberturaPagina titulo={t('privacidade.h1')} intro={t('privacidade.intro')} />

<section class="pb-24">
  <div class="container-editorial">
    <div class="prosa max-w-2xl">
      {secoes.map((s) => (
        <section id={`priv-${s}`}>
          <h2>{t(`privacidade.${s}T`)}</h2>
          <p>{t(`privacidade.${s}D`)}</p>
        </section>
      ))}
      <p>
        <a href={`mailto:${SITE.contact.email}`}>{SITE.contact.email}</a>
        {' · '}
        <a href={whatsappUrl(t('whatsapp.geral'))} target="_blank" rel="noopener noreferrer">{telefoneLegivel()}</a>
      </p>
    </div>
  </div>
</section>
