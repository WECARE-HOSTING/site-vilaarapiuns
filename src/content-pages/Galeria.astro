---
/**
 * GALERIA — modo Experience: a obra lidera, a interface recua.
 *
 * Grade de cunhas de altura desigual, como folhas de veio cortadas em larguras
 * diferentes num painel. Sem lightbox: um lightbox exigiria JavaScript numa
 * página que hoje tem zero, e a foto grande na própria página serve melhor quem
 * está no celular com sinal ruim.
 *
 * RODADA DE FOTOGRAFIA (20/08/2026). Eram 12 fotos numa grade corrida. Agora
 * são 30, em quatro capítulos — a casa, a água, a mesa, a gente. O capítulo
 * existe porque 30 fotos seguidas não se lê: a partir da décima o visitante
 * rola sem ver, e o que devia vender vira papel de parede.
 *
 * PROCEDÊNCIA. Todas as fotos desta página foram feitas na Villa Arapiuns ou
 * nos passeios dela, com UMA exceção declarada na legenda: o boto tucuxi, que
 * vem do Wikimedia Commons em domínio público, porque o acervo da Villa não tem
 * nenhuma foto de boto. Ficaram de fora os três arquivos do acervo com nome de
 * lugar da região ("ALTER DO CHÃO", "FLORESTA NACIONAL DO TAPAJÓS") que podem
 * ser imagem de terceiros — sem confirmação de autoria, não entram.
 *
 * RESOLUÇÃO. Cada card ocupa no máximo ~30vw no desktop, o que a 1440px dá
 * ~430 CSS px e pede ~860px de origem em tela de densidade dupla. Isso cabe
 * até na menor foto desta página (1200px), então a grade é segura para o
 * acervo inteiro — o que não seria verdade num layout de largura cheia.
 *
 * FASE 6 (22/08/2026): o capítulo "a casa" trazia varanda-noite.jpg — a regra
 * (nada de fotografia noturna, exceção nominal só para a piracaia, já
 * registrada em Home.astro) valia para esta página também e tinha ficado
 * esquecida aqui. Trocada por varanda-cadeiras-rede.jpg, a mesma ideia de
 * varanda parada, de dia.
 */
import { Image } from 'astro:assets';
import AberturaPagina from '@/components/AberturaPagina.astro';
import { useTranslations, useList } from '@/i18n/utils';
import type { Locale } from '@/i18n/config';

/* a casa */
import bangaloOctogonal from '@/assets/imgs/bangalo-octogonal.jpg';
import hero6 from '@/assets/imgs/hero6.jpg';
import bangaloExterno from '@/assets/imgs/bangalo-externo.jpg';
import chale11 from '@/assets/imgs/chale-11.jpg';
import gal6 from '@/assets/imgs/gal6.jpg';
import quartoCasal from '@/assets/imgs/quarto-casal.jpg';
import varandaRedeDuplex from '@/assets/imgs/varanda-rede-duplex.jpg';
import varandaCadeirasRede from '@/assets/imgs/varanda-cadeiras-rede.jpg';
import banheiroPia from '@/assets/imgs/banheiro-pia.jpg';
import pavilhaoPalha from '@/assets/imgs/pavilhao-palha.jpg';
import deckYoga from '@/assets/imgs/deck-yoga.jpg';
import passarelaRefeitorio from '@/assets/imgs/passarela-refeitorio.jpg';
import arenaBancos from '@/assets/imgs/arena-bancos.jpg';

/* a água */
import bancoAreia from '@/assets/imgs/banco-areia.jpg';
import aguaTransparente from '@/assets/imgs/agua-transparente.jpg';
import porDoSolPortao from '@/assets/imgs/por-do-sol-portao.jpg';
import praiaEspreguicadeira from '@/assets/imgs/praia-espreguicadeira.jpg';
import igapoCanoa from '@/assets/imgs/igapo-canoa.jpg';
import igapoTroncos from '@/assets/imgs/igapo-troncos.jpg';
import igarape from '@/assets/imgs/igarape.jpg';
import hero4 from '@/assets/imgs/hero4.jpg';
import supRio from '@/assets/imgs/sup-rio.jpg';
import caiaques from '@/assets/imgs/caiaques.jpg';
import tucuxi from '@/assets/imgs/tucuxi.jpg';

/* a mesa */
import cafeRefeitorio from '@/assets/imgs/cafe-refeitorio.jpg';
import jantarPeixe from '@/assets/imgs/jantar-peixe.jpg';
import hero2 from '@/assets/imgs/hero2.jpg';
import mesaCaneca from '@/assets/imgs/mesa-caneca.jpg';

/* a gente */
import porDoSolGrupo from '@/assets/imgs/porsol-gente.jpg';
import farinhada from '@/assets/imgs/farinhada.jpg';
import tecelagem from '@/assets/imgs/tecelagem.jpg';
import samauma from '@/assets/imgs/samauma-grupo.jpg';
import trilhaGrupo from '@/assets/imgs/trilha-guia.jpg';
import luauPraia from '@/assets/imgs/luau-praia.jpg';
import artesanato from '@/assets/imgs/artesanato.jpg';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);

/* `alta` = retrato (3/4). Distribuída para a grade não virar fileira de
   retângulos iguais — é a cunha de largura desigual do painel.
   Tipado à mão: com `as const` o TypeScript monta uma união em que `alta` só
   existe em alguns membros, e a leitura no template não compila. */
interface Foto {
  src: ImageMetadata;
  alt: string;
  leg: string;
  alta?: boolean;
}
interface Capitulo {
  id: string;
  titulo: string;
  fotos: Foto[];
}

/* Só a foto e o `alta` (mera proporção de recorte, não texto) ficam aqui.
   `titulo` de cada capítulo e `leg`/`alt` de cada foto vêm de
   `galeria.titulo_<id>` e `galeria.capitulos` em cada `src/i18n/*.json`,
   casados por `id` — ver a nota de `home.tiraItens` no mesmo espírito. */
const FOTOS_GALERIA: Record<string, Record<string, { src: ImageMetadata; alta?: boolean }>> = {
  casa: {
    bangaloOctogonal: { src: bangaloOctogonal },
    hero6: { src: hero6, alta: true },
    bangaloExterno: { src: bangaloExterno },
    chale11: { src: chale11 },
    gal6: { src: gal6 },
    quartoCasal: { src: quartoCasal, alta: true },
    varandaRedeDuplex: { src: varandaRedeDuplex },
    varandaCadeiras: { src: varandaCadeirasRede },
    banheiroPia: { src: banheiroPia, alta: true },
    pavilhaoPalha: { src: pavilhaoPalha },
    deckYoga: { src: deckYoga },
    passarelaRefeitorio: { src: passarelaRefeitorio },
    arenaBancos: { src: arenaBancos },
  },
  agua: {
    bancoAreia: { src: bancoAreia },
    aguaTransparente: { src: aguaTransparente },
    porDoSolPortao: { src: porDoSolPortao, alta: true },
    praiaEspreguicadeira: { src: praiaEspreguicadeira },
    igapoCanoa: { src: igapoCanoa },
    igapoTroncos: { src: igapoTroncos, alta: true },
    igarape: { src: igarape },
    hero4: { src: hero4 },
    supRio: { src: supRio },
    caiaques: { src: caiaques },
    tucuxi: { src: tucuxi },
  },
  mesa: {
    cafeRefeitorio: { src: cafeRefeitorio },
    jantarPeixe: { src: jantarPeixe, alta: true },
    hero2: { src: hero2 },
    mesaCaneca: { src: mesaCaneca },
  },
  gente: {
    porDoSolGrupo: { src: porDoSolGrupo },
    farinhada: { src: farinhada },
    tecelagem: { src: tecelagem, alta: true },
    samauma: { src: samauma },
    trilhaGrupo: { src: trilhaGrupo },
    luauPraia: { src: luauPraia },
    artesanato: { src: artesanato },
  },
};

const TITULOS_CAPITULO: Record<string, string> = {
  casa: t('galeria.titulo_casa'),
  agua: t('galeria.titulo_agua'),
  mesa: t('galeria.titulo_mesa'),
  gente: t('galeria.titulo_gente'),
};

const capitulos: Capitulo[] = useList(locale)<{ id: string; fotos: { id: string; leg: string; alt: string }[] }>('galeria.capitulos')
  .map((cap) => ({
    id: cap.id,
    titulo: TITULOS_CAPITULO[cap.id],
    fotos: cap.fotos.map((f) => ({
      ...FOTOS_GALERIA[cap.id][f.id],
      leg: f.leg,
      alt: f.alt,
    })),
  }));

/* Só as três primeiras fotos da página inteira entram como `eager`. Um índice
   corrido entre capítulos é a diferença entre 3 imagens no caminho crítico e
   30 — e o público #1 está em rede móvel instável. */
let indice = 0;
---

<AberturaPagina titulo={t('galeria.h1')} intro={t('galeria.intro')} />

{capitulos.map((cap) => (
  <section class="pb-16">
    <div class="container-editorial">
      <h2 class="font-display text-titulo emenda border-t pt-6">{cap.titulo}</h2>
      <ul class="mt-8 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
        {cap.fotos.map((f) => {
          const i = indice++;
          return (
            <li>
              <figure>
                <Image
                  src={f.src}
                  alt={f.alt}
                  widths={[420, 700, 1100]}
                  sizes="(min-width: 1024px) 30vw, (min-width: 640px) 46vw, 100vw"
                  loading={i < 3 ? 'eager' : 'lazy'}
                  decoding={i < 3 ? undefined : 'async'}
                  class:list={['w-full object-cover', f.alta ? 'aspect-[3/4]' : 'aspect-[4/3]']}
                />
                <figcaption class="meta numero mt-3">{f.leg}</figcaption>
              </figure>
            </li>
          );
        })}
      </ul>
    </div>
  </section>
))}
