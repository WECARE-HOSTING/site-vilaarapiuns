---
/**
 * GALERIA — modo Experience: a obra lidera, a interface recua.
 *
 * Grade de cunhas de altura desigual, como folhas de veio cortadas em larguras
 * diferentes num painel. Sem lightbox: um lightbox exigiria JavaScript numa
 * página que hoje tem zero, e a foto grande na própria página serve melhor quem
 * está no celular com sinal ruim.
 *
 * RODADA DE FOTOGRAFIA (20/08/2026). Eram 12 fotos numa grade corrida. Agora
 * são 30, em quatro capítulos — a casa, a água, a mesa, a gente. O capítulo
 * existe porque 30 fotos seguidas não se lê: a partir da décima o visitante
 * rola sem ver, e o que devia vender vira papel de parede.
 *
 * PROCEDÊNCIA. Todas as fotos desta página foram feitas na Villa Arapiuns ou
 * nos passeios dela, com UMA exceção declarada na legenda: o boto tucuxi, que
 * vem do Wikimedia Commons em domínio público, porque o acervo da Villa não tem
 * nenhuma foto de boto. Ficaram de fora os três arquivos do acervo com nome de
 * lugar da região ("ALTER DO CHÃO", "FLORESTA NACIONAL DO TAPAJÓS") que podem
 * ser imagem de terceiros — sem confirmação de autoria, não entram.
 *
 * RESOLUÇÃO. Cada card ocupa no máximo ~30vw no desktop, o que a 1440px dá
 * ~430 CSS px e pede ~860px de origem em tela de densidade dupla. Isso cabe
 * até na menor foto desta página (1200px), então a grade é segura para o
 * acervo inteiro — o que não seria verdade num layout de largura cheia.
 */
import { Image } from 'astro:assets';
import AberturaPagina from '@/components/AberturaPagina.astro';
import { useTranslations } from '@/i18n/utils';
import type { Locale } from '@/i18n/config';

/* a casa */
import bangaloOctogonal from '@/assets/imgs/bangalo-octogonal.jpg';
import hero6 from '@/assets/imgs/hero6.jpg';
import bangaloExterno from '@/assets/imgs/bangalo-externo.jpg';
import chale11 from '@/assets/imgs/chale-11.jpg';
import gal6 from '@/assets/imgs/gal6.jpg';
import quartoCasal from '@/assets/imgs/quarto-casal.jpg';
import varandaRedeDuplex from '@/assets/imgs/varanda-rede-duplex.jpg';
import varandaNoite from '@/assets/imgs/varanda-noite.jpg';
import banheiroPia from '@/assets/imgs/banheiro-pia.jpg';
import pavilhaoPalha from '@/assets/imgs/pavilhao-palha.jpg';
import deckYoga from '@/assets/imgs/deck-yoga.jpg';
import passarelaRefeitorio from '@/assets/imgs/passarela-refeitorio.jpg';
import arenaBancos from '@/assets/imgs/arena-bancos.jpg';

/* a água */
import bancoAreia from '@/assets/imgs/banco-areia.jpg';
import aguaTransparente from '@/assets/imgs/agua-transparente.jpg';
import porDoSolPortao from '@/assets/imgs/por-do-sol-portao.jpg';
import praiaEspreguicadeira from '@/assets/imgs/praia-espreguicadeira.jpg';
import igapoCanoa from '@/assets/imgs/igapo-canoa.jpg';
import igapoTroncos from '@/assets/imgs/igapo-troncos.jpg';
import igarape from '@/assets/imgs/igarape.jpg';
import hero4 from '@/assets/imgs/hero4.jpg';
import supRio from '@/assets/imgs/sup-rio.jpg';
import caiaques from '@/assets/imgs/caiaques.jpg';
import tucuxi from '@/assets/imgs/tucuxi.jpg';

/* a mesa */
import cafeRefeitorio from '@/assets/imgs/cafe-refeitorio.jpg';
import jantarPeixe from '@/assets/imgs/jantar-peixe.jpg';
import hero2 from '@/assets/imgs/hero2.jpg';
import mesaCaneca from '@/assets/imgs/mesa-caneca.jpg';

/* a gente */
import porDoSolGrupo from '@/assets/imgs/porsol-gente.jpg';
import farinhada from '@/assets/imgs/farinhada.jpg';
import tecelagem from '@/assets/imgs/tecelagem.jpg';
import samauma from '@/assets/imgs/samauma-grupo.jpg';
import trilhaGrupo from '@/assets/imgs/trilha-guia.jpg';
import luauPraia from '@/assets/imgs/luau-praia.jpg';
import artesanato from '@/assets/imgs/artesanato.jpg';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);

/* `alta` = retrato (3/4). Distribuída para a grade não virar fileira de
   retângulos iguais — é a cunha de largura desigual do painel.
   Tipado à mão: com `as const` o TypeScript monta uma união em que `alta` só
   existe em alguns membros, e a leitura no template não compila. */
interface Foto {
  src: ImageMetadata;
  alt: string;
  leg: string;
  alta?: boolean;
}
interface Capitulo {
  id: string;
  titulo: string;
  fotos: Foto[];
}

const capitulos: Capitulo[] = [
  {
    id: 'casa',
    titulo: 'A casa',
    fotos: [
      { src: bangaloOctogonal, alt: 'Bangalô octogonal de madeira com telhado de palha, suspenso entre os troncos altos da floresta', leg: 'Bangalô octogonal' },
      { src: hero6, alt: 'Bangalô de dois andares em madeira sobre palafitas, com telhado de palha', leg: 'Bangalô duplex', alta: true },
      { src: bangaloExterno, alt: 'Bangalô de um pavimento em madeira sobre palafitas, na areia', leg: 'Quarto casa' },
      { src: chale11, alt: 'Fachada do chalé número 11 com rede armada na varanda, meio escondido pela vegetação', leg: 'Chalé 11' },
      /* 20/08/2026 — a legenda "A marchetaria" estava em `gal5.jpg`, que é um
         hóspede sentado numa canoa em campo de vitórias-régias. O cliente viu a
         mesma foto com a mesma legenda errada na home e na página da pousada e
         pediu a troca; aqui era o terceiro lugar. Entra `gal6.jpg`, que tem as
         DUAS peças que a legenda promete: a porta de mogno com as cunhas radiais
         e a porta interna com o medalhão octogonal.

         `gal5` não foi para outro capítulo porque não precisa: ela é a mesma
         cena de `hero4.jpg`, que já está em "A água" como "Vitórias-régias". */
      { src: gal6, alt: 'Cama de casal com manta xadrez de chocolate e aveia, entre uma porta interna com medalhão octogonal e uma porta de mogno cujas cunhas de veio oposto irradiam de um centro', leg: 'A marchetaria' },
      { src: quartoCasal, alt: 'Quarto de madeira escura com cama de casal, manta xadrez dobrada ao pé e cadeira ao lado da janela', leg: 'Quarto de casal', alta: true },
      { src: varandaRedeDuplex, alt: 'Varanda do pavimento superior com rede preta armada, cadeira de cipó e cesto trançado na parede', leg: 'Varanda do duplex' },
      { src: varandaNoite, alt: 'Varanda à noite com rede, luminária de fibra trançada acesa e cadeiras de balanço', leg: 'Varanda, ao fim do dia' },
      { src: banheiroPia, alt: 'Pia de banheiro com cuba branca sobre bancada de madeira, espelho e cestaria regional, sob teto de palha', leg: 'O banheiro', alta: true },
      { src: pavilhaoPalha, alt: 'Pavilhão comprido de telhado de palha sobre deck de madeira, entre as árvores', leg: 'O pavilhão' },
      { src: deckYoga, alt: 'Deck de madeira sob telhado de palha aberto para a mata, com espreguiçadeira e samambaias', leg: 'A shala' },
      { src: passarelaRefeitorio, alt: 'Passarela de madeira serpenteando entre os troncos da floresta até a maloca de palha do refeitório', leg: 'A passarela' },
      { src: arenaBancos, alt: 'Bancos de tronco maciço formando uma roda na areia da clareira, cercados pela mata', leg: 'A roda de fogo' },
    ],
  },
  {
    id: 'agua',
    titulo: 'A água',
    fotos: [
      { src: bancoAreia, alt: 'Banco de areia dourada com uma trilha de pegadas, cortando a água azul dos dois lados', leg: 'Banco de areia' },
      { src: aguaTransparente, alt: 'Banco de areia dentro do rio, com a água rasa tão clara que o fundo aparece ondulado pela luz', leg: 'Água transparente' },
      { src: porDoSolPortao, alt: 'Sol baixo alaranjado sobre a água larga do rio, visto da passarela, com a vegetação em silhueta', leg: 'Pôr do sol no rio', alta: true },
      { src: praiaEspreguicadeira, alt: 'Faixa de areia clara com espreguiçadeiras de madeira alinhadas à sombra das árvores, na luz dourada', leg: 'A praia da Villa' },
      { src: igapoCanoa, alt: 'Canoa de madeira azul encostada na areia, diante de arbustos e palmeiras com o tronco dentro da água', leg: 'O igapó' },
      { src: igapoTroncos, alt: 'Área alagada de água azul recortando tapetes de vegetação alaranjada, com troncos secos deitados', leg: 'Mata alagada', alta: true },
      { src: igarape, alt: 'Igarapé de água escura correndo entre a vegetação fechada da floresta', leg: 'Igarapé' },
      { src: hero4, alt: 'Canoa de madeira parada num campo de vitórias-régias, com um homem sentado na proa, remo na mão', leg: 'Vitórias-régias' },
      { src: supRio, alt: 'Pessoa de pé numa prancha de stand-up, remando em água calma diante de uma margem de mata baixa', leg: 'Stand-up no rio' },
      { src: caiaques, alt: 'Caiaques amarelo e laranja guardados em cavaletes sob um rancho de telhado de palha', leg: 'Os caiaques' },
      /* A única foto de fora. A legenda diz a espécie, não o lugar. */
      { src: tucuxi, alt: 'Dois botos tucuxi emergindo juntos na superfície de um rio, levantando respingo', leg: 'Boto tucuxi · Wikimedia Commons' },
    ],
  },
  {
    id: 'mesa',
    titulo: 'A mesa',
    fotos: [
      { src: cafeRefeitorio, alt: 'Mesa de café da manhã posta no pavilhão aberto: bolo, tapioca, fruta fatiada e jarra de suco vermelho', leg: 'Café da manhã' },
      { src: jantarPeixe, alt: 'Peixes assados inteiros em travessas de barro à luz de velas, com farofa e limão ao lado', leg: 'Peixe assado', alta: true },
      { src: hero2, alt: 'Mesa de jantar à luz de velas na praia, com peixe e farinha em folha de bananeira', leg: 'Piracaia' },
      { src: mesaCaneca, alt: 'Caneca de cerâmica azul apoiada num jogo americano de palha trançada, sobre a madeira da mesa', leg: 'A louça' },
    ],
  },
  {
    id: 'gente',
    titulo: 'A gente',
    fotos: [
      { src: porDoSolGrupo, alt: 'Fileira de pessoas sentadas na beira da praia, de costas, vendo o sol baixar sobre o rio', leg: 'A hora do pôr do sol' },
      { src: farinhada, alt: 'Moradores da comunidade e hóspedes em volta de um cocho, peneirando a massa de mandioca', leg: 'Farinhada' },
      { src: tecelagem, alt: 'Artesã da comunidade sorrindo enquanto mostra o trançado de palha a duas hóspedes', leg: 'Tecelagem', alta: true },
      { src: samauma, alt: 'Grupo de pessoas de mãos dadas em volta do tronco enorme de uma samaúma, sem fechar o círculo', leg: 'A samaúma' },
      { src: trilhaGrupo, alt: 'Grupo de caminhantes com mochila subindo uma trilha de areia clara, entre vegetação alta', leg: 'Na trilha' },
      { src: luauPraia, alt: 'Praia à noite com fogueira acesa, fileira de velas na areia e hóspedes reunidos sob as palmeiras', leg: 'A noite na praia' },
      { src: artesanato, alt: 'Prateleira com cestos, potes e bolsas de palha trançada do artesanato da região', leg: 'O artesanato' },
    ],
  },
];

/* Só as três primeiras fotos da página inteira entram como `eager`. Um índice
   corrido entre capítulos é a diferença entre 3 imagens no caminho crítico e
   30 — e o público #1 está em rede móvel instável. */
let indice = 0;
---

<AberturaPagina titulo={t('galeria.h1')} intro={t('galeria.intro')} />

{capitulos.map((cap) => (
  <section class="pb-16">
    <div class="container-editorial">
      <h2 class="font-display text-titulo emenda border-t pt-6">{cap.titulo}</h2>
      <ul class="mt-8 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
        {cap.fotos.map((f) => {
          const i = indice++;
          return (
            <li>
              <figure>
                <Image
                  src={f.src}
                  alt={f.alt}
                  widths={[420, 700, 1100]}
                  sizes="(min-width: 1024px) 30vw, (min-width: 640px) 46vw, 100vw"
                  loading={i < 3 ? 'eager' : 'lazy'}
                  decoding={i < 3 ? undefined : 'async'}
                  class:list={['w-full object-cover', f.alta ? 'aspect-[3/4]' : 'aspect-[4/3]']}
                />
                <figcaption class="meta numero mt-3">{f.leg}</figcaption>
              </figure>
            </li>
          );
        })}
      </ul>
    </div>
  </section>
))}
