---
import Logo from '@/components/Logo.astro';
import { LOCALES, LOCALE_NAMES, HTML_LANG, type Locale } from '@/i18n/config';
import { href } from '@/i18n/routes';
import { useTranslations } from '@/i18n/utils';
import { SITE, whatsappUrl, telefoneLegivel } from '@/data/site';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);

const ano = new Date().getFullYear();
const colunaVisita = ['lodge', 'dining', 'gallery'] as const;
const colunaReserva = ['packages', 'privateVilla', 'gettingHere', 'reviews', 'book'] as const;
---

<footer class="bg-mar-fundo sobre-escuro">
  <div class="container-editorial py-16 md:py-20">
    <div class="grid gap-12 md:grid-cols-[1.4fr_1fr_1fr] lg:gap-16">
      <div>
        <Logo />
        <p class="mt-6 max-w-sm meta leading-relaxed">
          {t('footer.sobre')}
        </p>

        <div class="mt-8 flex flex-col gap-2 text-sm">
          <a href={whatsappUrl(t('whatsapp.geral'))} class="link-escuro w-fit" target="_blank" rel="noopener noreferrer">
            {t('cta.whatsapp')}
          </a>
          {SITE.contact.email && (
            <a href={`mailto:${SITE.contact.email}`} class="link-escuro w-fit" target="_blank" rel="noopener noreferrer">
              {SITE.contact.email}
            </a>
          )}
          <a href={`tel:+${SITE.contact.whatsapp}`} class="link-escuro w-fit" target="_blank" rel="noopener noreferrer">
            {telefoneLegivel()}
          </a>
        </div>
      </div>

      <nav aria-labelledby="rodape-visita">
        <p id="rodape-visita" class="etiqueta mb-5">{t('footer.visita')}</p>
        <ul class="space-y-2.5 text-sm">
          {colunaVisita.map((k) => (
            <li><a href={href(locale, k)} class="inline-block py-1 hover:text-areia">{t(`nav.${k}`)}</a></li>
          ))}
        </ul>
      </nav>

      <nav aria-labelledby="rodape-reserva">
        <p id="rodape-reserva" class="etiqueta mb-5">{t('footer.reserva')}</p>
        <ul class="space-y-2.5 text-sm">
          {colunaReserva.map((k) => (
            <li><a href={href(locale, k)} class="inline-block py-1 hover:text-areia">{t(`nav.${k}`)}</a></li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="mt-14 grid gap-6 border-t border-espuma/15 pt-8 md:grid-cols-2">
      <dl class="grid grid-cols-2 gap-6 text-sm sm:max-w-md">
        <div>
          <dt class="etiqueta mb-1.5">{t('footer.local')}</dt>
          <dd>{SITE.location.river}, {SITE.location.state} — {t('footer.brasil')}</dd>
        </div>
        <div>
          <dt class="etiqueta mb-1.5">{t('footer.partida')}</dt>
          <dd>{SITE.location.departsFrom}, {SITE.location.state}</dd>
        </div>
      </dl>

      <div class="md:text-right">
        <p class="etiqueta mb-3">{t('nav.language')}</p>
        <ul class="flex flex-wrap gap-x-5 gap-y-2 text-sm md:justify-end">
          {LOCALES.map((l) => (
            <li>
              <a
                href={href(l, 'home')}
                hreflang={HTML_LANG[l]}
                lang={HTML_LANG[l]}
                aria-current={l === locale ? 'true' : undefined}
                class:list={[
                  'inline-block py-1',
                  l === locale ? 'text-areia font-medium' : 'hover:text-areia',
                ]}
              >
                {LOCALE_NAMES[l]}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <p class="mt-10 text-xs">
      © {ano} {SITE.name} · {t('footer.tipo')}
    </p>
  </div>
</footer>
