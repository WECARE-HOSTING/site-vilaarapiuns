---
/**
 * O MAPA DE SITUAÇÃO.
 *
 * Por que existe: a maior ansiedade deste produto é geográfica antes de ser
 * logística. "Quem vai para a Amazônia quer saber onde está indo" — e a lista
 * de três etapas responde a SEQUÊNCIA sem nunca responder o LUGAR. O mapa
 * responde o lugar; a lista continua respondendo a ordem. São peças diferentes
 * e é por isso que aparecem juntas, o mapa primeiro.
 *
 * Por que ele não viola a disciplina 3 (região reservada, sem tipo em cima):
 * o mapa JÁ é tipo assentado em imagem, feito assim na origem. Não se põe nada
 * por cima dele; a legenda fica embaixo, na régua da lista de corte.
 *
 * Por que não é um Google Maps embutido: o mapa da casa não tem escala nem
 * estrada, porque ali não há estrada — o trecho final é rio. Um mapa de
 * navegação prometeria uma rota que não existe. Este orienta, e orientar é o
 * que o visitante pede neste momento. A moldura dele fecha em #192815, a dois
 * passos de `--color-mar-fundo`: a borda ornamentada da ilustração É a borda
 * da página, sem anel nosso em volta.
 *
 * Por que tem lupa, e só no celular: a partir de 1024px o mapa já sai perto do
 * tamanho desenhado e ampliar não acrescenta nada — a lupa ali seria botão que
 * não faz diferença. No telefone acrescenta, então existe abaixo de `lg`.
 *
 * Por que o controle NÃO fica sobre o mapa: a primeira versão punha "AMPLIAR O
 * MAPA" no canto inferior direito da ilustração e o rótulo tapava Alter do
 * Chão — escondia justamente o ponto de partida da última etapa. É a disciplina
 * 3 aplicada ao pé da letra: nada nosso entra na região reservada. O rótulo
 * desce para a régua da legenda; o mapa inteiro continua clicável, com
 * `cursor-zoom-in` e sem tinta nossa em cima.
 *
 * Por que 180vw e não mais: acima disso a viewport do telefone deixa de conter
 * Villa e Alter do Chão ao mesmo tempo, e é a RELAÇÃO entre os dois que o mapa
 * existe para mostrar. Ampliar até perder a relação seria ampliar contra o
 * próprio propósito. O diálogo também abre já rolado para o eixo entre os dois,
 * não no canto superior esquerdo, que é onde não há nada.
 */
import { Image } from 'astro:assets';
import Voluta from '@/components/Voluta.astro';
import { useTranslations } from '@/i18n/utils';
import { SITE } from '@/data/site';
import type { Locale } from '@/i18n/config';
import mapa from '@/assets/imgs/mapa-arapiuns.png';

interface Props {
  locale: Locale;
  class?: string;
}
const { locale, class: className = '' } = Astro.props;
const t = useTranslations(locale);

// Disciplina 2: as medidas da legenda saem de src/data/site.ts, não do texto.
const horas = Math.floor(SITE.location.boatMinutes / 60);
const minutos = SITE.location.boatMinutes % 60;
const tempoBarco = minutos ? `${horas}h${String(minutos).padStart(2, '0')}` : `${horas}h`;
---

<figure class:list={['mx-auto max-w-[70rem]', className]} data-mapa>
  <div class="relative">
    <Image
      src={mapa}
      alt={t('mapa.alt')}
      widths={[560, 840, 1120]}
      sizes="(min-width: 1120px) 1120px, 100vw"
      loading="lazy"
      decoding="async"
      class="w-full"
    />

    <!-- Alvo de toque em cima do mapa inteiro, SEM rótulo: o rótulo visível é o
         botão da legenda, logo abaixo. Fica IRMÃO da imagem, não em volta dela —
         dentro de um <button> o nome acessível engoliria a descrição do alt. -->
    <button
      type="button"
      data-abrir
      tabindex="-1"
      aria-hidden="true"
      class="absolute inset-0 cursor-zoom-in lg:hidden"
    ></button>
  </div>

  <figcaption class="emenda mt-4 flex flex-wrap items-center justify-between gap-x-6 gap-y-3 border-t pt-4">
    <p class="numero etiqueta flex flex-wrap items-center gap-x-3 gap-y-1">
      {SITE.location.river}
      <Voluta class="text-areia-sol" />
      {tempoBarco} de lancha de {SITE.location.departsFrom}
      <Voluta class="text-areia-sol" />
      {t('mapa.aeroporto')}
    </p>

    <button
      type="button"
      data-abrir
      class="etiqueta emenda flex items-center gap-2 border px-3 py-2 transition-colors hover:bg-mar hover:text-areia-clara lg:hidden"
    >
      <svg viewBox="0 0 16 16" fill="none" aria-hidden="true" class="h-3.5 w-3.5">
        <circle cx="6.6" cy="6.6" r="4.6" stroke="currentColor" stroke-width="1.3" />
        <path d="M10.2 10.2 L14.5 14.5 M6.6 4.4 v4.4 M4.4 6.6 h4.4"
              stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
      </svg>
      {t('mapa.ampliar')}
    </button>
  </figcaption>

  <!-- `m-auto` explícito: o preflight do Tailwind zera a margem de todo
       elemento, e é a margem auto que centra um <dialog> nativo. Sem isto ele
       encosta no topo e a página aparece atenuada embaixo. -->
  <dialog
    class="mapa-dialogo sobre-escuro m-auto max-h-[100dvh] max-w-[100vw] bg-mar-fundo p-0 backdrop:bg-mar-fundo/90"
    aria-label={t('mapa.dialogo')}
  >
    <div class="relative">
      <!-- Maior que a tela de propósito: no celular o dedo arrasta o mapa
           até o rótulo que interessa. -->
      <div class="max-h-[100dvh] overflow-auto overscroll-contain" data-rolagem>
        <Image
          src={mapa}
          alt=""
          widths={[1120]}
          loading="lazy"
          decoding="async"
          class="w-[min(1120px,_180vw)] max-w-none"
        />
      </div>

      <button
        type="button"
        data-fechar
        class="etiqueta absolute right-3 top-3 border border-sol/60 bg-mar-fundo/90 px-3 py-2 text-sol transition-colors hover:bg-sol hover:text-mar-fundo"
      >
        {t('mapa.fechar')}
      </button>
    </div>
  </dialog>
</figure>

<style>
  /* Fase 5: showModal()/close() trocavam de estado sem transição — a lupa
     cobria a tela inteira sem aviso. Modal fica centrado, sem
     transform-origin de gatilho (é a exceção que a disciplina de popover
     reserva para modais). */
  .mapa-dialogo {
    opacity: 1;
    scale: 1;
    transition: opacity 250ms cubic-bezier(0.23, 1, 0.32, 1),
                scale 250ms cubic-bezier(0.23, 1, 0.32, 1);
  }
  .mapa-dialogo::backdrop {
    transition: background-color 250ms cubic-bezier(0.23, 1, 0.32, 1);
  }
  @starting-style {
    .mapa-dialogo[open] {
      opacity: 0;
      scale: 0.96;
    }
    .mapa-dialogo[open]::backdrop {
      background-color: transparent;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    /* Mais suave, não zerado: mantém o fade, tira o scale. */
    .mapa-dialogo { transition-property: opacity; }
    @starting-style {
      .mapa-dialogo[open] { scale: 1; }
    }
  }
</style>

<script>
  // Uma passagem por instância: a Home e o Como chegar montam o mesmo
  // componente, e cada um resolve o seu próprio <dialog>.
  document.querySelectorAll<HTMLElement>('[data-mapa]').forEach((raiz) => {
    const dialogo = raiz.querySelector('dialog');
    if (!dialogo) return;

    const rolagem = dialogo.querySelector<HTMLElement>('[data-rolagem]');

    // Abre já no eixo Villa↔Alter do Chão. Sem isto o diálogo aparece no canto
    // superior esquerdo do mapa, que é floresta sem rótulo — o leitor teria de
    // procurar antes de reconhecer o que está vendo. As frações são a posição
    // do eixo dentro da ilustração, medidas nela.
    const centralizar = () => {
      if (!rolagem) return;
      rolagem.scrollLeft = (rolagem.scrollWidth - rolagem.clientWidth) * 0.42;
      rolagem.scrollTop = (rolagem.scrollHeight - rolagem.clientHeight) * 0.55;
    };

    raiz.querySelectorAll('[data-abrir]').forEach((gatilho) =>
      gatilho.addEventListener('click', () => {
        dialogo.showModal();
        centralizar();
      }),
    );
    raiz.querySelector('[data-fechar]')?.addEventListener('click', () => dialogo.close());

    // Clique fora da figura fecha — o alvo só é o próprio <dialog> quando o
    // ponteiro cai na margem, fora da imagem.
    dialogo.addEventListener('click', (evento) => {
      if (evento.target === dialogo) dialogo.close();
    });
  });
</script>
