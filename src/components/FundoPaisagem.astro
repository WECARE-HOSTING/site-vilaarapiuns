---
/**
 * O fundo de paisagem do hero — três fotos da região que se atravessam
 * devagar, atrás do gancho.
 *
 * Por que ele existe: até 16/09/2026 o hero abria no chão `areia-clara` e a
 * fotografia só começava na coluna de reels, abaixo. O acervo é quase todo
 * maloca e interior; faltava o rio. Estas três fotos são da região e foram
 * recortadas a mão para 16:9 (duas vieram em retrato).
 *
 * Mecanismo: as três imagens ficam empilhadas em `grid-area: 1/1` e a troca é
 * só `opacity`. Nada de `transform`, nada de reflow — o navegador compõe na
 * GPU e o custo por troca é o de uma camada.
 *
 * Sem JavaScript: a primeira foto tem `.esta` no HTML e as outras nascem em
 * opacidade 0. Sem o script a primeira fica, parada, e o hero continua de pé —
 * a mesma degradação honesta do Padrão 1 (Home.astro) e da ColunaDeReels.
 *
 * prefers-reduced-motion: reduce → o script não liga o intervalo. Não é
 * "transição mais curta": é decidir que a rotação não acontece, igual ao que
 * docs/video.md §2 estabelece para os reels.
 *
 * A primeira imagem leva `loading="eager"` e `fetchpriority="high"` porque é
 * LCP. As outras duas são `lazy`: não competem pela primeira dobra num celular
 * em 3G, que é o público #1 do PRODUCT.md.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface FotoPaisagem {
  src: ImageMetadata;
  alt: string;
}

interface Props {
  fotos: FotoPaisagem[];
  intervalo?: number;
}

const { fotos, intervalo = 5000 } = Astro.props;
---

<div class="fundo-paisagem" data-fundo-paisagem data-intervalo={intervalo}>
  {fotos.map((foto, i) => (
    <Image
      src={foto.src}
      alt={i === 0 ? foto.alt : ''}
      widths={[640, 1024, 1600, 2400]}
      sizes="100vw"
      class:list={['fundo-paisagem__foto', i === 0 && 'esta']}
      loading={i === 0 ? 'eager' : 'lazy'}
      fetchpriority={i === 0 ? 'high' : 'auto'}
      aria-hidden={i === 0 ? undefined : 'true'}
    />
  ))}
  <div class="fundo-paisagem__veu"></div>
</div>

<style>
  .fundo-paisagem {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: grid;
    overflow: hidden;
    background-color: var(--color-mar-fundo);
  }

  .fundo-paisagem__foto {
    grid-area: 1 / 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 1400ms ease-in-out;
  }

  .fundo-paisagem__foto.esta { opacity: 1; }

  /* O véu escurece SÓ onde o tipo pousa. O resto da foto fica com a cor real:
     o global.css declara que as cores da marca saíram dos pixels destas fotos,
     e a rodada de 20/08 já rejeitou um overlay que tingia a imagem inteira. */
  /* No CELULAR o véu tem DOIS andares, e a razão é geométrica: a seção é mais
     alta que a dobra (a tira de reels vem antes do gancho), então um gradiente
     medido pela altura total ainda está quase transparente no ponto em que o
     gancho aparece na tela. Medido a 390×844: o branco caía sobre céu claro.
     O andar de baixo é uma lâmina uniforme que garante contraste mínimo em
     qualquer altura; o de cima é o gradiente que adensa atrás do texto. */
  .fundo-paisagem__veu {
    grid-area: 1 / 1;
    background:
      linear-gradient(
        to top,
        color-mix(in srgb, var(--color-mar-fundo) 72%, transparent) 0%,
        color-mix(in srgb, var(--color-mar-fundo) 42%, transparent) 38%,
        color-mix(in srgb, var(--color-mar-fundo) 16%, transparent) 70%,
        transparent 100%
      ),
      color-mix(in srgb, var(--color-mar-fundo) 32%, transparent);
  }

  @media (min-width: 1024px) {
    /* No desktop o gancho e a dobra caem juntos, então o gradiente direcional
       basta e a lâmina uniforme sai — a foto fica com a cor real à direita. */
    .fundo-paisagem__veu {
      background: linear-gradient(
        100deg,
        color-mix(in srgb, var(--color-mar-fundo) 74%, transparent) 0%,
        color-mix(in srgb, var(--color-mar-fundo) 46%, transparent) 34%,
        color-mix(in srgb, var(--color-mar-fundo) 7%, transparent) 62%,
        transparent 100%
      );
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fundo-paisagem__foto { transition: none; }
  }
</style>

<script>
  const CLASSE = 'esta';

  document.querySelectorAll<HTMLElement>('[data-fundo-paisagem]').forEach((palco) => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const fotos = palco.querySelectorAll<HTMLImageElement>('.fundo-paisagem__foto');
    if (fotos.length < 2) return;

    const intervalo = Number(palco.dataset.intervalo) || 5000;
    let atual = 0;
    let timer: number | undefined;

    const trocar = () => {
      fotos[atual].classList.remove(CLASSE);
      atual = (atual + 1) % fotos.length;
      fotos[atual].classList.add(CLASSE);
    };

    const ligar = () => { timer ??= window.setInterval(trocar, intervalo); };
    const parar = () => { if (timer) { clearInterval(timer); timer = undefined; } };

    /* Aba escondida não gasta bateria nem decodifica imagem à toa. */
    document.addEventListener('visibilitychange', () =>
      document.hidden ? parar() : ligar()
    );

    /* Hero fora da tela também não roda: quem já desceu a página não precisa
       de troca acontecendo lá atrás. */
    new IntersectionObserver(
      ([entrada]) => (entrada.isIntersecting ? ligar() : parar()),
      { threshold: 0.15 }
    ).observe(palco);
  });
</script>
