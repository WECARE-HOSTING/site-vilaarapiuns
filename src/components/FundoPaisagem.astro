---
/**
 * O fundo de paisagem do hero — seis fotos da região que se atravessam
 * devagar, atrás do gancho.
 *
 * Por que ele existe: até 16/09/2026 o hero abria no chão `areia-clara` e a
 * fotografia só começava na coluna de reels, abaixo. O acervo é quase todo
 * maloca e interior; faltava o rio. As seis são da região e foram recortadas
 * a mão para 16:9 (duas vieram em retrato).
 *
 * Mecanismo: as imagens ficam empilhadas em `grid-area: 1/1` e a troca é
 * só `opacity`. Nada de `transform`, nada de reflow — o navegador compõe na
 * GPU e o custo por troca é o de uma camada.
 *
 * Desde 17/09/2026 a troca é sobreposição, não fade cruzado: a que sai fica
 * inteira por baixo e só a que entra desvanece — e ela só entra depois de
 * `decode()` resolver. As duas coisas juntas tiram o estalo que o cliente viu
 * em produção (ver a nota no CSS e no script).
 *
 * Sem JavaScript: a primeira foto tem `.esta` no HTML e as outras nascem em
 * opacidade 0. Sem o script a primeira fica, parada, e o hero continua de pé —
 * a mesma degradação honesta do Padrão 1 (Home.astro) e da ColunaDeReels.
 *
 * prefers-reduced-motion: reduce → o script não liga o intervalo. Não é
 * "transição mais curta": é decidir que a rotação não acontece, igual ao que
 * docs/video.md §2 estabelece para os reels.
 *
 * A primeira imagem leva `loading="eager"` e `fetchpriority="high"` porque é
 * LCP. As outras são `lazy`: não competem pela primeira dobra num celular
 * em 3G, que é o público #1 do PRODUCT.md.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface FotoPaisagem {
  src: ImageMetadata;
  alt: string;
}

interface Props {
  fotos: FotoPaisagem[];
  intervalo?: number;
}

const { fotos, intervalo = 5000 } = Astro.props;
---

<div class="fundo-paisagem" data-fundo-paisagem data-intervalo={intervalo}>
  {fotos.map((foto, i) => (
    <Image
      src={foto.src}
      alt={i === 0 ? foto.alt : ''}
      widths={[640, 1024, 1600, 2400]}
      sizes="100vw"
      class:list={['fundo-paisagem__foto', i === 0 && 'esta']}
      loading={i === 0 ? 'eager' : 'lazy'}
      fetchpriority={i === 0 ? 'high' : 'auto'}
      aria-hidden={i === 0 ? undefined : 'true'}
    />
  ))}
  <div class="fundo-paisagem__veu"></div>
</div>

<style>
  .fundo-paisagem {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: grid;
    overflow: hidden;
    background-color: var(--color-mar-fundo);
  }

  .fundo-paisagem__foto {
    grid-area: 1 / 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 1400ms ease-in-out;
    /* Camada própria PERMANENTE. `will-change: opacity` sozinho não bastou:
       medido em 17/09 com captura quadro a quadro, no instante em que a
       transição terminava o navegador repintava o hero inteiro — foto, véu,
       gancho e botões — porque desfazia as camadas que só existiam por causa
       da animação. O texto trocava de suavização, a foto de reamostragem, e
       o resultado era a "piscada" que o cliente viu: parece um ajuste de
       brilho a cada troca. `translateZ(0)` fixa a camada para sempre, e o
       fim da transição deixa de ser um evento de repintura. */
    will-change: opacity, transform;
    transform: translateZ(0);
    backface-visibility: hidden;
  }

  /* A troca é SOBREPOSIÇÃO, não fade cruzado. A foto que sai (`saindo`) fica
     parada em 100%, por baixo; só a que entra (`esta`) desvanece, por cima.
     Antes as duas desvaneciam juntas e, no meio da troca, cada uma estava a
     50% sobre o mar-fundo: a cena escurecia e a nova parecia pular no fim. E
     se a nova ainda não tinha decodificado, o que aparecia por um instante era
     o azul-escuro — o estalo que o cliente viu em 17/09. Com a que sai inteira
     por baixo, nada disso tem onde aparecer. */
  /* Três degraus de z, não dois: a foto que acabou de deixar de ser `saindo`
     ainda está desvanecendo para 0 e, na volta do ciclo (5 → 0 → 1), ela vem
     DEPOIS da `saindo` no DOM — com o mesmo z-index ela pintava por cima e o
     visitante via a foto de duas trocas atrás reaparecer por um segundo. */
  .fundo-paisagem__foto.saindo { opacity: 1; transition: none; z-index: 1; }
  .fundo-paisagem__foto.esta { opacity: 1; z-index: 2; }

  /* O tipo pousa NO PÉ do quadro, à esquerda — desde 16/09/2026 (segunda
     rodada) o hero não tem mais nada além do gancho e dos dois comandos, e
     eles moram embaixo. Então o véu adensa de baixo para cima e solta a foto
     por inteiro do meio para cima, que é onde mora o céu e onde a paisagem
     precisa aparecer sem tinta.

     A lâmina uniforme do celular saiu com a tira de reels que a exigia: ela
     existia porque a seção era muito mais alta que a dobra e o gradiente
     medido pela altura total chegava quase transparente no ponto em que o
     gancho aparecia. Com o gancho ancorado no pé, o gradiente cai exatamente
     onde o texto está, em qualquer altura de tela.

     No desktop entra uma segunda lâmina, da esquerda para a direita, e ela
     morre antes do meio: o gancho é curto e mora à esquerda, e a metade
     direita da fotografia fica com a cor real. O global.css declara que as
     cores da marca saíram dos pixels destas fotos, e a rodada de 20/08 já
     rejeitou um overlay que tingia a imagem inteira. */
  .fundo-paisagem__veu {
    grid-area: 1 / 1;
    /* O véu também mora numa camada fixa, pela mesma razão das fotos: se ele
       for promovido só enquanto a foto de baixo anima, ele é repintado quando
       a animação acaba. */
    will-change: transform;
    transform: translateZ(0);
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--color-mar-fundo) 80%, transparent) 0%,
      color-mix(in srgb, var(--color-mar-fundo) 52%, transparent) 26%,
      color-mix(in srgb, var(--color-mar-fundo) 18%, transparent) 54%,
      transparent 82%
    );
  }

  @media (min-width: 1024px) {
    .fundo-paisagem__veu {
      background:
        linear-gradient(
          to top,
          color-mix(in srgb, var(--color-mar-fundo) 74%, transparent) 0%,
          color-mix(in srgb, var(--color-mar-fundo) 44%, transparent) 24%,
          color-mix(in srgb, var(--color-mar-fundo) 12%, transparent) 52%,
          transparent 78%
        ),
        linear-gradient(
          to right,
          color-mix(in srgb, var(--color-mar-fundo) 32%, transparent) 0%,
          color-mix(in srgb, var(--color-mar-fundo) 8%, transparent) 40%,
          transparent 62%
        );
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fundo-paisagem__foto { transition: none; }
  }
</style>

<script>
  const ESTA = 'esta';
  const SAINDO = 'saindo';

  document.querySelectorAll<HTMLElement>('[data-fundo-paisagem]').forEach((palco) => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const fotos = palco.querySelectorAll<HTMLImageElement>('.fundo-paisagem__foto');
    if (fotos.length < 2) return;

    const intervalo = Number(palco.dataset.intervalo) || 5000;
    let atual = 0;
    let timer: number | undefined;
    let trocando = false;

    /* O estalo tinha uma causa concreta: a foto seguinte é `loading="lazy"` e o
       navegador só decodifica uma imagem quando vai pintá-la. Na troca, a
       transição de opacidade começava com a imagem ainda por decodificar, e
       ela aparecia de repente no meio do fade, no quadro em que a decodificação
       terminava. `decode()` resolve quando os pixels já estão prontos — a troca
       só dispara depois disso. Aquecer na metade do intervalo garante que, na
       hora, o `await` volta na mesma hora. */
    const aquecer = (img: HTMLImageElement) => {
      if (img.loading === 'lazy') img.loading = 'eager';
      return img.decode ? img.decode().catch(() => {}) : Promise.resolve();
    };

    const trocar = async () => {
      if (trocando) return;
      trocando = true;
      const prox = (atual + 1) % fotos.length;
      await aquecer(fotos[prox]);
      fotos.forEach((f) => f.classList.remove(SAINDO));
      fotos[atual].classList.replace(ESTA, SAINDO);
      fotos[prox].classList.add(ESTA);
      atual = prox;
      trocando = false;
      window.setTimeout(() => aquecer(fotos[(atual + 1) % fotos.length]), intervalo / 2);
    };

    const ligar = () => {
      if (timer) return;
      aquecer(fotos[(atual + 1) % fotos.length]);
      timer = window.setInterval(trocar, intervalo);
    };
    const parar = () => { if (timer) { clearInterval(timer); timer = undefined; } };

    /* Aba escondida não gasta bateria nem decodifica imagem à toa. */
    document.addEventListener('visibilitychange', () =>
      document.hidden ? parar() : ligar()
    );

    /* Hero fora da tela também não roda: quem já desceu a página não precisa
       de troca acontecendo lá atrás. */
    new IntersectionObserver(
      ([entrada]) => (entrada.isIntersecting ? ligar() : parar()),
      { threshold: 0.15 }
    ).observe(palco);
  });
</script>
