---
/**
 * Fechamento do pacote (link da bio, noindex, fora do sitemap).
 * O botão abre o link estático da InfinitePay (wecarehosting) com o sinal
 * já calculado. Sem valor calculado, a conversa segue no WhatsApp.
 * Esse link não confirma pagamento: purchase só na página de obrigado,
 * e só com payment_check paid === true.
 */
import { SITE } from '@/data/site';
import WhatsappFlutuante from '@/components/WhatsappFlutuante.astro';
import { PACOTES, type PacoteFechamento } from '@/lib/fechamento';

interface Props {
  pacoteId: PacoteFechamento['id'];
  /** Ocupações já exibidas na página. null = preço ainda não entra na tela. */
  ocupacoes?: { nome: string; pessoas: number; precoPessoa: number }[] | null;
  lp: string;
  promessa: string;
}
const p = Astro.props;
const pacote = PACOTES[p.pacoteId];
const ocupacoes = p.ocupacoes === undefined ? pacote.ocupacoes : p.ocupacoes;
const fim = pacote.checkIn;
const WA = `https://wa.me/${SITE.contact.whatsapp}`;
const brl = (n: number) => n.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL', maximumFractionDigits: 0 });
const mensagemBase = `Oi! Dúvida sobre ${pacote.nome}.`;
---

<main class="ck">
  <form id="ck" class="ck-caixa" data-wa={WA} data-fim={fim} data-pacote={pacote.nome} data-pacote-id={pacote.id} data-min={pacote.noites}
    data-sinal={pacote.sinalPct} data-pornoite={pacote.porNoite ? 1 : 0} data-max={pacote.maxHospedes} data-fixas={pacote.datasFixas ? 1 : undefined} data-bangalos={pacote.totalBangalos}
    data-publicado={pacote.publicado && ocupacoes ? 1 : 0}>
    <div class="ck-topo">
      <a href="/pt/" class="ck-marca">Villa Arapiuns · Rio Arapiuns, Pará</a>
      <WhatsappFlutuante mensagem={mensagemBase} />
    </div>
    <h1 class="ck-h1">{pacote.nome}</h1>
    <p class="ck-promessa">{p.promessa}</p>
    <p class="ck-escassez"><span>{pacote.datas}</span> · <strong>Vagas limitadas.</strong></p>
    <p class="ck-capacidade">13 bangalôs, até 26 hóspedes.</p>

    {pacote.datasFixas ? (
      <input type="hidden" name="chegada" value={pacote.checkIn} /><input type="hidden" name="noites" value={pacote.noites} />
    ) : (
      <div class="ck-linha">
        <label><span>Chegada (check-in)</span><input type="date" name="chegada" min={pacote.checkIn} value={pacote.checkIn} /></label>
        <label><span>Quantas noites? (mín. {pacote.noites})</span><input type="number" name="noites" min={pacote.noites} value={pacote.noites} /></label>
      </div>
    )}

    <p class="ck-rot">Quantos bangalôs?</p>
    <p class="ck-pessoas" data-pessoas-nota hidden></p>
    {ocupacoes ? (
      <div class="ck-oc">
        {ocupacoes.map((o, i) => (
          <label>
            <span>{o.nome}<small>{brl(o.precoPessoa)}/pessoa{pacote.porNoite ? '/noite' : ''}</small></span>
            <input type="number" inputmode="numeric" name={`oc${i}`} min="0" max={pacote.totalBangalos} value={i === 1 ? 1 : 0} data-pessoas={o.pessoas} data-preco={o.precoPessoa} aria-label={`Bangalôs ${o.nome}`} />
          </label>
        ))}
      </div>
    ) : (
      <p class="ck-nota">O valor deste pacote ainda não está publicado. A distribuição Single, Duplo e Triplo entra aqui quando houver preço. Até lá, a reserva segue no WhatsApp.</p>
    )}
    <div class="ck-linha">
      <label><span>Crianças 0–3 (grátis)</span><input type="number" inputmode="numeric" name="cri03" min="0" max="10" value="0" /></label>
      <label><span>Crianças 4–12 (50%)</span><input type="number" inputmode="numeric" name="cri412" min="0" max="10" value="0" /></label>
    </div>

    <p class="ck-resumo" data-resumo></p>
    <dl class="ck-total">
      <dt>Total do pacote</dt><dd data-total>—</dd>
      <dt>Sinal {pacote.sinalPct}% agora</dt><dd data-sinal-valor class="ck-destaque">—</dd>
    </dl>
    <ul class="ck-condicoes" data-condicoes>
      <li>Café da manhã, almoço e jantar incluídos.</li>
      <li>Cartão de crédito em até 12x, pela InfinitePay (Pix: fale no WhatsApp).</li>
    </ul>
    <p class="ck-devolucao" data-devolucao>Sem disponibilidade, devolução integral do valor.</p>
    <button type="submit" name="modo" value="sinal" class="ck-btn" data-rotulo={`Pagar sinal de ${pacote.sinalPct}%`}>Pagar sinal de {pacote.sinalPct}%</button>
    <p class="ck-estado" data-checkout-estado role="status" hidden></p>
    <p class="ck-prereserva" data-prereserva role="status" hidden>Pré-reserva recebida. Vamos entrar em contato para confirmar a disponibilidade.</p>
    <a data-ja-paguei href={WA} target="_blank" rel="noopener" class="ck-pago">Já paguei: enviar meu comprovante no WhatsApp</a>

    <nav class="ck-links" aria-label="Saiba mais">
      <a href={`${p.lp}#incluido`}>O que está incluído</a>
      <a href={`${p.lp}#chegar`}>Como chegar</a>
      <a href={`${p.lp}#faq`}>Cancelamento</a>
      <a href={`${p.lp}#faq`}>Perguntas frequentes</a>
      <a data-wa-link href={WA} target="_blank" rel="noopener">Falar no WhatsApp</a>
      <a href={`mailto:${SITE.contact.email}`}>{SITE.contact.email}</a>
    </nav>
  </form>
</main>

<script>
  import { limitarNoites } from '@/scripts/noites';
  import { cotar, distribuirPessoas, formatarBRL, interpretarPessoas, PACOTES, reaisDeCentavos, type PacoteFechamento } from '@/lib/fechamento';
  import { contagemDeInputs, linkEstaticoInfinitePay } from '@/lib/checkout';
  import { etiqueta, lerUtm, persistirUtm } from '@/lib/utm';

  const f = document.querySelector<HTMLFormElement>('#ck')!;
  const d = f.dataset;
  const pacote = PACOTES[d.pacoteId as PacoteFechamento['id']];
  const fmt = (x: Date) => x.toLocaleDateString('pt-BR', { timeZone: 'UTC', day: '2-digit', month: '2-digit' });
  const brl = (n: number) => n.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
  const val = (n: string) => Math.max(+((f.elements.namedItem(n) as HTMLInputElement | null)?.value ?? 0) || 0, 0);

  const pessoasParam = interpretarPessoas(new URLSearchParams(location.search).get('pessoas'));
  const dist = distribuirPessoas(pessoasParam, { maxHospedes: +d.max! });
  if (dist.informado) {
    for (const input of f.querySelectorAll<HTMLInputElement>('[data-pessoas]')) {
      const pessoas = +input.dataset.pessoas!;
      input.value = String(pessoas === 1 ? dist.single : pessoas === 2 ? dist.duplo : pessoas === 3 ? dist.triplo : 0);
    }
    const nota = f.querySelector<HTMLElement>('[data-pessoas-nota]')!;
    nota.hidden = false;
    nota.textContent = dist.limitado
      ? `O link pedia ${pessoasParam} pessoas. A casa recebe até ${d.max} hóspedes, em 13 bangalôs. Ajuste à vontade ou fale no WhatsApp.`
      : `Quantidade do link: ${dist.pessoas} ${dist.pessoas === 1 ? 'pessoa' : 'pessoas'}. Você pode mudar Single, Duplo e Triplo.`;
  }

  const utm = (() => { try { return persistirUtm(location.search, sessionStorage); } catch { return {}; } })();
  const marcaDe = () => etiqueta(utm, location.pathname, pacote.id);

  const calc = () => {
    const { chegada: c, noites: n0 } = limitarNoites(f);
    const n = Math.max(n0, +d.min!);
    const inputs = [...f.querySelectorAll<HTMLInputElement>('[data-pessoas]')];
    const contagem = contagemDeInputs(inputs.map((i) => ({ pessoas: +i.dataset.pessoas!, q: +i.value || 0 })), val('cri03'), val('cri412'));
    const cotacao = cotar({ ...pacote, noites: d.pornoite === '1' ? n : pacote.noites }, contagem, 'sinal');
    const datas = isNaN(c.getTime()) ? '' : `check-in ${fmt(c)}, check-out ${fmt(new Date(c.getTime() + n * 864e5))}`;
    const resumo = `${d.fixas ? '' : datas + ' · '}${cotacao.linhas.join(' + ') || 'escolha os bangalôs'} · ${n} noites · ${cotacao.pessoas} pessoas`;
    f.querySelector('[data-resumo]')!.textContent = resumo;
    const excede = cotacao.motivo === 'capacidade';
    f.querySelector('[data-total]')!.textContent = excede ? 'Para mais bangalôs ou pessoas, fale com a gente no WhatsApp' : cotacao.ok ? formatarBRL(cotacao.totalCentavos) : '—';
    f.querySelector('[data-sinal-valor]')!.textContent = cotacao.ok ? formatarBRL(cotacao.sinalCentavos) : '—';
    const msg = `Oi! ${d.pacote}, ${datas}: ${resumo}.`;
    const marca = marcaDe();
    const comMarca = marca ? `${msg} ${marca}` : msg;
    f.querySelector<HTMLAnchorElement>('[data-wa-link]')!.href = `${d.wa}?text=${encodeURIComponent(comMarca)}`;
    f.querySelector<HTMLAnchorElement>('[data-ja-paguei]')!.href = `${d.wa}?text=${encodeURIComponent(`Paguei! ${comMarca} Segue o comprovante.`)}`;
    document.dispatchEvent(new CustomEvent('va-resumo', { detail: { mensagem: `Oi! Dúvida sobre ${d.pacote}. ${resumo}.` } }));
    return { cotacao, resumo, msg: comMarca, datas };
  };
  f.addEventListener('input', calc); calc();

  const pre = f.querySelector<HTMLElement>('[data-prereserva]')!;
  const estado = f.querySelector<HTMLElement>('[data-checkout-estado]')!;
  f.querySelector('[data-ja-paguei]')!.addEventListener('click', () => { pre.hidden = false; });

  f.addEventListener('submit', (e) => {
    e.preventDefault();
    const { cotacao, msg } = calc();
    const modo = 'sinal' as const;
    const url = cotacao.ok ? linkEstaticoInfinitePay(reaisDeCentavos(cotacao.sinalCentavos)) : null;
    (window as unknown as { gtag?: (...args: unknown[]) => void }).gtag?.('event', 'click_reservar', {
      pacote: d.pacote, modo, destino: url ? 'infinitepay' : 'whatsapp', pagina: location.pathname, transport_type: 'beacon',
    });
    if (!url) {
      pre.hidden = false;
      window.open(`${d.wa}?text=${encodeURIComponent(msg)}`, '_blank', 'noopener');
      return;
    }
    const valor = reaisDeCentavos(cotacao.sinalCentavos);
    (window as unknown as { gtag?: (...args: unknown[]) => void }).gtag?.('event', 'begin_checkout', {
      currency: 'BRL',
      value: valor,
      items: [{ item_id: `${pacote.id}-sinal`, item_name: pacote.nome, price: valor, quantity: 1 }],
      pacote: pacote.id,
      pagina: location.pathname,
    });
    (window as unknown as { vaPixel?: { initiateCheckout: (x: { value: number; currency: string }) => void } }).vaPixel?.initiateCheckout({
      value: valor, currency: 'BRL',
    });
    pre.hidden = false;
    estado.hidden = true;
    window.open(url, '_blank', 'noopener');
  });
</script>

<style>
  .ck { min-height: 100%; background: var(--color-areia-clara); display: flex; justify-content: center; padding: .6rem .9rem .8rem; }
  .ck-caixa { width: 100%; max-width: 34rem; }
  .ck-topo { position: sticky; top: 0; z-index: 45; display: flex; align-items: center; justify-content: space-between; gap: .75rem; background: var(--color-areia-clara); padding-bottom: .2rem; }
  .ck-marca { font-family: var(--font-label); font-size: .72rem; letter-spacing: .12em; text-transform: uppercase; color: var(--color-areia-funda); }
  .ck-h1 { font-size: 1.65rem; line-height: 1.05; margin-top: .2rem; }
  .ck-promessa { margin-top: .2rem; font-size: .92rem; color: var(--color-mar-fundo); }
  .ck-escassez { margin-top: .3rem; font-size: .85rem; color: var(--color-erro); }
  .ck-capacidade { margin-top: .1rem; font-size: .85rem; color: var(--color-mar); }
  .ck-pessoas { margin-top: .3rem; font-size: .82rem; color: var(--color-mar-fundo); }
  .ck-linha, .ck-oc { display: grid; gap: .4rem; margin-top: .4rem; }
  .ck-linha { grid-template-columns: 1fr 1fr; }
  .ck-oc { grid-template-columns: repeat(3, 1fr); margin-top: .2rem; }
  .ck label > span { display: block; font-family: var(--font-label); font-size: .72rem; text-transform: uppercase; letter-spacing: .05em; color: var(--color-areia-funda); }
  .ck label small { display: block; text-transform: none; letter-spacing: 0; color: var(--color-mar); font-family: var(--font-sans); font-size: .72rem; }
  .ck input { width: 100%; padding: .4rem .5rem; font-size: 1.05rem; border: 1px solid var(--color-areia-sol); background: #fff; color: var(--color-mar-fundo); }
  .ck-total { display: grid; grid-template-columns: 1fr auto; gap: .1rem .5rem; margin-top: .25rem; font-size: .9rem; align-items: baseline; }
  .ck-resumo { margin-top: .45rem; padding-top: .4rem; border-top: 1px solid var(--color-areia-sol); font-size: .78rem; color: var(--color-mar); }
  .ck-rot { margin-top: .45rem; font-weight: 700; font-size: .85rem; color: var(--color-mar-fundo); }
  .ck-total dd { text-align: right; font-weight: 700; }
  .ck-destaque { color: var(--color-ceu); font-size: 1.15rem; }
  .ck-btn { display: block; width: 100%; margin-top: .55rem; padding: .8rem; background: var(--color-ceu); color: #fff; font-weight: 800; font-size: 1.05rem; border-radius: .25rem; }
  .ck-btn:hover { background: var(--color-ceu-hover); }
  .ck-btn:disabled { opacity: .7; }
  .ck-condicoes { margin-top: .45rem; padding-left: 1.1rem; font-size: .85rem; color: var(--color-mar-fundo); display: grid; gap: .15rem; }
  .ck-devolucao { margin-top: .35rem; text-align: center; font-weight: 700; font-size: .85rem; color: var(--color-mar-fundo); }
  .ck-estado, .ck-prereserva { margin-top: .6rem; padding: .7rem; text-align: center; font-weight: 700; background: var(--color-espuma); color: var(--color-mar-fundo); }
  .ck-nota { margin-top: .5rem; font-size: .8rem; text-align: center; color: var(--color-mar-fundo); }
  .ck-pago { display: block; margin-top: .4rem; text-align: center; font-size: .78rem; color: var(--color-mar); text-decoration: underline; }
  .ck-links { display: flex; flex-wrap: wrap; justify-content: center; gap: .35rem .9rem; margin-top: .8rem; font-size: .78rem; }
  @media (max-width: 40rem) {
    .ck { padding: .4rem .7rem .5rem; }
    .ck-h1 { font-size: 1.4rem; }
    .ck-promessa, .ck-escassez, .ck-capacidade, .ck-pessoas { font-size: .8rem; }
    .ck-promessa, .ck-escassez { margin-top: .15rem; }
    .ck-linha, .ck-oc { margin-top: .3rem; gap: .3rem; }
    .ck input { padding: .28rem .4rem; }
    .ck-resumo { margin-top: .3rem; padding-top: .25rem; }
    .ck-rot { margin-top: .3rem; }
    .ck-condicoes { margin-top: .3rem; font-size: .8rem; }
    .ck-devolucao { margin-top: .2rem; font-size: .8rem; }
    .ck-btn { margin-top: .35rem; padding: .65rem; }
  }
  .ck-links a { color: var(--color-ceu); text-decoration: underline; }
</style>
