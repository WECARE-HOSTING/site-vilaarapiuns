---
/**
 * LANDING DE CONVERSÃO (rascunho, noindex) — tráfego do Instagram.
 * Fora do sitemap (/lp/ em urlEntraNoSitemap) e fora do menu.
 * NÃO inventar: preço, sinal, política de cancelamento e bangalôs restantes
 * são placeholders até o Leonardo definir. `restantes` null = não mostra número.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { SITE } from '@/data/site';

interface Item { t: string; d: string }
interface Props {
  slug: string;
  selo: string;
  h1: string;
  promessa: string;
  campo: string[];
  hero: ImageMetadata;
  heroAlt: string;
  inclui: Item[];
  galeria: { src: ImageMetadata; alt: string }[];
  faq: Item[];
  dataMin: string;
  dataMax: string;
  minNoites: number;
  maxNoites: number;
  pacoteNome: string;
  totalBangalos: number;
  restantes: number | null;
  datasFixas?: boolean;
  /** R$ por pessoa/noite. null = [PREÇO A DEFINIR] (botão cai no WhatsApp). */
  precoNoitePessoa: number | null;
  /** % do total cobrado como sinal. null = [SINAL A DEFINIR]. */
  sinalPct: number | null;
  /** Preço do PACOTE por pessoa conforme ocupação do bangalô (substitui precoNoitePessoa). */
  ocupacoes?: { nome: string; pessoas: number; precoPessoa: number }[];
  /** Linhas "não incluído", mostradas na seção de valores. */
  aParte?: string[];
  maxHospedes?: number;
  /** true: precoPessoa das ocupações é por noite (× noites). */
  porNoite?: boolean;
}
const p = Astro.props;
const fim = new Date(Date.parse(p.dataMax + 'T00:00:00Z') + p.minNoites * 864e5).toISOString().slice(0, 10);
const WA = `https://wa.me/${SITE.contact.whatsapp}`;
/** Link público InfinitePay: pay.infinitepay.io/{InfiniteTag}/{valor com vírgula}. Sem valor dá 500. */
const INFINITETAG = 'carlospecucci';
const brl = (n: number) => n.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
const msgPadrao = `Oi! Quero reservar: ${p.pacoteNome}`;
---
<div class="lp">
  <section class="sobre-escuro relative isolate min-h-[88svh] flex items-end text-white">
    <Image src={p.hero} alt={p.heroAlt} widths={[480, 800, 1280, 1920]} sizes="100vw" loading="eager" fetchpriority="high" class="absolute inset-0 -z-10 h-full w-full object-cover" />
    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-mar-fundo/95 via-mar-fundo/60 to-mar-fundo/25 lg:bg-gradient-to-r lg:from-mar-fundo/90 lg:via-mar-fundo/60 lg:to-mar-fundo/20"></div>
    <div class="container-editorial pb-10 pt-28">
      <p class="lp-selo">{p.selo}</p>
      <h1 style="color:#fff;text-shadow:0 2px 16px rgb(0 0 0 / .45)" class="font-display text-4xl sm:text-6xl leading-[1.05] mt-3 max-w-3xl">{p.h1}</h1>
      <p class="mt-5 text-lg sm:text-xl max-w-2xl text-espuma">{p.promessa}</p>
      <ul class="mt-6 flex flex-wrap gap-2">{p.campo.map((c) => <li class="lp-chip">{c}</li>)}</ul>
      {!p.datasFixas && (
        <div data-rapido class="mt-6 grid grid-cols-2 gap-2 max-w-md text-mar-fundo">
          <label class="block"><span class="lp-rotulo" style="color:#fff">Chegada (check-in)</span>
            <input type="date" name="r-chegada" min={p.dataMin} max={p.dataMax} value={p.dataMin} class="lp-campo bg-white" /></label>
          <label class="block"><span class="lp-rotulo" style="color:#fff">Quantas noites? (mín. {p.minNoites})</span>
            <select name="r-noites" class="lp-campo bg-white font-bold">{Array.from({ length: p.maxNoites - p.minNoites + 1 }, (_, i) => p.minNoites + i).map((n) => <option value={n}>{n} noites</option>)}</select></label>
          <p data-rapido-resumo class="col-span-2 text-sm text-espuma"></p>
        </div>
      )}
      <p class={`${p.datasFixas ? 'mt-8' : 'mt-4'} flex flex-wrap gap-3`}>
        <a href="#reservar" class="btn btn-primario">{p.datasFixas ? 'Reservar e pagar' : 'Ver total e pagar'}</a>
        <a href={`${WA}?text=${encodeURIComponent(msgPadrao)}`} class="lp-btn-claro" target="_blank" rel="noopener">Consultar no WhatsApp</a>
      </p>
    </div>
  </section>

  <section class="secao bg-areia" id="incluido">
    <div class="container-editorial">
      <h2 class="font-display text-titulo">O que está incluído</h2>
      <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {p.inclui.map((i) => <li class="lp-card"><h3 class="font-display text-xl text-mar">{i.t}</h3><p class="mt-2">{i.d}</p></li>)}
      </ul>
    </div>
  </section>

  <section class="secao" id="chegar">
    <div class="container-editorial grid gap-10 sm:grid-cols-2 items-center">
      <div>
        <h2 class="font-display text-titulo">Como chegar</h2>
        <ol class="mt-6 space-y-4 list-decimal pl-5">
          <li>Voo até <strong>Santarém (STM)</strong>.</li>
          <li>Estrada até <strong>Alter do Chão</strong> (cerca de 35 km).</li>
          <li><strong>1h30 de barco</strong> de Alter do Chão até a Villa, no Rio Arapiuns.</li>
        </ol>
        <p class="mt-6 text-sm">Dúvidas sobre a chegada? A gente orienta no WhatsApp.</p>
      </div>
      <slot name="chegada" />
    </div>
  </section>

  <section class="secao bg-areia">
    <div class="container-editorial">
      <h2 class="font-display text-titulo">Fotos reais da Villa</h2>
      <div class="mt-8 grid grid-cols-2 gap-3 lg:grid-cols-3">
        {p.galeria.map((g, i) => <Image src={g.src} alt={g.alt} widths={[400, 700, 1000]} sizes="(min-width:1024px) 33vw, 50vw" loading="lazy" decoding="async" class={`w-full object-cover ${i === 0 ? 'col-span-2 aspect-[16/9] lg:row-span-2 lg:aspect-auto lg:h-full' : 'aspect-square'}`} />)}
      </div>
    </div>
  </section>

  <section class="secao" id="preco">
    <div class="container-editorial grid gap-10 lg:grid-cols-2">
      <div>
        <h2 class="font-display text-titulo">Valores</h2>
        {p.ocupacoes ? (
          <table class="mt-4 w-full text-left"><tbody>
            {p.ocupacoes.map((o) => <tr class="border-b border-areia-sol/40"><th class="py-2 font-semibold">{o.nome}</th><td class="py-2 text-right font-display text-2xl text-mar">{brl(o.precoPessoa)}</td></tr>)}
          </tbody></table>
        ) : (
          <p class={`mt-4 text-3xl font-display ${p.precoNoitePessoa ? 'text-mar' : 'text-erro'}`}>{p.precoNoitePessoa ? brl(p.precoNoitePessoa) : '[PREÇO A DEFINIR]'}</p>
        )}
        <p class="mt-2">{p.ocupacoes ? (p.porNoite ? 'por pessoa / noite' : 'por pessoa, pacote completo') : 'por pessoa / noite'} · sinal de {p.sinalPct ?? '[SINAL A DEFINIR]'}% para garantir a vaga, no Pix ou em até 12x no cartão (InfinitePay)</p>
        {p.aParte && <p class="mt-4 text-sm"><strong>À parte:</strong> {p.aParte.join(' · ')}</p>}
        <p class="mt-6 lp-escassez">
          Vagas limitadas: {p.totalBangalos} bangalôs no total
          {p.restantes !== null ? <> · <strong>restam {p.restantes} bangalôs</strong></> : <> · <strong>[RESTANTES A DEFINIR]</strong></>}
        </p>
      </div>

      <form id="reservar" class="lp-card scroll-mt-24" data-wa={WA} data-fim={fim} data-pacote={p.pacoteNome} data-min={p.minNoites} data-tag={INFINITETAG} data-preco={p.precoNoitePessoa ?? ''} data-sinal={p.sinalPct ?? ''} data-pornoite={p.porNoite ? 1 : 0} data-max={p.maxHospedes ?? 26} data-bangalos={p.totalBangalos}>
        <h3 class="font-display text-2xl text-mar">Reservar</h3>
        <label class="block mt-4"><span class="lp-rotulo">Chegada (check-in)</span>
          <input type="date" name="chegada" min={p.dataMin} max={p.dataMax} value={p.dataMin} required class="lp-campo" readonly={p.datasFixas} /></label>
        <div class="grid grid-cols-2 gap-3 mt-3">
          {p.datasFixas ? (<label class="block"><span class="lp-rotulo">Noites</span>
            <input type="number" name="noites" value={p.maxNoites} class="lp-campo" readonly /></label>) : (
          <label class="block"><span class="lp-rotulo">Quantas noites? (mín. {p.minNoites})</span>
            <select name="noites" class="lp-campo">{Array.from({ length: p.maxNoites - p.minNoites + 1 }, (_, i) => p.minNoites + i).map((n) => <option value={n}>{n} noites</option>)}</select></label>)}
          {!p.ocupacoes && <label class="block"><span class="lp-rotulo">Hóspedes</span>
            <input type="number" name="hospedes" min="1" max={p.maxHospedes ?? 26} value="2" class="lp-campo" /></label>}
        </div>
        {p.ocupacoes && <fieldset class="mt-3"><legend class="lp-rotulo">Bangalôs por ocupação</legend>
          <div class="grid grid-cols-3 gap-3 mt-1">{p.ocupacoes.map((o, i) => <label class="block text-sm">{o.nome}<input type="number" name={`oc${i}`} min="0" max={p.totalBangalos} value={i === 1 ? 1 : 0} data-pessoas={o.pessoas} data-preco={o.precoPessoa} class="lp-campo" /></label>)}</div>
          <div class="grid grid-cols-2 gap-3 mt-3">
            <label class="block text-sm">Crianças 0 a 3 anos (grátis)<input type="number" name="cri03" min="0" max="10" value="0" class="lp-campo" /></label>
            <label class="block text-sm">Crianças 4 a 12 anos (50%)<input type="number" name="cri412" min="0" max="10" value="0" class="lp-campo" /></label>
          </div>
          <p class="mt-2 text-xs">Crianças ficam no bangalô dos pais; a partir de 13 anos contam como adulto. Máximo {p.maxHospedes ?? 26} pessoas.</p>
        </fieldset>}
        <p class="mt-3 text-sm lp-escassez" data-grupo>Vem em grupo grande ou quer a Villa exclusiva? <a class="underline" target="_blank" rel="noopener" href={`${WA}?text=${encodeURIComponent('Oi! Quero cotar ' + p.pacoteNome + ' para grupo grande / Villa exclusiva.')}`}>Fale com a gente no WhatsApp</a>.</p>
        <p class="mt-3 text-sm" data-saida></p>
        <dl class="mt-4 grid grid-cols-2 gap-y-1 text-sm">
          <dt>Total estimado</dt><dd class="text-right font-semibold" data-total>[PREÇO A DEFINIR]</dd>
          <dt>Sinal agora</dt><dd class="text-right font-semibold text-mar" data-sinal-valor>[SINAL A DEFINIR]</dd>
        </dl>
        <button type="submit" name="modo" value="sinal" class="btn btn-primario w-full mt-5">Reservar e pagar o sinal</button>
        <button type="submit" name="modo" value="total" class="w-full mt-2 py-3 border border-ceu text-ceu font-semibold">Pagar o valor total</button>
        <p class="mt-2 text-xs text-center">Sinal ou total: no Pix ou em até 12x no cartão, pela InfinitePay.</p>
        <a data-wa-link href={`${WA}?text=${encodeURIComponent(msgPadrao)}`} target="_blank" rel="noopener" class="block text-center mt-3 underline">Prefiro falar no WhatsApp</a>
        <p class="mt-3 text-xs">O sinal garante a reserva. Se não houver disponibilidade, devolvemos o valor integral. Cancelamento: reembolso de 100% até 30 dias antes do check-in, 50% de 29 a 15 dias, sem reembolso a 14 dias ou menos (ou no-show). <a href="#faq" class="underline">Ver política completa</a>.</p>
      </form>
    </div>
  </section>

  <section class="secao bg-areia" id="faq">
    <div class="container-editorial max-w-3xl">
      <h2 class="font-display text-titulo">Perguntas frequentes</h2>
      <div class="mt-6 divide-y divide-areia-sol/40">
        {p.faq.map((f) => <details class="py-4"><summary class="cursor-pointer font-semibold text-mar">{f.t}</summary><p class="mt-2">{f.d}</p></details>)}
      </div>
    </div>
  </section>

  <a href="#reservar" class="lp-sticky sm:hidden">Reservar com sinal</a>
</div>

<script>
  import { limitarNoites } from '@/scripts/noites';
  const f = document.querySelector<HTMLFormElement>('#reservar');
  const r = document.querySelector<HTMLElement>('[data-rapido]');
  if (f && r) {
    // seletor do hero (acima da dobra) espelha o formulário completo
    const rc = r.querySelector<HTMLInputElement>('[name=r-chegada]')!, rn = r.querySelector<HTMLSelectElement>('[name=r-noites]')!;
    const sync = () => {
      (f.elements.namedItem('chegada') as HTMLInputElement).value = rc.value;
      (f.elements.namedItem('noites') as HTMLSelectElement).value = rn.value;
      f.dispatchEvent(new Event('input'));
      rc.value = (f.elements.namedItem('chegada') as HTMLInputElement).value;
      const fs = f.querySelector<HTMLSelectElement>('select[name=noites]')!;
      [...rn.options].forEach((o, i) => (o.disabled = fs.options[i].disabled));
      rn.value = fs.value;
      r.querySelector('[data-rapido-resumo]')!.textContent = `${f.querySelector('[data-saida]')!.textContent} · ${f.querySelector('[data-total]')!.textContent}`;
    };
    rc.addEventListener('input', sync); rn.addEventListener('input', sync);
    f.addEventListener('input', (e) => { if (e.isTrusted) queueMicrotask(() => { rc.value = (f.elements.namedItem('chegada') as HTMLInputElement).value; rn.value = (f.elements.namedItem('noites') as HTMLSelectElement).value; [...rn.options].forEach((o, i) => (o.disabled = (f.querySelector<HTMLSelectElement>('select[name=noites]')!).options[i].disabled)); r.querySelector('[data-rapido-resumo]')!.textContent = `${f.querySelector('[data-saida]')!.textContent} · ${f.querySelector('[data-total]')!.textContent}`; }); });
    queueMicrotask(sync);
  }
  if (f) {
    const d = f.dataset;
    const fmt = (x: Date) => x.toLocaleDateString('pt-BR', { timeZone: 'UTC', day: '2-digit', month: '2-digit' });
    const brl = (n: number) => n.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
    const calc = () => {
      const { chegada: c, noites: n0 } = limitarNoites(f);
      const n = Math.max(n0, +d.min!);
      const oc = [...f.querySelectorAll<HTMLInputElement>('[data-pessoas]')];
      let h = f.hospedes ? Math.max(+f.hospedes.value || 1, 1) : 0;
      let pacote = 0, bang = 0;
      for (const i of oc) { const q = Math.max(+i.value || 0, 0); bang += q; h += q * +i.dataset.pessoas!; pacote += q * +i.dataset.pessoas! * +i.dataset.preco! * (d.pornoite === '1' ? n : 1); }
      // Criança 4–12 paga 50% da diária da ocupação mais barata escolhida (fica no bangalô dos pais).
      const c03 = Math.max(+(f.cri03?.value ?? 0) || 0, 0), c412 = Math.max(+(f.cri412?.value ?? 0) || 0, 0);
      const escolhidas = oc.filter((i) => +i.value > 0).map((i) => +i.dataset.preco!);
      if (oc.length && c412 && escolhidas.length) pacote += c412 * Math.min(...escolhidas) * 0.5 * (d.pornoite === '1' ? n : 1);
      h += c03 + c412;
      const grupo = f.querySelector<HTMLElement>('[data-grupo]')!;
      grupo.style.fontWeight = h > 15 ? '700' : '';
      const excede = oc.length > 0 && (bang > +d.bangalos! || h > +d.max!);
      const s = new Date(c.getTime() + n * 864e5);
      f.querySelector('[data-saida]')!.textContent = isNaN(c.getTime()) ? '' : `Check-in ${fmt(c)} · Check-out ${fmt(s)} · ${n} noites · ${h} pessoas`;
      const total = oc.length ? (excede || !pacote ? null : pacote) : d.preco ? +d.preco * n * h : null;
      if (excede) f.querySelector('[data-total]')!.textContent = `Acima de ${d.bangalos} bangalôs / ${d.max} pessoas`;
      const sinal = total && d.sinal ? Math.round(total * +d.sinal) / 100 : null;
      if (total) f.querySelector('[data-total]')!.textContent = brl(total);
      if (sinal) f.querySelector('[data-sinal-valor]')!.textContent = brl(sinal);
      const msg = `Oi! Quero reservar ${d.pacote}: check-in ${isNaN(c.getTime()) ? '' : fmt(c)}, check-out ${isNaN(c.getTime()) ? '' : fmt(s)}, ${n} noites, ${h} pessoas.`;
      f.querySelector<HTMLAnchorElement>('[data-wa-link]')!.href = `${d.wa}?text=${encodeURIComponent(msg)}`;
      return { msg, sinal, total };
    };
    f.addEventListener('input', calc); calc();
    f.addEventListener('submit', (e) => {
      e.preventDefault();
      const { msg, sinal, total } = calc();
      const modo = ((e as SubmitEvent).submitter as HTMLButtonElement | null)?.value;
      const valor = modo === 'total' ? total : sinal;
      const url = valor
        ? `https://pay.infinitepay.io/${d.tag}/${valor.toFixed(2).replace('.', ',')}`
        : `${d.wa}?text=${encodeURIComponent(msg)}`; // sem preço definido: cai no WhatsApp
      window.open(url, '_blank', 'noopener');
    });
  }
</script>

<style>
  .lp-selo { font-family: var(--font-label); text-transform: uppercase; letter-spacing: .12em; color: var(--color-sol); font-size: .85rem; }
  .lp-chip { border: 1px solid rgb(255 255 255 / .5); padding: .3rem .7rem; font-size: .9rem; }
  .lp-btn-claro { display: inline-flex; align-items: center; padding: .85rem 1.3rem; border: 1px solid #fff; color: #fff; font-weight: 600; }
  .lp-card { background: var(--color-areia-clara); border: 1px solid color-mix(in srgb, var(--color-areia-sol) 40%, transparent); padding: 1.5rem; }
  .lp-rotulo { font-family: var(--font-label); font-size: .8rem; text-transform: uppercase; letter-spacing: .08em; color: var(--color-areia-funda); }
  .lp-campo { display: block; width: 100%; margin-top: .25rem; padding: .7rem; border: 1px solid var(--color-areia-sol); background: #fff; color: var(--color-mar-fundo); font-size: 1rem; }
  .lp-escassez { border-left: 3px solid var(--color-areia-sol); padding-left: .8rem; }
  .lp-sticky { position: fixed; left: 1rem; right: 1rem; bottom: max(1rem, env(safe-area-inset-bottom)); z-index: 50; background: var(--color-ceu); color: #fff; text-align: center; font-weight: 700; padding: 1rem; box-shadow: 0 6px 20px rgb(0 0 0 / .25); }
  .lp { padding-bottom: 5rem; }
  @media (min-width: 640px) { .lp { padding-bottom: 0; } }
</style>
