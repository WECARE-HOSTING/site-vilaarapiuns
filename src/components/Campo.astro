---
/**
 * Marcador de seção.
 *
 * Substitui o olho de seção com tracinho — aquele rótulo em caixa alta que
 * abre toda seção de todo site gerado por IA. Aqui o marcador carrega
 * DADO DE CAMPO verdadeiro: coordenada, tempo de barco, número de
 * bangalôs, horário. A Villa é remota; a distância é o produto.
 */
interface Props { class?: string }
const { class: className = '' } = Astro.props;
---
<p class:list={['numero etiqueta flex flex-wrap items-center gap-x-3 gap-y-1', className]}>
  <slot />
</p>
