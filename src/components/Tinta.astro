---
/**
 * A régua de tinta — único divisor do site.
 *
 * O símbolo do logo é um traço de pincel, com tremor e pressão variável.
 * Um filete de 1px perfeito é o oposto disso, e é o que denuncia site
 * gerado por máquina. Esta linha é desenhada: ondula de leve, tem as
 * pontas afinadas e uma segunda passada fantasma, como caneta no papel.
 *
 * O SVG estica na largura mas a espessura não acompanha
 * (vector-effect), então o traço fica igual em qualquer tela.
 */
interface Props { class?: string; tone?: 'escuro' | 'claro' | 'rede'; peso?: 'fino' | 'medio' }
const { class: className = '', tone = 'escuro', peso = 'fino' } = Astro.props;

const cor = { escuro: 'text-mata/35', claro: 'text-areia/30', rede: 'text-rede/45' }[tone];
const largura = peso === 'medio' ? 1.9 : 1.2;

// Traçado irregular de propósito: nenhum vale tem a mesma profundidade.
const traco = 'M1,5.4 C58,3.1 118,6.4 186,4.2 S318,2.6 402,5.6 S536,6.8 622,3.9 S758,2.8 842,5.7 S974,6.5 1058,4.1 S1152,5.1 1199,4.7';
const fantasma = 'M3,6.1 C64,4.4 126,7.0 192,5.3 S326,3.9 408,6.4 S540,7.4 628,5.1 S764,4.1 848,6.5 S978,7.2 1062,5.3 S1156,6.0 1197,5.6';
---

<svg
  viewBox="0 0 1200 9"
  preserveAspectRatio="none"
  aria-hidden="true"
  class:list={['block h-2 w-full', cor, className]}
  fill="none"
>
  <path d={fantasma} stroke="currentColor" stroke-width={largura * 0.6} stroke-linecap="round" opacity="0.4" vector-effect="non-scaling-stroke" />
  <path d={traco} stroke="currentColor" stroke-width={largura} stroke-linecap="round" vector-effect="non-scaling-stroke" />
</svg>
