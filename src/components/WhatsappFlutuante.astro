---
import { SITE } from '@/data/site';

interface Props {
  /** Texto base, sem a etiqueta de origem. O script acrescenta a etiqueta da sessão. */
  mensagem: string;
}
const { mensagem } = Astro.props;
const href = `https://wa.me/${SITE.contact.whatsapp}?text=${encodeURIComponent(mensagem)}`;
---

<a
  class="wa-flutuante"
  data-wa-flutuante
  data-mensagem={mensagem}
  href={href}
  target="_blank"
  rel="noopener noreferrer"
>
  <span class="wa-flutuante__icone" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor">
      <path d="M12.04 2C6.58 2 2.15 6.4 2.15 11.83c0 1.74.46 3.44 1.34 4.94L2 22l5.39-1.4a10 10 0 0 0 4.65 1.18h.01c5.46 0 9.89-4.4 9.89-9.84C21.94 6.4 17.5 2 12.04 2zm5.76 14.15c-.24.68-1.4 1.3-1.94 1.38-.5.07-1.12.1-1.81-.11-.41-.13-.95-.31-1.63-.61-2.86-1.24-4.73-4.12-4.87-4.31-.14-.19-1.16-1.54-1.16-2.94s.73-2.08 1-2.37c.24-.27.64-.4 1.02-.4.12 0 .23 0 .33.01.3.01.44.03.64.49.24.57.82 1.98.89 2.12.07.15.12.32.02.51-.09.19-.14.31-.28.48-.14.16-.29.36-.41.48-.14.13-.28.28-.12.54.16.27.71 1.17 1.52 1.89 1.05.93 1.93 1.22 2.2 1.36.28.14.44.12.6-.07.16-.19.7-.81.88-1.09.19-.27.37-.23.62-.14.26.09 1.62.76 1.9.9.27.14.46.2.52.32.07.12.07.68-.17 1.36z"/>
    </svg>
  </span>
  WhatsApp
</a>

<script>
  import { comEtiqueta, etiqueta, lerUtm } from '@/lib/utm';

  const aplicar = () => {
    let marca = '';
    try { marca = etiqueta(lerUtm(sessionStorage), location.pathname); } catch { /* sessão indisponível */ }
    for (const a of document.querySelectorAll<HTMLAnchorElement>('[data-wa-flutuante]')) {
      const base = a.dataset.mensagem || '';
      const texto = marca && !base.includes(marca) ? `${base} ${marca}`.trim() : base;
      const u = new URL(a.href);
      u.searchParams.set('text', texto);
      a.href = comEtiqueta(u.toString(), marca);
    }
  };
  aplicar();
  document.addEventListener('va-resumo', (e) => {
    const detalhe = (e as CustomEvent<{ mensagem?: string }>).detail;
    if (!detalhe?.mensagem) return;
    for (const a of document.querySelectorAll<HTMLAnchorElement>('[data-wa-flutuante]')) {
      a.dataset.mensagem = detalhe.mensagem;
    }
    aplicar();
  });
</script>

<style>
  .wa-flutuante {
    position: relative;
    z-index: 45;
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    margin-left: auto;
    width: fit-content;
    padding: .55rem .9rem;
    background: var(--color-ceu);
    color: #fff;
    font-weight: 700;
    font-size: .95rem;
    border-radius: 999px;
    box-shadow: 0 8px 24px rgb(13 50 68 / .28);
  }
  .wa-flutuante:hover { background: var(--color-ceu-hover); color: #fff; }
  .wa-flutuante__icone { display: flex; }
</style>
