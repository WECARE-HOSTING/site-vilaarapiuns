---
/**
 * ELEMENTO-ASSINATURA DO SITE — "a linha do dia".
 *
 * O produto da Villa não é uma lista de atrações: é um dia inteiro,
 * organizado, do café ao fogo. Desenhar isso como um rio que desce a
 * página faz três coisas de uma vez:
 *   1. prova que existe estrutura e equipe (é uma pousada, não excursão);
 *   2. resolve visualmente a confusão sobre o que está incluso —
 *      cada momento diz se é incluso ou opcional, ali mesmo;
 *   3. é a única coisa do site que ninguém mais tem.
 */
interface Momento {
  hora: string;
  titulo: string;
  detalhe?: string;
  /** incluso = pago no pacote · comunidade = pago à família ribeirinha */
  tipo?: 'incluso' | 'comunidade';
  refeicao?: boolean;
}

interface Props {
  momentos: Momento[];
  rotulos: { incluso: string; comunidade: string };
  tone?: 'claro' | 'escuro';
}

const { momentos, rotulos, tone = 'claro' } = Astro.props;
const escuro = tone === 'escuro';
---

<ol class:list={['relative', escuro ? 'text-salvia' : 'text-mata-funda']}>
  {/* o rio: traçado à mão, com meandro — não um filete de 1px */}
  <svg
    viewBox="0 0 10 400"
    preserveAspectRatio="none"
    aria-hidden="true"
    class:list={[
      'pointer-events-none absolute left-[3.9rem] top-4 bottom-4 w-2.5 sm:left-[5.15rem]',
      escuro ? '' : 'text-ouro/70',
    ]}
    fill="none"
  >
    <path
      d="M5,0 C7.4,26 2.8,52 5.2,78 S7.8,130 4.6,156 S2.4,208 5.4,234 S7.6,286 4.4,312 S2.6,364 5,400"
      stroke="currentColor"
      stroke-width="1.3"
      stroke-linecap="round"
      vector-effect="non-scaling-stroke"
    />
  </svg>

  {momentos.map((m) => (
    <li class="relative grid grid-cols-[3.5rem_1.5rem_1fr] items-start gap-x-3 py-3.5 sm:grid-cols-[4.5rem_2rem_1fr] sm:gap-x-4">
      <time class:list={['numero pt-0.5 text-right text-sm', escuro ? '' : '']}>
        {m.hora}
      </time>

      <span class="relative flex justify-center pt-2" aria-hidden="true">
        {/* refeição = círculo cheio · comunidade = anel âmbar · demais = ponto pequeno */}
        {m.refeicao ? (
          <span class:list={['block h-2.5 w-2.5 rounded-full', escuro ? 'bg-mata' : 'bg-ouro']}></span>
        ) : m.tipo === 'comunidade' ? (
          <span class="block h-2.5 w-2.5 rounded-full border-2 border-terra-luz bg-transparent"></span>
        ) : (
          <span class:list={['block h-1.5 w-1.5 rounded-full', escuro ? 'bg-mata/50' : 'bg-ouro/50']}></span>
        )}
      </span>

      <div class="min-w-0">
        <p class="leading-snug">
          <span class:list={[m.refeicao ? 'font-medium' : '']}>{m.titulo}</span>
          {m.tipo === 'comunidade' && (
            <span class="etiqueta ml-2 whitespace-nowrap align-middle text-terra-luz">{rotulos.comunidade}</span>
          )}
        </p>
        {m.detalhe && (
          <p class:list={['mt-0.5 text-sm', escuro ? '' : '']}>{m.detalhe}</p>
        )}
      </div>
    </li>
  ))}
</ol>

<p class:list={['mt-6 flex flex-wrap items-center gap-x-6 gap-y-2 border-t pt-4 text-sm',
  escuro ? 'border-salvia/15' : 'emenda']}>
  <span class="flex items-center gap-2">
    <span class:list={['h-2.5 w-2.5 rounded-full', escuro ? 'bg-mata' : 'bg-ouro']}></span>
    {rotulos.incluso}
  </span>
  <span class="flex items-center gap-2">
    <span class="h-2.5 w-2.5 rounded-full border-2 border-terra-luz"></span>
    {rotulos.comunidade}
  </span>
</p>
