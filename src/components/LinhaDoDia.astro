---
/**
 * ELEMENTO-ASSINATURA DO SITE — "a linha do dia".
 *
 * O produto da Villa não é uma lista de atrações: é um dia inteiro,
 * organizado, do café ao fogo. Desenhar isso como um rio que desce a
 * página faz três coisas de uma vez:
 *   1. prova que existe estrutura e equipe (é uma pousada, não excursão);
 *   2. resolve visualmente a confusão sobre o que está incluso —
 *      cada momento diz se é incluso ou opcional, ali mesmo;
 *   3. é a única coisa do site que ninguém mais tem.
 */
interface Momento {
  hora: string;
  titulo: string;
  detalhe?: string;
  /** incluso = pago no pacote · comunidade = pago à família ribeirinha */
  tipo?: 'incluso' | 'comunidade';
  refeicao?: boolean;
}

interface Props {
  momentos: Momento[];
  rotulos: { incluso: string; comunidade: string };
  tone?: 'claro' | 'escuro';
}

const { momentos, rotulos, tone = 'claro' } = Astro.props;
const escuro = tone === 'escuro';
---

<ol data-linha-do-dia class:list={['relative', escuro ? '' : '']}>
  {/* o rio: traçado à mão, com meandro — não um filete de 1px */}
  <svg
    viewBox="0 0 10 400"
    preserveAspectRatio="none"
    aria-hidden="true"
    class:list={[
      'pointer-events-none absolute left-[3.9rem] top-4 bottom-4 w-2.5 sm:left-[5.15rem]',
      escuro ? 'text-sol/60' : 'text-ceu/55',
    ]}
    fill="none"
  >
    <path
      d="M5,0 C7.4,26 2.8,52 5.2,78 S7.8,130 4.6,156 S2.4,208 5.4,234 S7.6,286 4.4,312 S2.6,364 5,400"
      stroke="currentColor"
      stroke-width="1.3"
      stroke-linecap="round"
      vector-effect="non-scaling-stroke"
    />
  </svg>

  {momentos.map((m) => (
    <li class="momento-reel relative grid grid-cols-[3.5rem_1.5rem_1fr] items-start gap-x-3 py-3.5 sm:grid-cols-[4.5rem_2rem_1fr] sm:gap-x-4">
      <time class:list={['numero pt-0.5 text-right text-sm', escuro ? '' : '']}>
        {m.hora}
      </time>

      <span class="relative flex justify-center pt-2" aria-hidden="true">
        {/* refeição = círculo cheio · comunidade = anel âmbar · demais = ponto pequeno */}
        {m.refeicao ? (
          <span class:list={['block h-2.5 w-2.5 rounded-full', escuro ? 'bg-sol' : 'bg-ceu']}></span>
        ) : m.tipo === 'comunidade' ? (
          <span class="block h-2.5 w-2.5 rounded-full border-2 border-coral-luz bg-transparent"></span>
        ) : (
          <span class:list={['block h-1.5 w-1.5 rounded-full', escuro ? 'bg-sol/50' : 'bg-ceu/50']}></span>
        )}
      </span>

      <div class="min-w-0">
        <p class="leading-snug">
          <span class:list={[m.refeicao ? 'font-medium' : '']}>{m.titulo}</span>
          {m.tipo === 'comunidade' && (
            <span class="etiqueta ml-2 whitespace-nowrap align-middle text-coral-luz">{rotulos.comunidade}</span>
          )}
        </p>
        {m.detalhe && (
          <p class:list={['mt-0.5 text-sm', escuro ? '' : '']}>{m.detalhe}</p>
        )}
      </div>
    </li>
  ))}
</ol>

<p class:list={['mt-6 flex flex-wrap items-center gap-x-6 gap-y-2 border-t pt-4 text-sm',
  escuro ? 'border-espuma/15' : 'emenda']}>
  <span class="flex items-center gap-2">
    <span class:list={['h-2.5 w-2.5 rounded-full', escuro ? 'bg-sol' : 'bg-ceu']}></span>
    {rotulos.incluso}
  </span>
  <span class="flex items-center gap-2">
    <span class="h-2.5 w-2.5 rounded-full border-2 border-coral-luz"></span>
    {rotulos.comunidade}
  </span>
</p>

<style>
  /* Fase 5 — a única peça do site batizada de movimento ("o rio que desce a
     página") e a única sem nenhum. Padrão: visível por padrão (seguro sem
     JS); o script liga [data-reveal-pronto] e É NELE que os momentos ficam
     transparentes — sem essa classe, nada muda. A curva é a mesma das
     polaroides de ListaExperiencias (cubic-bezier(0.16,1,0.3,1)), reusada
     de propósito: é a curva de revelação que o site já tem, não uma nova. */
  [data-reveal-pronto] .momento-reel {
    opacity: 0;
    translate: 0 12px;
    transition: opacity 550ms cubic-bezier(0.16, 1, 0.3, 1),
                translate 550ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  [data-reveal-pronto][data-reveal-visivel] .momento-reel {
    opacity: 1;
    translate: 0 0;
  }
  /* nth-of-type, não nth-child: o <svg> do meandro é o primeiro irmão do
     <ol>, e nth-child contaria a partir dele. */
  .momento-reel:nth-of-type(1) { transition-delay: 0ms; }
  .momento-reel:nth-of-type(2) { transition-delay: 60ms; }
  .momento-reel:nth-of-type(3) { transition-delay: 120ms; }
  .momento-reel:nth-of-type(4) { transition-delay: 180ms; }
  .momento-reel:nth-of-type(5) { transition-delay: 240ms; }
  .momento-reel:nth-of-type(6) { transition-delay: 300ms; }
  .momento-reel:nth-of-type(7) { transition-delay: 360ms; }
  .momento-reel:nth-of-type(8) { transition-delay: 420ms; }
  .momento-reel:nth-of-type(n+9) { transition-delay: 480ms; }
</style>

<script>
  /* prefers-reduced-motion: nunca liga [data-reveal-pronto] — os momentos
     ficam no estado padrão (visível), que é o mesmo que "mais suave", não
     "zerado": a informação nunca se move, só deixa de ter entrada. */
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const linhas = document.querySelectorAll<HTMLOListElement>('[data-linha-do-dia]');
    linhas.forEach((linha) => {
      linha.dataset.revealPronto = '';
      const observador = new IntersectionObserver(
        ([entrada]) => {
          if (entrada.isIntersecting) {
            linha.dataset.revealVisivel = '';
            observador.disconnect();
          }
        },
        { threshold: 0.15 }
      );
      observador.observe(linha);
    });
  }
</script>
