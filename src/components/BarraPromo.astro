---
/** Barra fina no topo de todas as páginas PT (01/11/2026). Some nas páginas de
 * pagamento, na LP do Detox (o texto dela traz "areia branca" e "Vagas
 * limitadas", que essa página não publica) e depois da janela dos pacotes.
 * Uma linha no celular. Na página de conteúdo do Detox o HTML fica o de antes. */
const caminho = Astro.url.pathname;
const agora = new Date();
const rev = agora < new Date('2027-01-03T00:00:00-03:00');
const det = agora < new Date('2027-01-11T00:00:00-03:00');
const mostra = caminho.startsWith('/pt/') && !caminho.startsWith('/pt/lp/pagar-') && !caminho.startsWith('/pt/lp/detox-pos-reveillon') && (rev || det);
const preservarDetox = caminho.startsWith('/pt/detox');
const naRotaReveillon = caminho === '/pt/reveillon/' || caminho.startsWith('/pt/lp/reveillon/');
const faixaDesktop = naRotaReveillon
  ? 'Vire o ano na água cristalina do Rio Arapiuns.'
  : 'Vire o ano na areia branca do Rio Arapiuns. Vagas limitadas.';
const linkRev = (origem) => `/pt/lp/pagar-reveillon/?${new URLSearchParams({ utm_source: 'site', utm_medium: 'cta', utm_campaign: 'reveillon2026', utm_content: origem })}`;
---
{mostra && preservarDetox && (
  <div class="barra-promo" role="region" aria-label="Pacotes de virada">
    <span class="hidden sm:inline">Vire o ano na areia branca do Rio Arapiuns. Vagas limitadas.</span>
    <span class="sm:hidden">Réveillon e Detox no Arapiuns</span>
    {rev && <a href="/pt/lp/pagar-reveillon/" data-promo="reveillon" data-promo-acao="pagar" data-promo-origem="barra">Garanta o Réveillon</a>}
    {det && <a href="/pt/lp/pagar-detox/" data-promo="detox" data-promo-acao="pagar" data-promo-origem="barra">Garanta o Detox</a>}
  </div>
)}
{mostra && !preservarDetox && (
  <div class="barra-promo" role="region" aria-label="Pacotes de virada">
    <span class="hidden sm:inline">{faixaDesktop}</span>
    <span class="sm:hidden">Réveillon e Detox no Arapiuns</span>
    {rev && <a href={linkRev('barra-promo')} data-promo="reveillon" data-promo-acao="pagar" data-promo-origem="barra">Reserve pelo link</a>}
    {det && <a href="/pt/lp/pagar-detox/" data-promo="detox" data-promo-acao="pagar" data-promo-origem="barra">Garanta o Detox</a>}
  </div>
)}
<style>
  .barra-promo { background: var(--color-ceu); color: #fff; font-size: .875rem; line-height: 1.3; padding: .5rem 1rem; display: flex; gap: .4rem 1rem; justify-content: center; align-items: center; flex-wrap: wrap; text-align: center; position: relative; z-index: 60; }
  .barra-promo a { color: #fff; font-weight: 600; text-decoration: underline; text-underline-offset: .2em; white-space: nowrap; }
</style>
