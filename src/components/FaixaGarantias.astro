---
/**
 * A promessa da Villa, repetida em toda página logo abaixo do topo.
 * Existe porque o visitante estrangeiro precisa saber, em 3 segundos,
 * que isto é uma pousada com estrutura — e não um passeio de um dia.
 */
import { useTranslations } from '@/i18n/utils';
import Voluta from '@/components/Voluta.astro';
import type { Locale } from '@/i18n/config';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);

// 4 itens, não 5: `years` afirmava "5+ anos, zero incidentes" sem nenhum dado
// por trás (yearFounded é null e o site antigo dizia 4 anos). Removido em
// PRODUCT.md como decisão aberta. 4 também cabe na memória de trabalho.
// 11/10/2026 (decisão do Leonardo): saíram `fullBoard` ("Todas as refeições
// incluídas") e `boat` ("Barco de Alter do Chão nos pacotes"). Numa faixa que
// aparece em toda página, as duas frases não diziam de qual modalidade falavam.
// O que está incluído em cada estadia a Gabriela explica no WhatsApp; os cards
// de Pousada e Pacote continuam com a lista própria de cada um.
const itens = ['team', 'host', 'power', 'mosquito'] as const; // 12/10/2026: energia 24h + Starlink e mosquito (aprovado pelo Leonardo)
---

<div class="emenda border-y">
  <ul class="container-editorial flex flex-wrap items-center justify-center gap-x-6 gap-y-2.5 py-3.5 sm:gap-x-12">
    {itens.map((k) => (
      <li class="flex items-center gap-2.5">
        <Voluta class="text-areia-sol" />
        <span class="etiqueta">{t(`trust.${k}`)}</span>
      </li>
    ))}
  </ul>
</div>
