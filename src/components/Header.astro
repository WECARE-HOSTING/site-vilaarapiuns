---
import Logo from '@/components/Logo.astro';
import { LOCALES, LOCALE_NAMES, HTML_LANG, type Locale } from '@/i18n/config';
import { NAV_KEYS, href, type PageKey } from '@/i18n/routes';
import { useTranslations } from '@/i18n/utils';

interface Props {
  locale: Locale;
  pageKey: PageKey;
  /** Sobre foto de tela cheia o cabeçalho começa transparente. */
  sobreFoto?: boolean;
}

const { locale, pageKey, sobreFoto = false } = Astro.props;
const t = useTranslations(locale);
---

<header
  id="cabecalho"
  data-sobre-foto={sobreFoto ? '' : null}
  class:list={[
    'fixed inset-x-0 top-0 z-50 transition-[background-color,border-color,padding] duration-300',
    'border-b py-4',
    sobreFoto
      ? 'bg-transparent border-transparent text-areia'
      : 'bg-areia border-areia-3 text-mata',
  ]}
>
  <div class="container-editorial flex items-center justify-between gap-6">
    <a href={href(locale, 'home')} class="shrink-0" aria-label={t('site.name')}>
      <Logo tone={sobreFoto ? 'claro' : 'escuro'} />
    </a>

    <!-- Menu em telas grandes -->
    <nav class="hidden lg:block" aria-label={t('nav.menu')}>
      <ul class="flex items-center gap-8">
        {NAV_KEYS.map((k) => (
          <li>
            <a
              href={href(locale, k)}
              aria-current={k === pageKey ? 'page' : undefined}
              class:list={[
                'olho transition-opacity hover:opacity-100',
                k === pageKey ? 'opacity-100' : 'opacity-70',
              ]}
            >
              {t(`nav.${k}`)}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <!-- Seletor de idioma: <details> nativo, funciona sem JS e no teclado -->
      <details class="relative group" data-idiomas>
        <summary
          class="olho flex cursor-pointer list-none items-center gap-1.5 px-2 py-2 opacity-80 hover:opacity-100 [&::-webkit-details-marker]:hidden"
          aria-label={t('nav.language')}
        >
          {locale.toUpperCase()}
          <svg viewBox="0 0 10 6" class="h-1.5 w-2.5 transition-transform group-open:rotate-180" aria-hidden="true">
            <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.4" fill="none" stroke-linecap="round" />
          </svg>
        </summary>
        <ul class="absolute right-0 top-full mt-2 min-w-44 border border-areia-3 bg-areia py-1 text-mata shadow-lg">
          {LOCALES.map((l) => (
            <li>
              <a
                href={href(l, pageKey)}
                hreflang={HTML_LANG[l]}
                lang={HTML_LANG[l]}
                aria-current={l === locale ? 'true' : undefined}
                class:list={[
                  'flex items-center justify-between gap-4 px-4 py-2.5 text-sm hover:bg-areia-2',
                  l === locale ? 'text-rede font-medium' : '',
                ]}
              >
                {LOCALE_NAMES[l]}
                <span class="olho opacity-40">{l}</span>
              </a>
            </li>
          ))}
        </ul>
      </details>

      <a href={href(locale, 'book')} class="btn btn-primario hidden py-3 sm:inline-flex">
        {t('cta.book')}
      </a>

      <!-- Botão do menu no celular -->
      <button
        type="button"
        data-abre-menu
        aria-expanded="false"
        aria-controls="menu-movel"
        class="olho -mr-2 flex items-center gap-2 p-2 lg:hidden"
      >
        <span class="sr-only sm:not-sr-only">{t('nav.menu')}</span>
        <span class="flex h-3 w-5 flex-col justify-between" aria-hidden="true">
          <span class="block h-px w-full bg-current"></span>
          <span class="block h-px w-full bg-current"></span>
          <span class="block h-px w-full bg-current"></span>
        </span>
      </button>
    </div>
  </div>
</header>

<!-- Menu do celular: painel inteiro, sem gaveta lateral apertada -->
<div
  id="menu-movel"
  hidden
  class="fixed inset-0 z-[60] flex flex-col bg-mata text-areia lg:hidden"
>
  <div class="container-editorial flex items-center justify-between py-4">
    <Logo tone="claro" />
    <button type="button" data-fecha-menu class="olho p-2">
      {t('nav.close')}
      <span aria-hidden="true" class="ml-2 text-base leading-none">&times;</span>
    </button>
  </div>

  <nav class="container-editorial flex-1 overflow-y-auto py-6" aria-label={t('nav.menu')}>
    <ul class="divide-y divide-areia/15">
      {NAV_KEYS.map((k) => (
        <li>
          <a href={href(locale, k)} class="font-display block py-4 text-3xl text-areia">
            {t(`nav.${k}`)}
          </a>
        </li>
      ))}
    </ul>

    <a href={href(locale, 'book')} class="btn btn-primario mt-8 w-full">{t('cta.book')}</a>

    <div class="mt-10 border-t border-areia/15 pt-6">
      <p class="olho mb-3 text-areia/50">{t('nav.language')}</p>
      <ul class="flex flex-wrap gap-x-5 gap-y-2">
        {LOCALES.map((l) => (
          <li>
            <a
              href={href(l, pageKey)}
              hreflang={HTML_LANG[l]}
              lang={HTML_LANG[l]}
              class:list={['text-sm', l === locale ? 'text-areia' : 'text-areia/55']}
            >
              {LOCALE_NAMES[l]}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </nav>
</div>

<script>
  const cabecalho = document.getElementById('cabecalho')!;
  const menu = document.getElementById('menu-movel')!;
  const abre = document.querySelector<HTMLButtonElement>('[data-abre-menu]')!;
  const fecha = document.querySelector<HTMLButtonElement>('[data-fecha-menu]')!;
  const idiomas = document.querySelector<HTMLDetailsElement>('[data-idiomas]');

  // Sobre foto, o cabeçalho só ganha fundo depois que a imagem sai da tela.
  if (cabecalho.hasAttribute('data-sobre-foto')) {
    const solido = ['bg-areia', 'border-areia-3', 'text-mata', 'py-3'];
    const transparente = ['bg-transparent', 'border-transparent', 'text-areia', 'py-4'];
    const aoRolar = () => {
      const rolou = window.scrollY > window.innerHeight * 0.75;
      cabecalho.classList.toggle('backdrop-blur-sm', rolou);
      solido.forEach((c) => cabecalho.classList.toggle(c, rolou));
      transparente.forEach((c) => cabecalho.classList.toggle(c, !rolou));
    };
    aoRolar();
    window.addEventListener('scroll', aoRolar, { passive: true });
  }

  const abrirMenu = (aberto: boolean) => {
    menu.hidden = !aberto;
    abre.setAttribute('aria-expanded', String(aberto));
    document.body.style.overflow = aberto ? 'hidden' : '';
    if (aberto) menu.querySelector<HTMLAnchorElement>('a')?.focus();
    else abre.focus();
  };

  abre.addEventListener('click', () => abrirMenu(true));
  fecha.addEventListener('click', () => abrirMenu(false));

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (!menu.hidden) abrirMenu(false);
    if (idiomas?.open) idiomas.open = false;
  });

  // Fecha o seletor de idioma ao clicar fora
  document.addEventListener('click', (e) => {
    if (idiomas?.open && !idiomas.contains(e.target as Node)) idiomas.open = false;
  });
</script>
