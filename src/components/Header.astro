---
import Logo from '@/components/Logo.astro';
import { LOCALES, LOCALE_NAMES, HTML_LANG, type Locale } from '@/i18n/config';
import { NAV_KEYS, href, type PageKey } from '@/i18n/routes';
import { useTranslations } from '@/i18n/utils';

interface Props {
  locale: Locale;
  pageKey: PageKey;
  /** Sobre foto de tela cheia o cabeçalho começa transparente. */
  sobreFoto?: boolean;
}

const { locale, pageKey, sobreFoto = false } = Astro.props;
const t = useTranslations(locale);
---

<header
  id="cabecalho"
  data-sobre-foto={sobreFoto ? '' : null}
  class:list={[
    'fixed inset-x-0 top-0 z-50 transition-[background-color,border-color] duration-300',
    'border-b py-4',
    sobreFoto
      ? 'bg-transparent border-transparent text-areia sobre-escuro'
      : 'bg-areia-clara emenda',
  ]}
>
  {/* Véu no topo: o menu precisa continuar legível sobre folhagem clara. */}
  {sobreFoto && (
    <div
      class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-32 bg-gradient-to-b from-mar-fundo/88 to-transparent"
      aria-hidden="true"
    ></div>
  )}

  <div class="container-editorial flex items-center justify-between gap-6">
    <a href={href(locale, 'home')} class="shrink-0" aria-label={t('site.name')}>
      <Logo />
    </a>

    <!-- Menu em telas grandes -->
    <nav class="hidden lg:block" aria-label={t('nav.menu')}>
      <ul class="flex items-center gap-5 xl:gap-8">
        {NAV_KEYS.map((k) => (
          <li>
            <a
              href={href(locale, k)}
              aria-current={k === pageKey ? 'page' : undefined}
              class:list={[
                'etiqueta inline-flex min-h-6 items-center transition-opacity',
                // Hover e estado ativo eram a MESMA propriedade (opacity), então
                // durante o movimento do mouse a página atual desaparecia.
                // O sublinhado é o que marca a página; a opacidade só é hover.
                k === pageKey
                  ? 'opacity-100 underline decoration-1 underline-offset-[0.5rem]'
                  : 'opacity-70 hover:opacity-100',
              ]}
            >
              {t(`nav.${k}`)}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <!-- Seletor de idioma: <details> nativo, funciona sem JS e no teclado -->
      <details class="relative group" data-idiomas>
        <summary
          class="etiqueta flex min-h-11 cursor-pointer list-none items-center gap-1.5 px-2 opacity-80 hover:opacity-100 [&::-webkit-details-marker]:hidden"
        >
          {/* O aria-label ficava por cima do texto visível "PT" e violava a
              SC 2.5.3 (Label in Name). Agora o nome acessível CONTÉM o visível. */}
          <span class="sr-only">{t('nav.language')}: </span>
          {locale.toUpperCase()}
          <svg viewBox="0 0 10 6" class="h-1.5 w-2.5 transition-transform group-open:rotate-180" aria-hidden="true">
            <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.4" fill="none" stroke-linecap="round" />
          </svg>
        </summary>
        <ul class="emenda absolute right-0 top-full mt-2 min-w-44 border bg-areia-clara py-1 shadow-lg">
          {LOCALES.map((l) => (
            <li>
              <a
                href={href(l, pageKey)}
                hreflang={HTML_LANG[l]}
                lang={HTML_LANG[l]}
                aria-current={l === locale ? 'true' : undefined}
                class:list={[
                  'flex items-center justify-between gap-4 px-4 py-3 text-sm hover:bg-areia',
                  l === locale ? 'text-ceu font-medium' : '',
                ]}
              >
                {LOCALE_NAMES[l]}
                {/* Era opacity-40 = 2,1:1. */}
                <span class="etiqueta">{l}</span>
              </a>
            </li>
          ))}
        </ul>
      </details>

      <a href={href(locale, 'book')} class="btn btn-primario hidden py-3 sm:inline-flex">
        {t('cta.book')}
      </a>

      <!-- Menu do celular.
           É um <details> nativo de propósito: antes o painel ficava atrás do
           atributo `hidden`, removido só por script — então abaixo de 1024px
           com JS desligado o site não tinha navegação NENHUMA. Agora abre sem
           JS e no teclado; o script só acrescenta Esc, trava de foco e scroll. -->
      <details class="group lg:hidden" data-menu>
        <summary
          class="etiqueta -mr-2 flex min-h-11 cursor-pointer list-none items-center gap-2 px-2 group-open:fixed group-open:top-4 group-open:right-5 group-open:z-[70] group-open:text-espuma [&::-webkit-details-marker]:hidden"
        >
          <span class="group-open:hidden">{t('nav.menu')}</span>
          <span class="hidden group-open:inline">{t('nav.close')}</span>
          <span class="flex h-3 w-5 flex-col justify-between group-open:hidden" aria-hidden="true">
            <span class="block h-px w-full bg-current"></span>
            <span class="block h-px w-full bg-current"></span>
            <span class="block h-px w-full bg-current"></span>
          </span>
          <span class="hidden text-base leading-none group-open:inline" aria-hidden="true">&times;</span>
        </summary>

        <div class="fixed inset-0 z-[60] flex flex-col overflow-y-auto bg-mar-fundo sobre-escuro">
          <div class="container-editorial flex items-center py-4">
            <Logo />
          </div>

          <nav class="container-editorial flex-1 py-6" aria-label={t('nav.menu')}>
            <ul class="divide-y divide-espuma/15">
              {NAV_KEYS.map((k) => (
                <li>
                  <a
                    href={href(locale, k)}
                    aria-current={k === pageKey ? 'page' : undefined}
                    class:list={[
                      'font-display block py-4 text-3xl',
                      k === pageKey ? 'text-espuma underline decoration-1 underline-offset-[0.4rem]' : '',
                    ]}
                  >
                    {t(`nav.${k}`)}
                  </a>
                </li>
              ))}
            </ul>

            <a href={href(locale, 'book')} class="btn btn-primario mt-8 w-full">{t('cta.book')}</a>

            <div class="mt-10 border-t border-espuma/15 pt-6">
              <p class="etiqueta mb-3">{t('nav.language')}</p>
              <ul class="flex flex-wrap gap-x-5 gap-y-1">
                {LOCALES.map((l) => (
                  <li>
                    <a
                      href={href(l, pageKey)}
                      hreflang={HTML_LANG[l]}
                      lang={HTML_LANG[l]}
                      aria-current={l === locale ? 'true' : undefined}
                      class:list={[
                        'inline-block py-1.5 text-sm',
                        l === locale ? 'text-espuma font-medium' : '',
                      ]}
                    >
                      {LOCALE_NAMES[l]}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </nav>
        </div>
      </details>
    </div>
  </div>
</header>

<style>
  /* Fase 5: os dois painéis <details> nasciam cravados no lugar — a seta já
     girava, o conteúdo não. `::details-content` é o pseudo-elemento que
     anima abrir/fechar de um <details> nativo sem JavaScript algum; onde o
     navegador não suporta, o comportamento é o mesmo instantâneo de hoje —
     nenhuma regressão possível. */
  details[data-idiomas]::details-content {
    transform-origin: top right;
    opacity: 1;
    scale: 1;
    transition: opacity 180ms cubic-bezier(0.23, 1, 0.32, 1),
                scale 180ms cubic-bezier(0.23, 1, 0.32, 1),
                content-visibility 180ms allow-discrete;
  }
  details[data-idiomas]:not([open])::details-content {
    opacity: 0;
    scale: 0.95;
  }

  details[data-menu]::details-content {
    opacity: 1;
    transition: opacity 250ms cubic-bezier(0.23, 1, 0.32, 1),
                content-visibility 250ms allow-discrete;
  }
  details[data-menu]:not([open])::details-content {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    details[data-idiomas]::details-content { transition-property: opacity, content-visibility; }
    details[data-idiomas]:not([open])::details-content { scale: 1; }
  }
</style>

<script>
  const cabecalho = document.getElementById('cabecalho')!;
  const menu = document.querySelector<HTMLDetailsElement>('[data-menu]');
  const idiomas = document.querySelector<HTMLDetailsElement>('[data-idiomas]');

  // Sobre foto, o cabeçalho só ganha fundo depois que a imagem sai da tela.
  if (cabecalho.hasAttribute('data-sobre-foto')) {
    const solido = ['bg-areia-clara', 'emenda'];
    const transparente = ['bg-transparent', 'border-transparent', 'text-areia', 'sobre-escuro'];
    const aoRolar = () => {
      const rolou = window.scrollY > window.innerHeight * 0.75;
      // Sem backdrop-filter aqui: ele cria bloco de contenção e o painel
      // `fixed inset-0` do menu, que é descendente do header, colapsaria
      // para o tamanho da barra. E sobre bg-mar opaco o blur não faz nada.
      solido.forEach((c) => cabecalho.classList.toggle(c, rolou));
      transparente.forEach((c) => cabecalho.classList.toggle(c, !rolou));
    };
    aoRolar();
    window.addEventListener('scroll', aoRolar, { passive: true });
  }

  if (menu) {
    let scrollSalvo = 0;

    menu.addEventListener('toggle', () => {
      if (menu.open) {
        scrollSalvo = window.scrollY;
        document.body.style.overflow = 'hidden';
      } else {
        document.body.style.overflow = '';
        // Antes o overflow era mutado sem restaurar: no iOS a posição sumia.
        if (window.scrollY !== scrollSalvo) window.scrollTo(0, scrollSalvo);
      }
    });

    // Trava de foco: sem isso o Tab saía do painel para dentro da página
    // invisível atrás dele.
    menu.addEventListener('keydown', (e) => {
      if (e.key !== 'Tab' || !menu.open) return;
      const focaveis = menu.querySelectorAll<HTMLElement>('summary, a[href], button:not([disabled])');
      if (!focaveis.length) return;
      const primeiro = focaveis[0];
      const ultimo = focaveis[focaveis.length - 1];
      if (e.shiftKey && document.activeElement === primeiro) {
        e.preventDefault();
        ultimo.focus();
      } else if (!e.shiftKey && document.activeElement === ultimo) {
        e.preventDefault();
        primeiro.focus();
      }
    });
  }

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (menu?.open) {
      menu.open = false;
      menu.querySelector('summary')?.focus();
    }
    if (idiomas?.open) idiomas.open = false;
  });

  // Fecha o seletor de idioma ao clicar fora
  document.addEventListener('click', (e) => {
    if (idiomas?.open && !idiomas.contains(e.target as Node)) idiomas.open = false;
  });
</script>
