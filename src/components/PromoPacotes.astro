---
/**
 * PROMO DOS PACOTES DE VIRADA (01/11/2026, pedido do Leonardo).
 * Quem entra no site tem de ver Réveillon e Detox logo de cara, com chamada
 * para fechar. Só PT: as páginas /pt/lp/ (landing + pagamento) só existem em PT.
 * Some sozinho: Réveillon até 3/1/2027, Detox até 11/1/2027 (data do build).
 * Fotos reais do acervo. Sem preço, sem escassez, sem promessa de saúde.
 * GA4: o clique leva data-promo; o listener em BaseLayout manda
 * select_promotion (ver o pacote) ou begin_checkout (Garanta a sua).
 */
import { Image } from 'astro:assets';
import piracaia from '@/assets/imgs/piracaia-roda.jpg';
import banho from '@/assets/imgs/banho-rio-grupo.jpg';
import { whatsappUrl } from '@/data/site';

interface Props { variante?: 'cards' | 'faixa'; origem: string }
const { variante = 'cards', origem } = Astro.props;
const agora = new Date();
const pacotes = [
  {
    id: 'reveillon',
    ativo: agora < new Date('2027-01-03T00:00:00-03:00'),
    foto: piracaia,
    alt: 'Roda de conversa na areia branca da Villa Arapiuns',
    rotulo: 'Réveillon 2026/27',
    gancho: 'Imagina acordar no dia 1 com o rio na porta do bangalô.',
    texto: 'A virada na areia branca, com o rio em frente.',
    pagar: '/pt/lp/pagar-reveillon/',
    ver: '/pt/lp/reveillon/',
    wa: 'Olá! Vim pelo site e quero fechar o pacote de Réveillon na Villa Arapiuns.',
  },
  {
    id: 'detox',
    ativo: agora < new Date('2027-01-11T00:00:00-03:00'),
    foto: banho,
    alt: 'Banho de rio em água cristalina no Rio Arapiuns',
    rotulo: 'Ano Novo Detox · 1 a 10/01',
    gancho: 'Depois da festa da virada, o corpo pede pausa.',
    texto: 'Dias de rio, floresta e silêncio para começar o ano devagar.',
    pagar: '/pt/lp/pagar-detox/',
    ver: '/pt/lp/detox-pos-reveillon/',
    wa: 'Olá! Vim pelo site e quero fechar o pacote Ano Novo Detox na Villa Arapiuns.',
  },
].filter((p) => p.ativo);
---
{pacotes.length > 0 && variante === 'cards' && (
  <section class="secao promo-pacotes" aria-labelledby={`promo-${origem}`}>
    <div class="container-editorial">
      <p class="etiqueta">Virada no Rio Arapiuns</p>
      <h2 id={`promo-${origem}`} class="font-display text-titulo mt-2">Comece 2027 com o rio na porta</h2>
      <p class="text-intro mt-3 container-texto sm:mx-0">1h30 de Alter do Chão, bem em frente à Ponta Grande. Água cristalina e areia branca.</p>
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        {pacotes.map((p) => (
          <article class="promo-card">
            <a href={p.ver} data-promo={p.id} data-promo-acao="ver" data-promo-origem={origem} tabindex="-1" aria-hidden="true">
              <Image src={p.foto} alt={p.alt} widths={[480, 800]} sizes="(min-width: 768px) 45vw, 92vw" class="aspect-[16/9] w-full object-cover" />
            </a>
            <div class="p-5 sm:p-6">
              <p class="etiqueta">{p.rotulo}</p>
              <h3 class="font-display text-2xl mt-2 leading-tight">{p.gancho}</h3>
              <p class="mt-2">{p.texto}</p>
              <div class="mt-5 flex flex-col gap-3 sm:flex-row sm:items-center sm:flex-wrap">
                <a href={p.pagar} class="btn btn-primario" data-promo={p.id} data-promo-acao="pagar" data-promo-origem={origem}>Garanta a sua</a>
                <a href={p.ver} class="underline underline-offset-4" data-promo={p.id} data-promo-acao="ver" data-promo-origem={origem}>Ver o pacote</a>
                <a href={whatsappUrl(p.wa)} class="underline underline-offset-4" target="_blank" rel="noopener noreferrer">Falar no WhatsApp</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
)}
{pacotes.length > 0 && variante === 'faixa' && (
  <aside class="promo-faixa container-editorial my-10" aria-label="Pacotes de virada">
    <p class="font-display text-xl leading-snug">Imagina acordar no dia 1 com o rio na porta do bangalô.</p>
    <p class="mt-1">Réveillon e Ano Novo Detox no Rio Arapiuns. Vagas limitadas.</p>
    <div class="mt-4 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
      {pacotes.map((p) => (
        <a href={p.pagar} class="btn btn-primario" data-promo={p.id} data-promo-acao="pagar" data-promo-origem={origem}>
          {p.id === 'reveillon' ? 'Garanta seu Réveillon' : 'Garanta seu Detox'}
        </a>
      ))}
      {pacotes.map((p) => (
        <a href={p.ver} class="self-center underline underline-offset-4" data-promo={p.id} data-promo-acao="ver" data-promo-origem={origem}>
          {p.id === 'reveillon' ? 'Ver o Réveillon' : 'Ver o Detox'}
        </a>
      ))}
    </div>
  </aside>
)}
<style>
  .promo-card { background: var(--color-areia-clara, #fff); border: 1px solid color-mix(in srgb, currentColor 18%, transparent); overflow: hidden; }
  .promo-faixa { border-left: 4px solid var(--color-ceu); padding: 1.25rem 1.5rem; background: color-mix(in srgb, var(--color-ceu) 7%, transparent); }
</style>
