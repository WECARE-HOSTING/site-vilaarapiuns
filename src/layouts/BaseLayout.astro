---
import '@/styles/global.css';
import { HTML_LANG, LOCALES, type Locale } from '@/i18n/config';
import { href, type PageKey } from '@/i18n/routes';
import { useTranslations } from '@/i18n/utils';
import { SITE } from '@/data/site';
import VideoLightbox from '@/components/VideoLightbox.astro';

interface Props {
  locale: Locale;
  pageKey: PageKey;
  title: string;
  description: string;
  /** Caminho absoluto de uma imagem própria da página; cai no og.jpg do site. */
  image?: string;
  /**
   * Falso põe a página fora do índice E tira os hreflang: alternates de
   * idioma numa página que não deve ser indexada não servem para nada.
   */
  indexavel?: boolean;
  /**
   * O DIÁRIO NÃO TEM PageKey, e é por isso que estas duas props existem.
   *
   * As 11 páginas do site vivem no mapa de `routes.ts`, e daí saem canônica e
   * hreflang de graça. Um post não: o caminho dele vem do arquivo de conteúdo,
   * e ele existe só nos idiomas em que foi escrito — hoje pt e en. Forçá-lo no
   * molde de PageKey significaria inventar slug em espanhol, alemão e japonês
   * para conteúdo que não existe nesses idiomas, e anunciar por hreflang
   * páginas que devolvem 404. Então quem chama passa o caminho e a lista de
   * alternativas REAIS, e o `pageKey` continua servindo só para title e
   * description caírem no lugar certo.
   */
  caminho?: string;
  /** Alternativas de idioma reais, quando não são as cinco do mapa. */
  alternativas?: { locale: Locale; caminho: string }[];
  /**
   * Tira o LodgingBusiness desta página. Um post do diário não é a pousada —
   * é um texto SOBRE ela. Marcar os dois com o mesmo tipo confunde a entidade
   * em vez de reforçá-la: o post emite o seu próprio Article pelo slot de head.
   */
  semSchemaNegocio?: boolean;
}

const { locale, pageKey, title, description, image, indexavel = true, caminho, alternativas, semSchemaNegocio = false } = Astro.props;
const t = useTranslations(locale);

const canonical = new URL(caminho ?? href(locale, pageKey), SITE.domain).toString();

// hreflang recíproco: cada idioma aponta para o MESMO conteúdo no slug dele.
const alternates = !indexavel
  ? []
  : alternativas
    ? alternativas.map((a) => ({ lang: HTML_LANG[a.locale], url: new URL(a.caminho, SITE.domain).toString() }))
    : LOCALES.map((l) => ({ lang: HTML_LANG[l], url: new URL(href(l, pageKey), SITE.domain).toString() }));

/**
 * O x-default aponta para o inglês quando ele existe, e para o que existe
 * quando não. Apontar para uma URL que não foi gerada é pior que não apontar.
 */
const xDefault = alternativas
  ? (alternativas.find((a) => a.locale === 'en') ?? alternativas[0])?.caminho
  : href('en', pageKey);

/**
 * O preview de link é o momento de aquisição real deste negócio: o WhatsApp é
 * o canal de reserva, e antes cada link colado num grupo chegava como um
 * retângulo cinza sem foto, porque o twitter:card pedia imagem grande e não
 * existia og:image nenhum. A imagem padrão é o quarto — a casa e o material,
 * que é o posicionamento — e não a trilha, que promete passeio.
 */
const ogImage = new URL(image ?? '/og.jpg', SITE.domain).toString();

/**
 * JSON-LD emitido só com fato confirmado. Campos ausentes ficam ausentes:
 *  · aggregateRating fora enquanto reviews.rating for null;
 *  · priceRange fora enquanto prices for null;
 *  · geo e hasMap fora de propósito — a coordenada que circula no repositório
 *    não foi confirmada, e publicar coordenada errada de um lugar remoto é pior
 *    que não publicar nenhuma. Entram quando o cliente confirmar a coordenada;
 *    até lá, ausência é a resposta certa e não uma pendência técnica.
 *  · petsAllowed SAIU em 2026-08-26: estava afirmado `false` em todas as páginas
 *    e não consta do PRODUCT.md nem de `site.ts`. Era a única linha deste bloco
 *    sem fonte. Volta como `SITE.petsAllowed` quando o cliente responder — não
 *    como literal aqui.
 *
 * A ENTIDADE É UMA, E É ISSO QUE O `@id` RESOLVE (2026-08-26). Antes, cada uma
 * das 66 páginas emitia um LodgingBusiness sem `@id` e com `url` apontando para
 * si mesma — 66 declarações que um consumidor não tem como reconhecer como a
 * MESMA pousada. Agora o `@id` é fixo e global (não muda por página nem por
 * idioma) e é ele que carrega a identidade; o `url` aponta para a home do
 * idioma, que é a página do negócio naquele idioma; e o endereço da página
 * corrente continua sendo dito pelo canonical, que é o lugar dele.
 */
const idEntidade = `${SITE.domain}/#pousada`;

/**
 * As duas modalidades são produtos diferentes com inclusões diferentes, e
 * confundi-las produz alegação falsa — foi o defeito que o site já cometeu.
 * O schema tinha um `priceRange` único, que não distingue nada: um modelo lendo
 * a página não tinha como saber que o barco não está incluso na Pousada.
 *
 * Nome, descrição e condição saem do dicionário, então isto existe nos cinco
 * idiomas sem chave nova. O preço nunca é convertido — a cobrança é em BRL em
 * qualquer idioma, como registra `preco()` em `site.ts`.
 */
const ofertas = [
  { nome: t('modo.pousadaT'), desc: t('modo.pousadaD'), valor: SITE.prices.pousadaMin, unidade: t('modo.porPax'),     cond: t('modo.condPousada') },
  /**
   * Os dois pacotes são NOMEADOS, e é assim que o cliente os chama: Clássico
   * Arapiuns e Imersão Completa. Usar `modo.pacoteT` nos dois emitiria duas
   * Offers idênticas separadas só pelo preço, o que não diz nada a quem lê.
   */
  { nome: t('pacote.p1T'),    desc: t('pacote.p1D'),    valor: SITE.prices.pacoteMin,  unidade: t('modo.porPacote'),  cond: t('modo.condPacote') },
  { nome: t('pacote.p2T'),    desc: t('pacote.p2D'),    valor: SITE.prices.pacote2Min, unidade: t('modo.porPacote2'), cond: t('modo.condPacote2') },
].filter((o) => o.valor);

const dados: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'LodgingBusiness',
  '@id': idEntidade,
  name: SITE.name,
  url: new URL(href(locale, 'home'), SITE.domain).toString(),
  description,
  image: ogImage,
  inLanguage: HTML_LANG[locale],
  address: {
    '@type': 'PostalAddress',
    addressLocality: SITE.location.city,
    addressRegion: SITE.location.state,
    addressCountry: SITE.location.country,
  },
  numberOfRooms: SITE.capacity.cabins,
  telephone: `+${SITE.contact.whatsapp}`,
  makesOffer: ofertas.map((o) => ({
    '@type': 'Offer',
    name: o.nome,
    description: o.desc,
    priceSpecification: {
      '@type': 'UnitPriceSpecification',
      price: o.valor,
      priceCurrency: SITE.prices.currency,
      unitText: o.unidade,
      description: o.cond,
    },
  })),
};
if (SITE.reviews.rating && SITE.reviews.count) {
  dados.aggregateRating = {
    '@type': 'AggregateRating',
    ratingValue: SITE.reviews.rating,
    reviewCount: SITE.reviews.count,
  };
}
if (SITE.prices.pousadaMin) {
  dados.priceRange = `${SITE.prices.currency} ${SITE.prices.pousadaMin}+`;
}
if (SITE.contact.instagram) {
  dados.sameAs = [`https://instagram.com/${SITE.contact.instagram.replace('@', '')}`];
}
---

<!doctype html>
<html lang={HTML_LANG[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {!indexavel && <meta name="robots" content="noindex, follow" />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#fdf8ee" />

    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.url} />)}
    {indexavel && xDefault && <link rel="alternate" hreflang="x-default" href={new URL(xDefault, SITE.domain).toString()} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={HTML_LANG[locale].replace('-', '_')} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t('seo.ogImageAlt')} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,300..700&family=Archivo+Narrow:wght@400..700&display=swap"
    />

    {!semSchemaNegocio && <script type="application/ld+json" set:html={JSON.stringify(dados)} is:inline />}

    <slot name="head" />
  </head>

  <body>
    <a
      href="#conteudo"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[200] focus:bg-mar focus:text-areia focus:px-5 focus:py-3"
    >
      {t('a11y.skipToContent')}
    </a>

    <slot name="header" />

    <main id="conteudo">
      <slot />
    </main>

    <slot name="footer" />

    <VideoLightbox locale={locale} />
  </body>
</html>
